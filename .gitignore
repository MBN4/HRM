# Docker volumes (local dev data, not code)
.docker-data/

# Phase 5.4 — generated by `pnpm --filter @hrm/api run seed:load-test`
# (apps/api/scripts/seed-load-test-data.ts): real tenant/branch UUIDs from
# THIS machine's own local database, never portable across environments
# and regenerated fresh on every seed run — a local artifact, not a
# checked-in fixture. `load/scenarios/`/`load/README.md` are still
# tracked normally.
load/fixtures/*.json

# Licensing: the RS256 PRIVATE signing key must NEVER be committed or ship in
# an on-prem build — only the public verification key does. See /CLAUDE.md
# § Conventions → Licensing / feature flags for the full key-handling rule.
# `*-private*.pem` (not a bare `*.pem`) so the public key committed alongside
# it in apps/api/keys/ is unaffected.
apps/api/keys/*private*.pem
