// Multi-tenancy data model — the isolation backbone for the whole system.
//
// Every table except `Tenant` is tenant-scoped: it carries a `tenantId`
// column, a composite index leading with `tenantId`, and (for self-relations)
// a composite foreign key back to `Tenant` so a row can never reference a
// parent belonging to a different tenant even before Row-Level Security is
// considered. RLS itself is NOT expressed here — Prisma has no RLS DSL — it
// is enabled by hand-written SQL in
// `prisma/migrations/<ts>_enable_row_level_security/migration.sql`.
//
// See /CLAUDE.md § Conventions → Tenancy model for the full write-up of how
// tenant context is propagated to Postgres at query time.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Future partitioned tables (not created in this step — tracked in
// /CLAUDE.md § Not yet built as 0.9 "audit_log" and a later HR phase for
// "attendance"):
//
//   - attendance  — one row per clock-in/out event; extremely high volume.
//   - audit_log   — one row per mutating action across the whole system.
//
// Both MUST be created as PARTITIONED tables from day one — retrofitting
// partitioning onto a live, non-partitioned table at scale is a painful
// migration, not a config change. Plan:
//   - PARTITION BY RANGE on a timestamp column (e.g. occurred_at/created_at),
//     optionally sub-partitioned BY LIST on tenant_id for very large tenants.
//   - Postgres requires the partition key to be part of every unique
//     constraint/PK on a partitioned table, so their primary keys must be
//     composite from the start, e.g. PRIMARY KEY (id, occurred_at) rather
//     than PRIMARY KEY (id) alone. Any FK that will point at them (and any
//     `id` values handed to clients) must be designed compatibly now so
//     adding the tables later isn't a breaking change to callers.
//   - Both need RLS enabled + FORCE ROW LEVEL SECURITY + the same
//     tenant_isolation policy pattern used below for every other
//     tenant-scoped table.
// ---------------------------------------------------------------------------

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum TenantEdition {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// The tenant registry itself. Deliberately NOT tenant-scoped (it has no
// tenantId — it IS the tenant) and therefore NOT subject to Row-Level
// Security: resolving "which tenant is this request for" has to happen
// before a tenant context exists to filter by. `TenantDomain` below is the
// only other table with this same exemption, for the same reason.
model Tenant {
  id                 String        @id @default(uuid()) @db.Uuid
  name               String
  slug               String        @unique
  status             TenantStatus  @default(TRIAL)
  edition            TenantEdition @default(STARTER)
  // ISO 3166-1 alpha-2. Branches resolve their own countryCode; this is only
  // the fallback used where a branch hasn't been assigned one.
  defaultCountryCode String        @map("default_country_code") @db.VarChar(2)
  hostingRegion      String        @map("hosting_region")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  branches                Branch[]
  departments             Department[]
  designations            Designation[]
  costCenters             CostCenter[]
  users                   User[]
  domains                 TenantDomain[]
  permissions             Permission[]
  roles                   Role[]
  rolePermissions         RolePermission[]
  userRoles               UserRole[]
  userBranches            UserBranch[]
  countryOverrides        TenantCountryOverride[]
  subscription            Subscription?
  licenses                License[]
  featureFlagOverrides    TenantFeatureFlagOverride[]
  workflowTemplates       WorkflowTemplate[]
  workflowSteps           WorkflowStep[]
  workflowInstances       WorkflowInstance[]
  workflowInstanceSteps   WorkflowInstanceStep[]
  workflowActions         WorkflowAction[]
  notifications           Notification[]
  notificationDeliveries  NotificationDelivery[]
  notificationPreferences NotificationPreference[]

  @@map("tenants")
}

// Custom-domain -> tenant mapping (e.g. "hr.acme-corp.example" -> the "acme"
// tenant), one of three tenant-resolution strategies used by
// apps/api's TenantResolutionService (see /CLAUDE.md § Conventions →
// Tenant resolution). Has a `tenantId` FK like any tenant-owned table, but
// — like `Tenant` itself — is deliberately EXEMPT from Row-Level Security:
// resolving a request's tenant from its Host header has to happen before a
// tenant context exists to filter by. Only `SELECT` is granted to `hrm_app`
// (see the `add_tenant_domains` migration); managing domain mappings is an
// admin/platform operation, not a tenant-scoped request, and has no write
// path yet (lands with the vendor admin console).
model TenantDomain {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  // Bare hostname, no scheme/port (e.g. "hr.acme-corp.example").
  domain    String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domains")
}

// A tenant may operate branches in different countries — country resolution
// happens at the BRANCH level, not the tenant level (see /CLAUDE.md 0.5).
model Branch {
  id             String  @id @default(uuid()) @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  name           String
  countryCode    String  @map("country_code") @db.VarChar(2)
  timezone       String
  parentBranchId String? @map("parent_branch_id") @db.Uuid
  // Seam for the workflow engine's BRANCH_HEAD approver rule (step 0.7) —
  // see /CLAUDE.md § Conventions → Workflow engine → Approver rules.
  headUserId     String? @map("head_user_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Composite FK back to the SAME tenant: a branch's parent must belong to
  // the same tenant, enforced at the schema level (not just by RLS).
  parentBranch  Branch?  @relation("BranchHierarchy", fields: [tenantId, parentBranchId], references: [tenantId, id], onDelete: SetNull)
  childBranches Branch[] @relation("BranchHierarchy")
  headUser      User?    @relation("BranchHead", fields: [tenantId, headUserId], references: [tenantId, id], onDelete: SetNull)

  departments  Department[]
  userBranches UserBranch[]

  // Lets other tenant-scoped tables define a composite FK of
  // (tenantId, branchId) -> (tenantId, id) against this table.
  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, countryCode])
  @@index([tenantId, parentBranchId])
  @@index([tenantId, headUserId])
  @@map("branches")
}

model Department {
  id                 String  @id @default(uuid()) @db.Uuid
  tenantId           String  @map("tenant_id") @db.Uuid
  branchId           String  @map("branch_id") @db.Uuid
  name               String
  parentDepartmentId String? @map("parent_department_id") @db.Uuid
  // Seam for the workflow engine's DEPARTMENT_HEAD approver rule (step
  // 0.7) — see /CLAUDE.md § Conventions → Workflow engine → Approver rules.
  headUserId         String? @map("head_user_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)

  parentDepartment Department?  @relation("DepartmentHierarchy", fields: [tenantId, parentDepartmentId], references: [tenantId, id], onDelete: SetNull)
  childDepartments Department[] @relation("DepartmentHierarchy")
  headUser         User?        @relation("DepartmentHead", fields: [tenantId, headUserId], references: [tenantId, id], onDelete: SetNull)

  @@unique([tenantId, id])
  @@unique([tenantId, branchId, name])
  @@index([tenantId, parentDepartmentId])
  @@index([tenantId, headUserId])
  @@map("departments")
}

model Designation {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("designations")
}

model CostCenter {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String
  code     String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@map("cost_centers")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  email             String
  hashedPassword    String     @map("hashed_password")
  status            UserStatus @default(PENDING)
  // Employee->manager relation SEAM for the workflow engine's MANAGER
  // approver rule (step 0.7) — modeled here, on User, because the real
  // Employee module doesn't exist yet (phase 1.1). Once it does, the
  // MANAGER resolver in apps/api/src/workflow should be repointed at
  // whatever the Employee model's manager relation turns out to be;
  // nothing about the workflow engine itself should need to change, only
  // this one resolution function. See /CLAUDE.md § Conventions → Workflow
  // engine → Approver rules.
  managerId         String?    @map("manager_id") @db.Uuid
  // Per-user notification-language override (BCP-47, e.g. "en", "ar") — seam
  // for the notification hub (step 0.8). Null = fall back to the recipient's
  // resolved branch's Country Pack `locale.defaultLanguage`. See
  // /CLAUDE.md § Conventions → Notifications → Recipient locale resolution.
  preferredLanguage String?    @map("preferred_language")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Composite self-relation, same pattern as Branch.parentBranchId /
  // Department.parentDepartmentId: a manager must belong to the same
  // tenant, enforced at the schema level in addition to RLS.
  manager       User?  @relation("UserManager", fields: [tenantId, managerId], references: [tenantId, id], onDelete: SetNull)
  directReports User[] @relation("UserManager")

  roles    UserRole[]
  branches UserBranch[]

  headOfBranches    Branch[]           @relation("BranchHead")
  headOfDepartments Department[]       @relation("DepartmentHead")
  workflowRequests  WorkflowInstance[] @relation("WorkflowRequester")

  // Per-tenant uniqueness, NOT global: the same email may exist under
  // different tenants as entirely unrelated accounts.
  @@unique([tenantId, email])
  // Lets UserRole/UserBranch/the manager self-relation define a composite
  // FK of (tenantId, userId) -> (tenantId, id) against this table, same
  // pattern as Branch/Role/Permission.
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, managerId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// RBAC (step 0.4). Both Permission and Role are tenant-scoped — deliberately:
// the permission catalog and role set are seeded defaults (see
// packages/shared's PERMISSIONS/SYSTEM_ROLE_PERMISSIONS constants and
// packages/db/src/seed-rbac.ts), but they are EDITABLE DATA per tenant, not
// hardcoded enums. A tenant can rename/add roles or (eventually) permissions
// without a code change or a migration. Enforcement always reads the current
// DB rows, never the seed constants, so edits take effect immediately.
// ---------------------------------------------------------------------------

// A granular capability string (e.g. "employee.read", "salary.view"),
// checked by PermissionsGuard / @RequirePermissions() and by the
// field-level @RequiresPermission() serialization pattern (see
// /CLAUDE.md § Conventions → Field-level permissions).
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  key         String
  description String?

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("permissions")
}

model Role {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  // Seeded system roles (TENANT_ADMIN/HR_MANAGER/MANAGER/EMPLOYEE) vs. a
  // tenant's own custom roles — informational only; nothing in this schema
  // prevents editing a system role's permission set, on purpose.
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("roles")
}

model RolePermission {
  tenantId     String @map("tenant_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  permission Permission @relation(fields: [tenantId, permissionId], references: [tenantId, id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([tenantId])
  @@map("role_permissions")
}

model UserRole {
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  role   Role   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([tenantId])
  @@map("user_roles")
}

// A user with zero rows here is UNRESTRICTED (sees every branch in their
// tenant, subject to tenant RLS as always). One or more rows means the user
// is limited to exactly those branches — enforced in
// apps/api/src/tenancy/tenant-scope.interceptor.ts by populating
// `branchIds` in the request context from this table every request; actual
// filtering happens in application queries (RLS has no per-branch concept,
// only per-tenant).
model UserBranch {
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([tenantId])
  @@map("user_branches")
}

// ---------------------------------------------------------------------------
// Country packs (step 0.5). See /CLAUDE.md § Conventions → Country packs for
// the full write-up of the schema shape, resolution order, and the two-layer
// override model.
// ---------------------------------------------------------------------------

// A versioned, system-owned bundle of legal/cultural defaults for one
// country (locale, working time, leave, public holidays, tax, statutory
// contributions, required employee fields, payslip template, payroll mode).
// Deliberately NOT tenant-scoped — there is no `tenantId` column, this is
// global reference data the vendor maintains, not per-tenant data — and
// therefore NOT subject to Row-Level Security, the same exemption reasoning
// as `Tenant`/`TenantDomain` (there is no tenant_id for a policy to filter
// on). `config` is validated against `@hrm/shared`'s `countryPackConfigSchema`
// before every write AND re-validated on every read (see
// CountryPackResolutionService) — a JSON column has no schema-level
// guarantee, so both directions are checked, consistent with this project's
// "no single layer is trusted alone" security posture.
//
// Writable only through the owner/admin role today (seeded — see
// `packages/db/src/seed-country-packs.ts`), the same as the RBAC permission
// catalog: a real admin-editable UI is a later phase, tracked as "not yet
// built" work, not implied by this model existing.
model CountryPack {
  id          String   @id @default(uuid()) @db.Uuid
  countryCode String   @map("country_code") @db.VarChar(2)
  version     Int      @default(1)
  // Whether resolution should consider this version current for the
  // country. Lets a new version be seeded and activated without deleting
  // the previous one (useful for legal-change audit history later).
  isActive    Boolean  @default(true) @map("is_active")
  config      Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([countryCode, version])
  @@index([countryCode, isActive])
  @@map("country_packs")
}

// A tenant's diff on top of one country's CountryPack — e.g. "25 days
// annual leave instead of the legal default of 20". Tenant-scoped: ordinary
// Row-Level Security applies, identical pattern to every other tenant-owned
// table in this schema. `overrides` is validated against
// `tenantCountryOverrideSchema` (a `.strict()` schema covering only the
// sections that are legally/culturally safe for a tenant to adjust —
// leaveDefaults, workingTime, requiredEmployeeFields, payslipTemplate; tax
// and statutory contributions are never tenant-overridable) and, where
// sensible, against bounds derived from the pack itself (e.g. a tenant may
// only grant MORE leave than the legal floor, never less) — see
// CountryPackResolutionService.
model TenantCountryOverride {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  countryCode String   @map("country_code") @db.VarChar(2)
  overrides   Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, countryCode])
  @@index([tenantId])
  @@map("tenant_country_overrides")
}

// ---------------------------------------------------------------------------
// Licensing / feature flags (step 0.6). See /CLAUDE.md § Conventions →
// Licensing / feature flags for the full write-up of the two delivery
// modes, the license file format, key handling, and seat-cap enforcement.
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

// SaaS-mode (LICENSE_MODE=saas) entitlement source — a stand-in for real
// billing (Stripe integration is Phase 4.2). `edition` here, NOT
// `Tenant.edition`, is what FeatureFlagResolutionService reads in SaaS
// mode: a subscription's plan is naturally what a real billing system
// attaches edition/seat data to, and keeping a single field as
// resolution's source of truth avoids two columns drifting out of sync.
// `Tenant.edition` (0.2) keeps its original display/legacy role. `seatCap`
// is nullable: SaaS-mode seat-cap enforcement is "flagged" (audited), not
// blocking (see Seat-cap enforcement in Conventions) — a null cap means
// the check is skipped entirely for that tenant.
model Subscription {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  edition          TenantEdition
  status           SubscriptionStatus @default(TRIAL)
  seatCap          Int?               @map("seat_cap")
  currentPeriodEnd DateTime?          @map("current_period_end")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // At most one subscription per tenant.
  @@unique([tenantId])
  @@map("subscriptions")
}

enum LicenseStatus {
  ACTIVE
  REVOKED
  EXPIRED
  SUPERSEDED
}

// Lifetime/on-prem-mode (LICENSE_MODE=lifetime) entitlement source: the
// DB-side record of a signed license FILE after activation. `signedToken`
// is kept (not just its decoded snapshot) so the signature can be
// RE-VERIFIED against the RS256 public key on every entitlement
// resolution, not just trusted from `enabledFlags`/`seatCap`/`expiresAt`
// once at activation time — this is what satisfies "verify on boot and
// periodically" without a separate scheduler (see Conventions). At most
// one row per tenant should be ACTIVE at a time; activating a new license
// moves the previous ACTIVE row to SUPERSEDED (enforced in application
// code, not a DB constraint — history is kept intentionally, for audit).
model License {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  edition      TenantEdition
  // Snapshot of the signed payload's enabled-flags list, for fast reads —
  // always re-validated against `signedToken`'s signature before being
  // trusted (see LicenseResolutionService).
  enabledFlags Json          @map("enabled_flags")
  seatCap      Int           @map("seat_cap")
  signedToken  String        @map("signed_token") @db.Text
  issuedAt     DateTime      @map("issued_at")
  expiresAt    DateTime?     @map("expires_at")
  status       LicenseStatus @default(ACTIVE)
  activatedAt  DateTime?     @map("activated_at")
  revokedAt    DateTime?     @map("revoked_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("licenses")
}

// A tenant-specific grant OR revocation of one feature flag, layered on
// top of whatever the edition/subscription (SaaS) or license (lifetime)
// would otherwise resolve to — the platform-admin lever for "give this
// tenant early access to X" or "turn off Y for this tenant specifically"
// without touching their edition/license. `enabled: true` grants the flag
// even if their edition/license wouldn't otherwise include it; `enabled:
// false` revokes it even if their edition/license would. Tenant-scoped:
// ordinary RLS applies, identical pattern to every other tenant-owned
// table — reads happen inside a normal tenant request's transaction,
// writes happen only through the platform-context admin endpoints (see
// Conventions), which use the owner/admin client directly since a
// platform request opens no tenant-scoped transaction (see Platform
// context in Conventions).
model TenantFeatureFlagOverride {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  flagKey   String   @map("flag_key")
  enabled   Boolean
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, flagKey])
  @@index([tenantId])
  @@map("tenant_feature_flag_overrides")
}

// ---------------------------------------------------------------------------
// Workflow / approval engine (step 0.7). ONE generic engine — leave,
// expenses, regularizations, offer approvals, and anything else that ever
// needs an approval chain all consume THIS model. See /CLAUDE.md §
// Conventions → Workflow engine for the full write-up: approver-rule
// resolution, conditional branching via the shared sandboxed expression
// evaluator, and THE RULE that no future module may build its own
// approval logic.
// ---------------------------------------------------------------------------

// A named, versioned, tenant-configurable approval process for one
// `entityType`. `entityType` is a free-form string, NOT a Postgres enum —
// enforcing a closed catalog here would mean a migration every time a new
// consuming module (leave, expenses, ...) is added, defeating the point of
// a generic engine. Versioned + `isActive` the same way `CountryPack` is
// (0.5): multiple versions may exist; resolution picks the active one with
// the highest version for a given `(tenantId, entityType)`.
model WorkflowTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  entityType  String   @map("entity_type")
  version     Int      @default(1)
  isActive    Boolean  @default(true) @map("is_active")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps     WorkflowStep[]
  instances WorkflowInstance[]

  @@unique([tenantId, id])
  @@unique([tenantId, entityType, version])
  @@index([tenantId, entityType, isActive])
  @@map("workflow_templates")
}

// One step in a template's approval chain. Steps sharing the same `order`
// within a template form a PARALLEL group — every one of them must reach
// APPROVED before the instance advances past that `order`; steps with
// different `order` values run SEQUENTIALLY. `approverRule` is a JSON
// `ApproverRule` (`@hrm/shared`) — SPECIFIC_USER/ROLE/MANAGER/BRANCH_HEAD/
// DEPARTMENT_HEAD, optionally wrapped in a CONDITIONAL that picks between
// two sub-rules — validated on every write AND read, same "JSON column
// has no schema-level guarantee of its own" posture as 0.5's CountryPack.
// `condition` (nullable) gates whether this step applies to a given
// instance AT ALL — this is the CONDITIONAL BRANCHING mechanism (e.g. "add
// a step only when amount > threshold"), evaluated against the instance's
// `dataSnapshot` via the workflow condition sandbox (see Conventions);
// null = always applies. `autoApproveCondition` (nullable) lets a step
// resolve to APPROVED with no human action when true (e.g. small
// low-risk amounts) — a DIFFERENT mechanism from `condition`: `condition`
// decides whether the step exists at all for this instance; here the step
// exists but needs nobody to click anything.
model WorkflowStep {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  templateId             String   @map("template_id") @db.Uuid
  name                   String
  order                  Int
  approverRule           Json     @map("approver_rule")
  condition              Json?    @map("condition")
  autoApproveCondition   Json?    @map("auto_approve_condition")
  // Minutes after activation before this step escalates. Null = never.
  escalationAfterMinutes Int?     @map("escalation_after_minutes")
  // ApproverRule (JSON) — who an overdue step escalates to. Required
  // whenever `escalationAfterMinutes` is set (validated at the app layer,
  // not the DB — same "shape validated outside the JSON column" posture
  // as everything else here).
  escalationRule         Json?    @map("escalation_rule")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template      WorkflowTemplate       @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Cascade)
  instanceSteps WorkflowInstanceStep[]

  @@unique([tenantId, id])
  @@index([tenantId, templateId, order])
  @@map("workflow_steps")
}

enum WorkflowInstanceStatus {
  PENDING
  IN_STEP
  APPROVED
  REJECTED
  CANCELED
  ESCALATED
}

// A running approval for ANY entity — POLYMORPHIC via `entityType` +
// `entityId` (the id of a row in whatever future module owns it — leave
// request, expense claim, ...; this table has no FK to it, deliberately,
// since that row's table doesn't exist yet for most consumers and never
// should be a hard dependency of the generic engine). `dataSnapshot` is
// the JSON the engine's condition/auto-approve/escalation expressions
// evaluate against (e.g. `{ amount, leaveType, days }`) — captured once at
// submission time, not re-read from the owning module later, so an
// approval chain already in flight is unaffected by the source record
// changing underneath it.
model WorkflowInstance {
  id           String                 @id @default(uuid()) @db.Uuid
  tenantId     String                 @map("tenant_id") @db.Uuid
  templateId   String                 @map("template_id") @db.Uuid
  entityType   String                 @map("entity_type")
  entityId     String                 @map("entity_id")
  requesterId  String                 @map("requester_id") @db.Uuid
  dataSnapshot Json                   @map("data_snapshot")
  status       WorkflowInstanceStatus @default(PENDING)
  // The `order` value currently active; null once the instance is terminal.
  currentOrder Int?                   @map("current_order")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  completedAt  DateTime?              @map("completed_at")

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template  WorkflowTemplate       @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Cascade)
  requester User                   @relation("WorkflowRequester", fields: [tenantId, requesterId], references: [tenantId, id], onDelete: Cascade)
  steps     WorkflowInstanceStep[]
  actions   WorkflowAction[]

  @@unique([tenantId, id])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, requesterId, status])
  @@map("workflow_instances")
}

enum WorkflowStepStatus {
  PENDING
  SKIPPED
  ACTIVE
  APPROVED
  REJECTED
  ESCALATED
}

// The per-instance materialization of one template step — which lets the
// same template be reused across many instances while each instance
// tracks its OWN resolved approvers and progress independently.
// `eligibleApproverIds` is a snapshot (JSON string[]) of who could act
// when this step activated, resolved by apps/api's approver-rule
// resolvers — captured at activation time so a later org-chart change
// (a new manager, a reassigned branch head) never rewrites history on an
// approval already in flight. `delegatedToUserId`/`escalatedToUserId` are
// plain UUID columns with no FK relation (an audit/tracking reference,
// the same class of "just a user id" field `auth-events.ts`'s
// `AuthEventPayload.userId` already is elsewhere in this codebase) —
// deliberately, to avoid yet another named back-relation on `User` for
// what is fundamentally a log fact, not a structural relationship.
model WorkflowInstanceStep {
  id                  String             @id @default(uuid()) @db.Uuid
  tenantId            String             @map("tenant_id") @db.Uuid
  instanceId          String             @map("instance_id") @db.Uuid
  templateStepId      String             @map("template_step_id") @db.Uuid
  name                String
  // Copied from the template step at activation time so ordering stays
  // stable even if the template is edited later.
  order               Int
  status              WorkflowStepStatus @default(PENDING)
  eligibleApproverIds Json               @map("eligible_approver_ids")
  delegatedToUserId   String?            @map("delegated_to_user_id") @db.Uuid
  escalatedToUserId   String?            @map("escalated_to_user_id") @db.Uuid
  activatedAt         DateTime?          @map("activated_at")
  // activatedAt + the template step's escalationAfterMinutes; null if
  // that step has no escalation rule.
  dueAt               DateTime?          @map("due_at")
  decidedAt           DateTime?          @map("decided_at")
  decidedByUserId     String?            @map("decided_by_user_id") @db.Uuid

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instance     WorkflowInstance @relation(fields: [tenantId, instanceId], references: [tenantId, id], onDelete: Cascade)
  templateStep WorkflowStep     @relation(fields: [tenantId, templateStepId], references: [tenantId, id], onDelete: Cascade)
  actions      WorkflowAction[]

  @@unique([tenantId, id])
  @@index([tenantId, instanceId, order])
  @@index([tenantId, status, dueAt])
  @@map("workflow_instance_steps")
}

enum WorkflowActionType {
  APPROVE
  REJECT
  DELEGATE
  COMMENT
  ESCALATE
  AUTO_APPROVE
  CANCEL
}

// The audit trail: one row per approve/reject/delegate/comment/escalate/
// auto-approve/cancel, who (if anyone — ESCALATE and AUTO_APPROVE are
// system-initiated, `actorUserId` is null for those) and when. Never
// updated or deleted once written. `actorUserId`/`delegatedToUserId` are
// plain UUID columns with no FK relation, same reasoning as
// `WorkflowInstanceStep`'s equivalents above.
model WorkflowAction {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  instanceId        String             @map("instance_id") @db.Uuid
  instanceStepId    String?            @map("instance_step_id") @db.Uuid
  actionType        WorkflowActionType @map("action_type")
  actorUserId       String?            @map("actor_user_id") @db.Uuid
  delegatedToUserId String?            @map("delegated_to_user_id") @db.Uuid
  comment           String?
  createdAt         DateTime           @default(now()) @map("created_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instance     WorkflowInstance      @relation(fields: [tenantId, instanceId], references: [tenantId, id], onDelete: Cascade)
  instanceStep WorkflowInstanceStep? @relation(fields: [tenantId, instanceStepId], references: [tenantId, id], onDelete: SetNull)

  @@index([tenantId, instanceId])
  @@map("workflow_actions")
}

// ---------------------------------------------------------------------------
// Notifications hub (step 0.8). See /CLAUDE.md § Conventions → Notifications
// for the full write-up: the async BullMQ delivery pipeline, the swappable
// per-channel provider seam, the event -> notification mapping layer, and
// recipient-locale-driven template rendering. This is the delivery layer the
// domain events already emitted by auth (0.4), licensing (0.6), and workflow
// (0.7) have been waiting for — those modules are untouched by this step
// (beyond auth's password-reset event gaining a `token` field), they already
// emit everything this hub needs.
// ---------------------------------------------------------------------------

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  DEAD_LETTER
}

// One row per notification GENERATED for one recipient from one domain
// event — channel-agnostic. `payload` is the triggering domain event's
// payload (see auth-events.ts/licensing-events.ts/workflow-events.ts),
// kept so a delivery can be re-rendered (retry, or a future "resend")
// without re-deriving it from the source event, which by then may no
// longer be in flight. `eventType` is a free-form string (e.g.
// "workflow.approved"), NOT a Postgres enum — same reasoning as
// `WorkflowInstance.entityType`: a closed catalog here would mean a
// migration every time a new consuming module's event gets mapped to a
// notification.
model Notification {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  recipientUserId String   @map("recipient_user_id") @db.Uuid
  eventType       String   @map("event_type")
  payload         Json
  createdAt       DateTime @default(now()) @map("created_at")

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([tenantId, id])
  @@index([tenantId, recipientUserId, createdAt])
  @@map("notifications")
}

// One row per CHANNEL a Notification is delivered through — the unit of
// work a BullMQ job processes (job data is just `{ tenantId,
// notificationDeliveryId }`; everything else is loaded fresh from this row
// inside the worker, so a retried job always sees current state). `status`
// starts PENDING at enqueue time; the worker moves it to SENT on success,
// or — on failure — FAILED (more retries remain, BullMQ will re-attempt
// per the job's `attempts`/`backoff` options) or DEAD_LETTER (this was the
// final attempt; `lastError` holds why). `readAt` is only ever set for
// `IN_APP` deliveries (mark-read) — left null and unused for every other
// channel, simpler than a separate one-row-per-channel-family schema for
// what's otherwise an identical shape. `renderedSubject`/`renderedBody`
// are the actual rendered-in-the-recipient's-locale strings, captured at
// send time so a user's in-app notification list reads correctly even if
// the underlying NotificationTemplate is edited/re-versioned later.
model NotificationDelivery {
  id              String                     @id @default(uuid()) @db.Uuid
  tenantId        String                     @map("tenant_id") @db.Uuid
  notificationId  String                     @map("notification_id") @db.Uuid
  channel         NotificationChannel
  status          NotificationDeliveryStatus @default(PENDING)
  attempts        Int                        @default(0)
  lastError       String?                    @map("last_error")
  renderedSubject String?                    @map("rendered_subject")
  renderedBody    String?                    @map("rendered_body")
  sentAt          DateTime?                  @map("sent_at")
  readAt          DateTime?                  @map("read_at")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [tenantId, notificationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, notificationId])
  @@index([tenantId, status])
  @@map("notification_deliveries")
}

// Per-user, per-event-type, per-channel opt-in/opt-out — tenant-scoped,
// ordinary RLS. Absence of a row for a given (userId, eventType, channel)
// means "use the default" (`@hrm/shared`'s `DEFAULT_NOTIFICATION_CHANNELS`
// for that event type) — a row only needs to exist when a user has
// explicitly diverged from the default in either direction (opted into a
// channel that isn't on by default, or opted out of one that is). See
// NotificationPreferenceService.resolveEnabledChannels.
model NotificationPreference {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  eventType String              @map("event_type")
  channel   NotificationChannel
  enabled   Boolean
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, eventType, channel])
  @@index([tenantId, userId])
  @@map("notification_preferences")
}

// A versioned, system-owned notification copy template for one
// `(eventType, channel, locale)` — the SAME "global reference data,
// seeded, versioned, `isActive`" shape as `CountryPack` (0.5), for the
// same reason: this is vendor-authored copy, not per-tenant data, and
// deliberately NOT tenant-scoped (no `tenantId` column) and therefore NOT
// subject to Row-Level Security, the same exemption reasoning as
// `Tenant`/`TenantDomain`/`CountryPack`. `subject` is only meaningful for
// channels that have one (EMAIL); null for IN_APP/SMS/PUSH. `body`
// contains `{{placeholder}}` tokens substituted from the triggering
// event's payload by NotificationTemplateRenderer — this is what
// satisfies "externalize all template strings": no notification copy is
// ever hardcoded into `apps/api` service code, it all lives here (seeded
// from `packages/db/src/seed-notification-templates.ts`, the same
// seeded-but-DB-stored pattern `seed-country-packs.ts` already
// established). Writable only through the owner/admin role today, same as
// `CountryPack` — a real admin-editable UI is later work.
model NotificationTemplate {
  id        String              @id @default(uuid()) @db.Uuid
  eventType String              @map("event_type")
  channel   NotificationChannel
  // BCP-47 language tag, e.g. "en", "ar" — matches CountryPack locale's
  // `defaultLanguage` / `User.preferredLanguage`.
  locale    String
  version   Int                 @default(1)
  isActive  Boolean             @default(true) @map("is_active")
  subject   String?
  body      String
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@unique([eventType, channel, locale, version])
  @@index([eventType, channel, locale, isActive])
  @@map("notification_templates")
}
