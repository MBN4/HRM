// Multi-tenancy data model — the isolation backbone for the whole system.
//
// Every table except `Tenant` is tenant-scoped: it carries a `tenantId`
// column, a composite index leading with `tenantId`, and (for self-relations)
// a composite foreign key back to `Tenant` so a row can never reference a
// parent belonging to a different tenant even before Row-Level Security is
// considered. RLS itself is NOT expressed here — Prisma has no RLS DSL — it
// is enabled by hand-written SQL in
// `prisma/migrations/<ts>_enable_row_level_security/migration.sql`.
//
// See /CLAUDE.md § Conventions → Tenancy model for the full write-up of how
// tenant context is propagated to Postgres at query time.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Partitioned tables (Phase 5.2 — see docs/conventions/partitioning-archival.md):
//
//   - attendance_records  — one row per clock-in/out shift; extremely high
//     volume. Created in step 1.3 (see AttendanceRecord below) PARTITION-READY
//     (composite primary key); actually `PARTITION BY RANGE (work_date)`
//     since Phase 5.2 (`partition_high_growth_tables` migration).
//   - audit_log           — one row per mutating action across the whole
//     system. Created in step 0.9 (see AuditLog below) PARTITION-READY
//     (composite primary key); actually `PARTITION BY RANGE (occurred_at)`
//     since Phase 5.2.
//   - platform_audit_log  — the cross-tenant platform trail (step 4.1, see
//     PlatformAuditLog below), same composite-PK shape; actually
//     `PARTITION BY RANGE (occurred_at)` since Phase 5.2 too.
//
// All three were deliberately built with a COMPOSITE primary key from day
// one — Postgres requires the partition key to be part of every unique
// constraint/PK on a partitioned table — so the Phase 5.2 migration that
// actually declares `PARTITION BY RANGE` is additive (rename old table,
// recreate as a native partitioned table with the SAME columns/PK/indexes/
// FKs/RLS policy/grants, copy every existing row into the correct partition,
// drop the old table), never a breaking change to this schema or to any
// caller. Partitions themselves are managed entirely at the Postgres/
// migration layer (raw SQL, a `hrm_ensure_range_partitions` helper function,
// and a scheduled BullMQ job that keeps upcoming partitions created ahead of
// time) — nothing about these three Prisma models changes: they are still
// queried/written exactly as any other model, through the SAME table name,
// via `withTenantContext`/`appPrisma` for the tenant-scoped two. See
// docs/conventions/partitioning-archival.md for the full write-up (RLS +
// immutability on partitions, partition pruning, and the archival/retention
// mechanism).
//
// `signature_events` (see SignatureEvent below) was assessed for the same
// treatment and deliberately NOT partitioned — see that model's own doc
// comment and docs/conventions/partitioning-archival.md § "Assessed, not
// partitioned" for why.
//   - Both need RLS enabled + FORCE ROW LEVEL SECURITY + the same
//     tenant_isolation policy pattern used below for every other
//     tenant-scoped table.
// ---------------------------------------------------------------------------

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum TenantEdition {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// Step 4.1 (vendor console) — how a tenant's data is physically isolated.
// SHARED_DB (the default, and the only mode this system actually runs
// today) is every tenant sharing one Postgres database, isolated by RLS —
// see docs/conventions/tenancy-rls.md. DB_PER_TENANT is a DOCUMENTED SEAM
// ONLY: storing the intent (so a future provisioning pipeline has
// somewhere to read it from) without building a second physical
// provisioning path — per this step's own brief, "a documented seam, not
// a full build now." Nothing in `withTenantContext`/RLS/the connection
// pool reads this value today.
enum TenantProvisionMode {
  SHARED_DB
  DB_PER_TENANT
}

// The tenant registry itself. Deliberately NOT tenant-scoped (it has no
// tenantId — it IS the tenant) and therefore NOT subject to Row-Level
// Security: resolving "which tenant is this request for" has to happen
// before a tenant context exists to filter by. `TenantDomain` below is the
// only other table with this same exemption, for the same reason.
model Tenant {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  slug               String              @unique
  status             TenantStatus        @default(TRIAL)
  edition            TenantEdition       @default(STARTER)
  // ISO 3166-1 alpha-2. Branches resolve their own countryCode; this is only
  // the fallback used where a branch hasn't been assigned one.
  defaultCountryCode String              @map("default_country_code") @db.VarChar(2)
  hostingRegion      String              @map("hosting_region")
  // ISO 4217 — the tenant's REPORTING currency for multi-branch/
  // multi-currency payroll rollups (step 2.1). A small, additive seam
  // column, same pattern as Branch.geofenceLat/Employee.terminatedAt — see
  // docs/conventions/payroll.md. Defaults to USD so no existing tenant row
  // is left null.
  baseCurrencyCode   String              @default("USD") @map("base_currency_code") @db.VarChar(3)
  // Step 4.1 — see TenantProvisionMode above. Vendor-console display/intent
  // field, defaulted so no existing tenant row is left null.
  provisionMode      TenantProvisionMode @default(SHARED_DB) @map("provision_mode")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  branches                       Branch[]
  departments                    Department[]
  designations                   Designation[]
  costCenters                    CostCenter[]
  users                          User[]
  domains                        TenantDomain[]
  permissions                    Permission[]
  roles                          Role[]
  rolePermissions                RolePermission[]
  userRoles                      UserRole[]
  userBranches                   UserBranch[]
  countryOverrides               TenantCountryOverride[]
  subscription                   Subscription?
  licenses                       License[]
  featureFlagOverrides           TenantFeatureFlagOverride[]
  invoices                       Invoice[]
  paymentMethods                 PaymentMethod[]
  billingEvents                  BillingEvent[]
  branding                       TenantBranding?
  workflowTemplates              WorkflowTemplate[]
  workflowSteps                  WorkflowStep[]
  workflowInstances              WorkflowInstance[]
  workflowInstanceSteps          WorkflowInstanceStep[]
  workflowActions                WorkflowAction[]
  notifications                  Notification[]
  notificationDeliveries         NotificationDelivery[]
  notificationPreferences        NotificationPreference[]
  auditLogs                      AuditLog[]
  tenantRetentionOverrides       TenantRetentionOverride[]
  customFieldDefinitions         CustomFieldDefinition[]
  customFieldValueSets           CustomFieldValueSet[]
  employees                      Employee[]
  employeeDependents             EmployeeDependent[]
  employeeEmergencyContacts      EmployeeEmergencyContact[]
  employeeDocuments              EmployeeDocument[]
  employeeImportJobs             EmployeeImportJob[]
  leaveBalances                  LeaveBalance[]
  leaveRequests                  LeaveRequest[]
  leaveAccrualRuns               LeaveAccrualRun[]
  shiftDefinitions               ShiftDefinition[]
  rosterAssignments              RosterAssignment[]
  attendanceRecords              AttendanceRecord[]
  attendanceRegularizations      AttendanceRegularization[]
  attendanceDailySummaries       AttendanceDailySummary[]
  headcountDailySnapshots        HeadcountDailySnapshot[]
  workforceMovementDailyCounts   WorkforceMovementDailyCount[]
  attendanceDailyBranchSummaries AttendanceDailyBranchSummary[]
  leaveUtilizationDailySnapshots LeaveUtilizationDailySnapshot[]
  payrollComponentDefinitions    PayrollComponentDefinition[]
  payrollRuns                    PayrollRun[]
  payrollRunLines                PayrollRunLine[]
  payslipDocuments               PayslipDocument[]
  payrollBankExports             PayrollBankExport[]
  ratingScales                   RatingScale[]
  appraisalCycles                AppraisalCycle[]
  goals                          Goal[]
  appraisals                     Appraisal[]
  reviewAssignments              ReviewAssignment[]
  reviews                        Review[]
  appraisalRatingDistributions   AppraisalRatingDistributionSnapshot[]
  jobRequisitions                JobRequisition[]
  jobPostings                    JobPosting[]
  candidates                     Candidate[]
  applications                   Application[]
  interviews                     Interview[]
  interviewScorecards            InterviewScorecard[]
  offers                         Offer[]
  onboardingProcesses            OnboardingProcess[]
  offboardingProcesses           OffboardingProcess[]
  checklistTemplates             ChecklistTemplate[]
  checklistTaskInstances         ChecklistTaskInstance[]
  expenseCategories              ExpenseCategory[]
  expenseClaims                  ExpenseClaim[]
  expenseLines                   ExpenseLine[]
  assetCategories                AssetCategory[]
  assets                         Asset[]
  assetAssignments               AssetAssignment[]
  assetMaintenanceRecords        AssetMaintenanceRecord[]
  ticketCategories               TicketCategory[]
  tickets                        Ticket[]
  ticketComments                 TicketComment[]
  ticketAttachments              TicketAttachment[]
  announcements                  Announcement[]
  policies                       Policy[]
  policyAcknowledgments          PolicyAcknowledgment[]
  lmsCourseCategories            CourseCategory[]
  lmsCourses                     Course[]
  lmsCourseContentItems          CourseContentItem[]
  lmsEnrollments                 Enrollment[]
  lmsContentProgress             ContentProgress[]
  lmsQuizzes                     Quiz[]
  lmsQuizQuestions               QuizQuestion[]
  lmsQuizAttempts                QuizAttempt[]
  lmsCertifications              Certification[]
  lmsRequiredTrainings           RequiredTraining[]
  lmsCourseCompletionSnapshots   CourseCompletionDailySnapshot[]
  lmsTrainingComplianceSnapshots TrainingComplianceDailySnapshot[]

  // Step 3.3 — Integrations (see docs/conventions/integrations.md).
  webhookSubscriptions         WebhookSubscription[]
  webhookDeliveries            WebhookDelivery[]
  apiKeys                      ApiKey[]
  ssoConfig                    SsoConfig?
  biometricDeviceRegistrations BiometricDeviceRegistration[]
  slackWorkspaceConfig         SlackWorkspaceConfig?

  // Step 4.1 — vendor console impersonation sessions targeting this tenant.
  // See PlatformAdmin/ImpersonationSession below.
  impersonationSessions ImpersonationSession[]

  // Step 3.5.1 — data migration & onboarding toolkit (see
  // docs/conventions/data-migration.md).
  columnMappingTemplates      ColumnMappingTemplate[]
  importBatches               ImportBatch[]
  importRowErrors             ImportRowError[]
  migratedAttendanceSummaries MigratedAttendanceSummary[]
  migratedPayslipRecords      MigratedPayslipRecord[]

  // Step 3.5.2 — Benefits administration (see docs/conventions/benefits.md).
  benefitPlans                BenefitPlan[]
  benefitPlanTiers            BenefitPlanTier[]
  benefitEnrollments          BenefitEnrollment[]
  benefitEnrollmentDependents BenefitEnrollmentDependent[]
  benefitContributionRecords  BenefitContributionRecord[]

  // Step 3.5.3 — e-signatures (see docs/conventions/e-signatures.md).
  signatureRequests    SignatureRequest[]
  signatureSigners     SignatureSigner[]
  signatureEvents      SignatureEvent[]
  signatureCertificates SignatureCertificate[]

  // Step 3.5.4 — statutory / government reporting (see
  // docs/conventions/statutory-reporting.md).
  generatedReports GeneratedReport[]

  // Step 6.1 — data privacy & residency (see
  // docs/conventions/privacy-residency.md).
  dataSubjectRequests          DataSubjectRequest[]
  consentRecords               ConsentRecord[]
  tenantDataRetentionOverrides TenantDataRetentionOverride[]

  @@map("tenants")
}

// Step 4.3 (white-label) — has ownership been proven for a branded custom
// domain, so it's safe to let it resolve real tenant traffic. See
// docs/conventions/white-label.md.
enum DomainVerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  FAILED
}

// Step 4.3 — TLS provisioning state for a branded custom domain, via the
// CERT_PROVIDER seam (MockCertProvider today; a real ACME client is a
// documented seam, not built — see docs/conventions/white-label.md).
enum DomainCertStatus {
  NONE
  PENDING
  ISSUED
  FAILED
}

// Custom-domain -> tenant mapping (e.g. "hr.acme-corp.example" -> the "acme"
// tenant), one of three tenant-resolution strategies used by
// apps/api's TenantResolutionService (see /CLAUDE.md § Conventions →
// Tenant resolution). Has a `tenantId` FK like any tenant-owned table, but
// — like `Tenant` itself — is deliberately EXEMPT from Row-Level Security:
// resolving a request's tenant from its Host header has to happen before a
// tenant context exists to filter by. Only `SELECT` is granted to `hrm_app`
// (see the `add_tenant_domains` migration).
//
// Step 4.3 gives this table a real, gated WRITE path (`BrandingDomainService`)
// — but because it stays RLS-EXEMPT (necessarily, per above), that write
// path deliberately does NOT run through a tenant-scoped `tx`: it goes
// through the OWNER `prisma` client, the same "RLS can't help here, the
// app code itself must scope by tenantId" pattern
// `PlatformTenantService`/`StripeWebhookService` already use for
// `Tenant.status` writes. See docs/conventions/white-label.md.
model TenantDomain {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  // Bare hostname, no scheme/port (e.g. "hr.acme-corp.example").
  domain    String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  // A domain only participates in TenantResolutionService's custom_domain
  // strategy once VERIFIED — a freshly-requested (PENDING_VERIFICATION) row
  // must never resolve real traffic before ownership is proven, or any
  // tenant admin could hijack another domain's traffic just by requesting
  // it first.
  verificationStatus DomainVerificationStatus @default(PENDING_VERIFICATION) @map("verification_status")
  // Random per-domain token the requester is asked to publish as a DNS TXT
  // record (`_hrm-verify.<domain>`) — proof of control, checked by
  // DomainVerificationService.
  verificationToken  String                   @map("verification_token")
  certStatus         DomainCertStatus         @default(NONE) @map("cert_status")
  certProvisionedAt  DateTime?                @map("cert_provisioned_at")
  certExpiresAt      DateTime?                @map("cert_expires_at")
  requestedByUserId  String?                  @map("requested_by_user_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domains")
}

// Step 4.3 (white-label) — per-tenant branding: logo, palette, product
// name, favicon, login-page copy, email sender identity, and the gated
// full-rebrand toggle. Ordinary tenant-scoped table (unlike TenantDomain
// above) — RLS applies normally; see docs/conventions/white-label.md.
model TenantBranding {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  productName        String?  @map("product_name")
  logoStorageKey     String?  @map("logo_storage_key")
  faviconStorageKey  String?  @map("favicon_storage_key")
  // Hex colors ("#rrggbb"), applied as CSS custom properties client-side.
  primaryColor       String?  @map("primary_color") @db.VarChar(7)
  secondaryColor     String?  @map("secondary_color") @db.VarChar(7)
  accentColor        String?  @map("accent_color") @db.VarChar(7)
  loginHeadline      String?  @map("login_headline")
  loginSubtext       String?  @map("login_subtext")
  emailFromName      String?  @map("email_from_name")
  emailFromAddress   String?  @map("email_from_address")
  // Lifetime/on-prem-oriented, gated behind FEATURE_FLAGS.FULL_REBRAND
  // (ENTERPRISE-only in EDITION_FEATURES) at WRITE time via the existing
  // @RequireFeature()/FeatureFlagGuard — see BrandingController. Even once
  // set, the "Powered by" footer's visibility is re-derived from the LIVE
  // entitlement on every read (never trusted from this stored bit alone),
  // the same "never cache entitlement" posture FeatureFlagGuard documents
  // for itself — a lapsed subscription/license restores the footer
  // automatically.
  fullRebrandEnabled Boolean  @default(false) @map("full_rebrand_enabled")
  updatedByUserId    String?  @map("updated_by_user_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_brandings")
}

// A tenant may operate branches in different countries — country resolution
// happens at the BRANCH level, not the tenant level (see /CLAUDE.md 0.5).
model Branch {
  id                   String  @id @default(uuid()) @db.Uuid
  tenantId             String  @map("tenant_id") @db.Uuid
  name                 String
  countryCode          String  @map("country_code") @db.VarChar(2)
  timezone             String
  parentBranchId       String? @map("parent_branch_id") @db.Uuid
  // Seam for the workflow engine's BRANCH_HEAD approver rule (step 0.7) —
  // see /CLAUDE.md § Conventions → Workflow engine → Approver rules.
  headUserId           String? @map("head_user_id") @db.Uuid
  // Optional geo-fence for this branch/site (step 1.3, Attendance) — all
  // three null (the default) means geo-fencing is OFF for this branch;
  // Attendance clock-in enforces it only when all three are set. A small,
  // nullable, additive seam column on an existing Phase-0 model, the SAME
  // pattern 0.7 already used for `headUserId` itself — see
  // docs/conventions/attendance.md.
  geofenceLat          Float?  @map("geofence_lat")
  geofenceLong         Float?  @map("geofence_long")
  geofenceRadiusMeters Int?    @map("geofence_radius_meters")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Composite FK back to the SAME tenant: a branch's parent must belong to
  // the same tenant, enforced at the schema level (not just by RLS).
  parentBranch  Branch?  @relation("BranchHierarchy", fields: [tenantId, parentBranchId], references: [tenantId, id], onDelete: SetNull)
  childBranches Branch[] @relation("BranchHierarchy")
  headUser      User?    @relation("BranchHead", fields: [tenantId, headUserId], references: [tenantId, id], onDelete: SetNull)

  departments                    Department[]
  userBranches                   UserBranch[]
  employees                      Employee[]
  attendanceRecords              AttendanceRecord[]
  attendanceDailySummaries       AttendanceDailySummary[]
  headcountDailySnapshots        HeadcountDailySnapshot[]
  workforceMovementDailyCounts   WorkforceMovementDailyCount[]
  attendanceDailyBranchSummaries AttendanceDailyBranchSummary[]
  leaveUtilizationDailySnapshots LeaveUtilizationDailySnapshot[]
  payrollRuns                    PayrollRun[]
  payrollRunLines                PayrollRunLine[]
  generatedReports               GeneratedReport[]
  appraisalRatingDistributions   AppraisalRatingDistributionSnapshot[]
  jobRequisitions                JobRequisition[]
  offers                         Offer[]
  expenseClaims                  ExpenseClaim[]
  assets                         Asset[]
  tickets                        Ticket[]
  lmsEnrollments                 Enrollment[]
  lmsRequiredTrainings           RequiredTraining[]
  lmsCourseCompletionSnapshots   CourseCompletionDailySnapshot[]
  lmsTrainingComplianceSnapshots TrainingComplianceDailySnapshot[]

  // Lets other tenant-scoped tables define a composite FK of
  // (tenantId, branchId) -> (tenantId, id) against this table.
  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, countryCode])
  @@index([tenantId, parentBranchId])
  @@index([tenantId, headUserId])
  @@map("branches")
}

model Department {
  id                 String  @id @default(uuid()) @db.Uuid
  tenantId           String  @map("tenant_id") @db.Uuid
  branchId           String  @map("branch_id") @db.Uuid
  name               String
  parentDepartmentId String? @map("parent_department_id") @db.Uuid
  // Seam for the workflow engine's DEPARTMENT_HEAD approver rule (step
  // 0.7) — see /CLAUDE.md § Conventions → Workflow engine → Approver rules.
  headUserId         String? @map("head_user_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)

  parentDepartment Department?  @relation("DepartmentHierarchy", fields: [tenantId, parentDepartmentId], references: [tenantId, id], onDelete: SetNull)
  childDepartments Department[] @relation("DepartmentHierarchy")
  headUser         User?        @relation("DepartmentHead", fields: [tenantId, headUserId], references: [tenantId, id], onDelete: SetNull)

  employees       Employee[]
  goals           Goal[]
  jobRequisitions JobRequisition[]
  offers          Offer[]

  @@unique([tenantId, id])
  @@unique([tenantId, branchId, name])
  @@index([tenantId, parentDepartmentId])
  @@index([tenantId, headUserId])
  @@map("departments")
}

model Designation {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  employees       Employee[]
  jobRequisitions JobRequisition[]
  offers          Offer[]

  // Lets Employee.designation define a composite FK of
  // (tenantId, designationId) -> (tenantId, id) against this table, same
  // pattern as Branch/Department/User/Role/Permission.
  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("designations")
}

model CostCenter {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String
  code     String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@map("cost_centers")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  email             String
  hashedPassword    String     @map("hashed_password")
  status            UserStatus @default(PENDING)
  // Employee->manager relation SEAM for the workflow engine's MANAGER
  // approver rule (step 0.7) — modeled here, on User, because the real
  // Employee module doesn't exist yet (phase 1.1). Once it does, the
  // MANAGER resolver in apps/api/src/workflow should be repointed at
  // whatever the Employee model's manager relation turns out to be;
  // nothing about the workflow engine itself should need to change, only
  // this one resolution function. See /CLAUDE.md § Conventions → Workflow
  // engine → Approver rules.
  managerId         String?    @map("manager_id") @db.Uuid
  // Per-user notification-language override (BCP-47, e.g. "en", "ar") — seam
  // for the notification hub (step 0.8). Null = fall back to the recipient's
  // resolved branch's Country Pack `locale.defaultLanguage`. See
  // /CLAUDE.md § Conventions → Notifications → Recipient locale resolution.
  preferredLanguage String?    @map("preferred_language")
  // Opaque push-notification device token (e.g. an Expo push token) — seam
  // for the notification hub's PUSH channel (step 0.8), added in step 1.4
  // for the mobile app. Null = no device registered; `LogPushProvider`
  // falls back to the recipient's user id as a placeholder `to` when this
  // is unset, same "documented gap, not silently accepted" posture the SMS
  // provider already takes. A real FCM/Expo-push-API provider swapped in
  // later reads this exact column; nothing else about the delivery
  // pipeline needs to change. See /CLAUDE.md § Conventions → Notifications.
  pushToken         String?    @map("push_token")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Composite self-relation, same pattern as Branch.parentBranchId /
  // Department.parentDepartmentId: a manager must belong to the same
  // tenant, enforced at the schema level in addition to RLS.
  manager       User?  @relation("UserManager", fields: [tenantId, managerId], references: [tenantId, id], onDelete: SetNull)
  directReports User[] @relation("UserManager")

  roles    UserRole[]
  branches UserBranch[]

  headOfBranches        Branch[]               @relation("BranchHead")
  headOfDepartments     Department[]           @relation("DepartmentHead")
  workflowRequests      WorkflowInstance[]     @relation("WorkflowRequester")
  employeeProfile       Employee?
  // Step 4.1 — vendor-console support sessions impersonating THIS user.
  impersonationSessions ImpersonationSession[]

  // Per-tenant uniqueness, NOT global: the same email may exist under
  // different tenants as entirely unrelated accounts.
  @@unique([tenantId, email])
  // Lets UserRole/UserBranch/the manager self-relation define a composite
  // FK of (tenantId, userId) -> (tenantId, id) against this table, same
  // pattern as Branch/Role/Permission.
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, managerId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// RBAC (step 0.4). Both Permission and Role are tenant-scoped — deliberately:
// the permission catalog and role set are seeded defaults (see
// packages/shared's PERMISSIONS/SYSTEM_ROLE_PERMISSIONS constants and
// packages/db/src/seed-rbac.ts), but they are EDITABLE DATA per tenant, not
// hardcoded enums. A tenant can rename/add roles or (eventually) permissions
// without a code change or a migration. Enforcement always reads the current
// DB rows, never the seed constants, so edits take effect immediately.
// ---------------------------------------------------------------------------

// A granular capability string (e.g. "employee.read", "salary.view"),
// checked by PermissionsGuard / @RequirePermissions() and by the
// field-level @RequiresPermission() serialization pattern (see
// /CLAUDE.md § Conventions → Field-level permissions).
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  key         String
  description String?

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("permissions")
}

model Role {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  // Seeded system roles (TENANT_ADMIN/HR_MANAGER/MANAGER/EMPLOYEE) vs. a
  // tenant's own custom roles — informational only; nothing in this schema
  // prevents editing a system role's permission set, on purpose.
  isSystem Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions          RolePermission[]
  users                UserRole[]
  lmsRequiredTrainings RequiredTraining[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("roles")
}

model RolePermission {
  tenantId     String @map("tenant_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  permission Permission @relation(fields: [tenantId, permissionId], references: [tenantId, id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([tenantId])
  @@map("role_permissions")
}

model UserRole {
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  role   Role   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([tenantId])
  @@map("user_roles")
}

// A user with zero rows here is UNRESTRICTED (sees every branch in their
// tenant, subject to tenant RLS as always). One or more rows means the user
// is limited to exactly those branches — enforced in
// apps/api/src/tenancy/tenant-scope.interceptor.ts by populating
// `branchIds` in the request context from this table every request; actual
// filtering happens in application queries (RLS has no per-branch concept,
// only per-tenant).
model UserBranch {
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([tenantId])
  @@map("user_branches")
}

// ---------------------------------------------------------------------------
// Country packs (step 0.5). See /CLAUDE.md § Conventions → Country packs for
// the full write-up of the schema shape, resolution order, and the two-layer
// override model.
// ---------------------------------------------------------------------------

// A versioned, system-owned bundle of legal/cultural defaults for one
// country (locale, working time, leave, public holidays, tax, statutory
// contributions, required employee fields, payslip template, payroll mode).
// Deliberately NOT tenant-scoped — there is no `tenantId` column, this is
// global reference data the vendor maintains, not per-tenant data — and
// therefore NOT subject to Row-Level Security, the same exemption reasoning
// as `Tenant`/`TenantDomain` (there is no tenant_id for a policy to filter
// on). `config` is validated against `@hrm/shared`'s `countryPackConfigSchema`
// before every write AND re-validated on every read (see
// CountryPackResolutionService) — a JSON column has no schema-level
// guarantee, so both directions are checked, consistent with this project's
// "no single layer is trusted alone" security posture.
//
// Writable only through the owner/admin role today (seeded — see
// `packages/db/src/seed-country-packs.ts`), the same as the RBAC permission
// catalog: a real admin-editable UI is a later phase, tracked as "not yet
// built" work, not implied by this model existing.
model CountryPack {
  id          String   @id @default(uuid()) @db.Uuid
  countryCode String   @map("country_code") @db.VarChar(2)
  version     Int      @default(1)
  // Whether resolution should consider this version current for the
  // country. Lets a new version be seeded and activated without deleting
  // the previous one (useful for legal-change audit history later).
  isActive    Boolean  @default(true) @map("is_active")
  config      Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([countryCode, version])
  @@index([countryCode, isActive])
  @@map("country_packs")
}

// A tenant's diff on top of one country's CountryPack — e.g. "25 days
// annual leave instead of the legal default of 20". Tenant-scoped: ordinary
// Row-Level Security applies, identical pattern to every other tenant-owned
// table in this schema. `overrides` is validated against
// `tenantCountryOverrideSchema` (a `.strict()` schema covering only the
// sections that are legally/culturally safe for a tenant to adjust —
// leaveDefaults, workingTime, requiredEmployeeFields, payslipTemplate; tax
// and statutory contributions are never tenant-overridable) and, where
// sensible, against bounds derived from the pack itself (e.g. a tenant may
// only grant MORE leave than the legal floor, never less) — see
// CountryPackResolutionService.
model TenantCountryOverride {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  countryCode String   @map("country_code") @db.VarChar(2)
  overrides   Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, countryCode])
  @@index([tenantId])
  @@map("tenant_country_overrides")
}

// ---------------------------------------------------------------------------
// Licensing / feature flags (step 0.6). See /CLAUDE.md § Conventions →
// Licensing / feature flags for the full write-up of the two delivery
// modes, the license file format, key handling, and seat-cap enforcement.
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

// SaaS-mode (LICENSE_MODE=saas) entitlement source. `edition` here, NOT
// `Tenant.edition`, is what FeatureFlagResolutionService reads in SaaS
// mode: a subscription's plan is naturally what a real billing system
// attaches edition/seat data to, and keeping a single field as
// resolution's source of truth avoids two columns drifting out of sync.
// `Tenant.edition` (0.2) keeps its original display/legacy role. `seatCap`
// is nullable: SaaS-mode seat-cap enforcement is "flagged" (audited), not
// blocking (see Seat-cap enforcement in Conventions) — a null cap means
// the check is skipped entirely for that tenant.
//
// Step 4.2 (billing) — this row is now driven by REAL Stripe state, not a
// manually-created stub: `stripeSubscriptionId`/`stripeCustomerId` link it
// to Stripe's own objects, and every field below `currentPeriodEnd` is
// updated ONLY by `StripeWebhookService` reacting to a verified, signed
// `customer.subscription.*` event (or, for a brand-new tenant, by
// `BillingService.startCheckout`'s own create-then-sync path) — never
// edited by hand outside a test/seed fixture. `stripeCustomerId`/
// `stripeSubscriptionId` are nullable because a tenant can exist (even
// TRIAL) before ever reaching Stripe (see BillingService.ensureCustomer).
model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  tenantId             String             @map("tenant_id") @db.Uuid
  edition              TenantEdition
  status               SubscriptionStatus @default(TRIAL)
  seatCap              Int?               @map("seat_cap")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  // ISO 4217, lowercase (Stripe's own convention) — the currency this
  // subscription is actually billed in, which may differ from
  // Tenant.baseCurrencyCode (a tenant's REPORTING currency, see
  // docs/conventions/payroll.md) when Stripe Tax/multi-currency pricing
  // puts the customer on a different billing currency.
  currency             String             @default("usd") @db.VarChar(3)
  stripeCustomerId     String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  stripePriceId        String?            @map("stripe_price_id")
  // The billed quantity (active seats) as of the last seat-metering sync —
  // see BillingSeatMeteringService. Snapshotted, not derived live, so a
  // rendered "current plan" screen never has to re-run SeatCapService's
  // own COUNT just to display what Stripe was last told.
  quantity             Int?
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  trialEndsAt          DateTime?          @map("trial_ends_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  // At most one subscription per tenant.
  @@unique([tenantId])
  @@map("subscriptions")
}

enum InvoiceType {
  SUBSCRIPTION
  SETUP_FEE
  // Lifetime/on-prem tenants pay via a signed license file (0.6), never a
  // Subscription — but the vendor still needs to bill them for ongoing
  // annual maintenance/support. AMC invoices are Stripe Invoice objects
  // created directly (no Stripe Subscription involved) via the platform
  // console — see PlatformBillingService.createAmcInvoice.
  AMC
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

// One row per Stripe Invoice — SaaS subscription invoices arrive via
// webhook (`invoice.*` events); AMC/setup-fee invoices are created
// directly by the platform console and then kept in sync the same way.
// Every monetary column is `Decimal` — see docs/conventions/payroll.md's
// "Money and multi-currency" section, reused verbatim: NEVER a float,
// summed only via `Prisma.Decimal` arithmetic.
model Invoice {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  subscriptionId   String?       @map("subscription_id") @db.Uuid
  type             InvoiceType   @default(SUBSCRIPTION)
  status           InvoiceStatus @default(DRAFT)
  stripeInvoiceId  String?       @unique @map("stripe_invoice_id")
  stripeCustomerId String?       @map("stripe_customer_id")
  currency         String        @db.VarChar(3)
  amountDue        Decimal       @map("amount_due") @db.Decimal(14, 2)
  amountPaid       Decimal       @default(0) @map("amount_paid") @db.Decimal(14, 2)
  amountRemaining  Decimal       @map("amount_remaining") @db.Decimal(14, 2)
  description      String?
  periodStart      DateTime?     @map("period_start")
  periodEnd        DateTime?     @map("period_end")
  dueDate          DateTime?     @map("due_date")
  hostedInvoiceUrl String?       @map("hosted_invoice_url")
  invoicePdfUrl    String?       @map("invoice_pdf_url")
  issuedAt         DateTime?     @map("issued_at")
  paidAt           DateTime?     @map("paid_at")
  voidedAt         DateTime?     @map("voided_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("invoices")
}

// A tenant's stored, tokenized payment method — Stripe holds the actual
// card/bank details; this table only ever stores the non-sensitive display
// fields Stripe's own API already returns unencrypted (brand/last4/expiry)
// plus the `stripePaymentMethodId` reference. No PAN/CVC ever reaches this
// system, so there's nothing here for EncryptionService to protect — the
// same "adapter/DB layer never sees the raw secret" posture Stripe's own
// hosted Elements/Checkout is designed to guarantee end to end.
model PaymentMethod {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  stripePaymentMethodId String   @unique @map("stripe_payment_method_id")
  type                  String
  brand                 String?
  last4                 String?  @db.VarChar(4)
  expMonth              Int?     @map("exp_month")
  expYear               Int?     @map("exp_year")
  isDefault             Boolean  @default(false) @map("is_default")
  createdAt             DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("payment_methods")
}

// The durable idempotency backstop for inbound Stripe webhooks — the SAME
// "two independent layers, no single one trusted alone" posture
// docs/conventions/payroll.md documents for PayrollRunLine: 0.10's
// `IdempotencyService` (Redis, `execute('stripe-webhook', event.id, fn)`)
// is the fast-path guard, and this table's `@@unique([tenantId,
// stripeEventId])` is the DB-level backstop — a redelivered event that
// somehow raced past the Redis claim (a TTL eviction, a process restart)
// still hits a P2002 here and is treated as "already applied", never
// double-applied. Tenant-scoped (ordinary RLS) since a webhook event
// always resolves to exactly one tenant's Stripe customer before this row
// is written — see StripeWebhookService.handleEvent. An event that cannot
// be resolved to any tenant (a stale/orphaned Stripe object) is recorded
// into PlatformAuditLog instead, never here.
model BillingEvent {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  stripeEventId String   @map("stripe_event_id")
  eventType     String   @map("event_type")
  processedAt   DateTime @default(now()) @map("processed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, stripeEventId])
  @@map("billing_events")
}

enum LicenseStatus {
  ACTIVE
  REVOKED
  EXPIRED
  SUPERSEDED
}

// Lifetime/on-prem-mode (LICENSE_MODE=lifetime) entitlement source: the
// DB-side record of a signed license FILE after activation. `signedToken`
// is kept (not just its decoded snapshot) so the signature can be
// RE-VERIFIED against the RS256 public key on every entitlement
// resolution, not just trusted from `enabledFlags`/`seatCap`/`expiresAt`
// once at activation time — this is what satisfies "verify on boot and
// periodically" without a separate scheduler (see Conventions). At most
// one row per tenant should be ACTIVE at a time; activating a new license
// moves the previous ACTIVE row to SUPERSEDED (enforced in application
// code, not a DB constraint — history is kept intentionally, for audit).
model License {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  edition      TenantEdition
  // Snapshot of the signed payload's enabled-flags list, for fast reads —
  // always re-validated against `signedToken`'s signature before being
  // trusted (see LicenseResolutionService).
  enabledFlags Json          @map("enabled_flags")
  seatCap      Int           @map("seat_cap")
  signedToken  String        @map("signed_token") @db.Text
  issuedAt     DateTime      @map("issued_at")
  expiresAt    DateTime?     @map("expires_at")
  status       LicenseStatus @default(ACTIVE)
  activatedAt  DateTime?     @map("activated_at")
  revokedAt    DateTime?     @map("revoked_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("licenses")
}

// A tenant-specific grant OR revocation of one feature flag, layered on
// top of whatever the edition/subscription (SaaS) or license (lifetime)
// would otherwise resolve to — the platform-admin lever for "give this
// tenant early access to X" or "turn off Y for this tenant specifically"
// without touching their edition/license. `enabled: true` grants the flag
// even if their edition/license wouldn't otherwise include it; `enabled:
// false` revokes it even if their edition/license would. Tenant-scoped:
// ordinary RLS applies, identical pattern to every other tenant-owned
// table — reads happen inside a normal tenant request's transaction,
// writes happen only through the platform-context admin endpoints (see
// Conventions), which use the owner/admin client directly since a
// platform request opens no tenant-scoped transaction (see Platform
// context in Conventions).
model TenantFeatureFlagOverride {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  flagKey   String   @map("flag_key")
  enabled   Boolean
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, flagKey])
  @@index([tenantId])
  @@map("tenant_feature_flag_overrides")
}

// ---------------------------------------------------------------------------
// Vendor super-admin console (step 4.1). See /CLAUDE.md's docs index ->
// docs/conventions/vendor-console.md for the full write-up: the platform
// identity/role model, mandatory MFA, the audited cross-tenant access
// rules, tenant lifecycle, pack authoring/versioning, usage metrics, and
// the impersonation design.
//
// `PlatformAdmin`/`PlatformAuditLog` are, like `Tenant`/`CountryPack`,
// DELIBERATELY NOT tenant-scoped (no `tenantId` column) and therefore NOT
// subject to Row-Level Security — a platform admin is not a member of any
// tenant, the same exemption reasoning documented above `Tenant`. `hrm_app`
// is granted NOTHING on either table (stricter than CountryPack's
// read-only grant): unlike Country Pack config, no tenant-scoped request
// path ever needs to read platform identity or the platform audit trail —
// every access to these two tables goes through the owner `prisma` client
// on the audited `@PlatformRoute()` path only, the same class of access
// `LicensingAdminService` already established for `Tenant`/`License`/
// `Subscription` writes. `ImpersonationSession` is the one model in this
// section that IS tenant-scoped (it targets a real tenant User) — ordinary
// RLS applies to it, identical `tenant_isolation` policy pattern to every
// other tenant-owned table, even though it too is only ever WRITTEN via
// the owner client (a platform request opens no tenant-scoped transaction
// to write through — see docs/conventions/tenant-resolution.md → Platform
// context).
// ---------------------------------------------------------------------------

enum PlatformRoleName {
  PLATFORM_OWNER
  PLATFORM_SUPPORT
}

enum PlatformAdminStatus {
  ACTIVE
  SUSPENDED
}

// A vendor operations-staff identity — completely separate from `User`
// (tenant-scoped): structurally, a tenant user can never become a platform
// admin by any data path, and a platform admin never appears in any
// tenant's own People screens. `role` is a closed, code-level catalog
// (`@hrm/shared`'s `PLATFORM_ROLE_PERMISSIONS`), NOT DB-editable RBAC like
// tenant `Role`/`Permission` — the vendor's own ops model is a fixed,
// reviewed set of two roles, not tenant-customizable data.
model PlatformAdmin {
  id                     String              @id @default(uuid()) @db.Uuid
  email                  String              @unique
  name                   String
  hashedPassword         String              @map("hashed_password")
  role                   PlatformRoleName
  status                 PlatformAdminStatus @default(ACTIVE)
  // TOTP secret (RFC 6238), AES-256-GCM encrypted via the existing
  // EncryptionService — reversible, since every login must verify a fresh
  // 30-second code against it. MFA is MANDATORY, enforced in
  // PlatformAuthService, not by a DB constraint: a freshly created admin
  // has mfaEnabled=false and cannot complete login (only the enrollment
  // step) until enrollment finishes.
  mfaSecretEncrypted     String?             @map("mfa_secret_encrypted")
  mfaEnabled             Boolean             @default(false) @map("mfa_enabled")
  // One-time recovery codes, argon2id-hashed via the existing
  // HashingService (one-way — only ever verified, never decrypted, the
  // opposite tradeoff from mfaSecretEncrypted above, same
  // hash-vs-encrypt split documented for API keys vs. webhook secrets in
  // docs/conventions/integrations.md). Each is removed from this array the
  // moment it's used.
  mfaRecoveryCodesHashed Json?               @map("mfa_recovery_codes_hashed")
  lastLoginAt            DateTime?           @map("last_login_at")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  @@map("platform_admins")
}

// A time-boxed support session where a platform admin acts AS a tenant
// user. Tenant-scoped (ordinary RLS) because it targets a real tenant
// User; `platformAdminId` is a plain UUID column with NO FK relation
// (PlatformAdmin isn't tenant-scoped, so it can't participate in a
// composite (tenantId, id) relation the way tenant-scoped tables do) —
// the same "just an id, a log fact not a structural relationship"
// convention `WorkflowInstanceStep.delegatedToUserId`/
// `WorkflowAction.actorUserId` already establish. `expiresAt` is checked
// on EVERY request authenticated with this session's impersonation token
// (see PlatformImpersonationService/TenantScopeInterceptor) — there is no
// separate sweep job; an expired-but-not-yet-`endedAt`-stamped session
// simply stops authenticating, and the sweep (ImpersonationService) only
// backfills `endedAt`/`endedReason` for bookkeeping/audit-listing
// clarity.
model ImpersonationSession {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  targetUserId    String    @map("target_user_id") @db.Uuid
  platformAdminId String    @map("platform_admin_id") @db.Uuid
  reason          String
  startedAt       DateTime  @default(now()) @map("started_at")
  expiresAt       DateTime  @map("expires_at")
  endedAt         DateTime? @map("ended_at")
  // "EXPIRED" | "MANUAL" | "REVOKED" — free-form, not an enum: purely a
  // bookkeeping label for the admin console's session history list.
  endedReason     String?   @map("ended_reason")

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  targetUser User   @relation(fields: [tenantId, targetUserId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, targetUserId])
  @@index([platformAdminId, startedAt])
  @@map("impersonation_sessions")
}

// The cross-tenant / no-single-tenant-target platform audit trail —
// EVERY platform action is audited (login, MFA enrollment, tenant
// lifecycle changes, license issue/revoke, country-pack authoring/
// versioning/activation, usage/audit reads, impersonation start/end, and
// every action performed WHILE impersonating). Tenant-targeted mutations
// (tenant create/suspend/resume/delete, license issue/revoke, flag
// overrides) are ALSO recorded into that tenant's own `audit_log` via the
// existing `AuditRecordService.recordForTenant` (`actorPlatform: true`,
// same convention 0.6's LicensingAdminService already established) —
// this table exists for the actions that have no single tenant to attach
// to (country-pack authoring, cross-tenant listings/reads, platform-admin
// account management) and as the vendor's OWN consolidated view that
// doesn't require iterating every tenant's audit_log to reconstruct "what
// did platform admin X do." PARTITION-READY shape (composite `(id,
// occurredAt)` PK), same reasoning as `AuditLog` — this table is
// append-only and unbounded — and actually `PARTITION BY RANGE (occurred_at)`
// since Phase 5.2, same as `AuditLog`/`AttendanceRecord` — see
// docs/conventions/partitioning-archival.md. `platformAdminId` is nullable for
// the one system-initiated case (the impersonation-expiry sweep has no
// human actor), the same nullable-system-actor convention
// `WorkflowAction.actorUserId` already uses for ESCALATE/AUTO_APPROVE.
model PlatformAuditLog {
  id              String   @default(uuid()) @db.Uuid
  occurredAt      DateTime @default(now()) @map("occurred_at")
  platformAdminId String?  @map("platform_admin_id") @db.Uuid
  action          String
  entityType      String   @map("entity_type")
  entityId        String?  @map("entity_id")
  targetTenantId  String?  @map("target_tenant_id") @db.Uuid
  // Redacted via the existing @hrm/shared redactSensitiveFields before
  // ever reaching these columns — same discipline AuditRecordService
  // already holds itself to.
  before          Json?
  after           Json?
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")

  @@id([id, occurredAt])
  @@index([occurredAt])
  @@index([platformAdminId, occurredAt])
  @@index([targetTenantId, occurredAt])
  @@map("platform_audit_log")
}

// ---------------------------------------------------------------------------
// Workflow / approval engine (step 0.7). ONE generic engine — leave,
// expenses, regularizations, offer approvals, and anything else that ever
// needs an approval chain all consume THIS model. See /CLAUDE.md §
// Conventions → Workflow engine for the full write-up: approver-rule
// resolution, conditional branching via the shared sandboxed expression
// evaluator, and THE RULE that no future module may build its own
// approval logic.
// ---------------------------------------------------------------------------

// A named, versioned, tenant-configurable approval process for one
// `entityType`. `entityType` is a free-form string, NOT a Postgres enum —
// enforcing a closed catalog here would mean a migration every time a new
// consuming module (leave, expenses, ...) is added, defeating the point of
// a generic engine. Versioned + `isActive` the same way `CountryPack` is
// (0.5): multiple versions may exist; resolution picks the active one with
// the highest version for a given `(tenantId, entityType)`.
model WorkflowTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  entityType  String   @map("entity_type")
  version     Int      @default(1)
  isActive    Boolean  @default(true) @map("is_active")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  steps     WorkflowStep[]
  instances WorkflowInstance[]

  @@unique([tenantId, id])
  @@unique([tenantId, entityType, version])
  @@index([tenantId, entityType, isActive])
  @@map("workflow_templates")
}

// One step in a template's approval chain. Steps sharing the same `order`
// within a template form a PARALLEL group — every one of them must reach
// APPROVED before the instance advances past that `order`; steps with
// different `order` values run SEQUENTIALLY. `approverRule` is a JSON
// `ApproverRule` (`@hrm/shared`) — SPECIFIC_USER/ROLE/MANAGER/BRANCH_HEAD/
// DEPARTMENT_HEAD, optionally wrapped in a CONDITIONAL that picks between
// two sub-rules — validated on every write AND read, same "JSON column
// has no schema-level guarantee of its own" posture as 0.5's CountryPack.
// `condition` (nullable) gates whether this step applies to a given
// instance AT ALL — this is the CONDITIONAL BRANCHING mechanism (e.g. "add
// a step only when amount > threshold"), evaluated against the instance's
// `dataSnapshot` via the workflow condition sandbox (see Conventions);
// null = always applies. `autoApproveCondition` (nullable) lets a step
// resolve to APPROVED with no human action when true (e.g. small
// low-risk amounts) — a DIFFERENT mechanism from `condition`: `condition`
// decides whether the step exists at all for this instance; here the step
// exists but needs nobody to click anything.
model WorkflowStep {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  templateId             String   @map("template_id") @db.Uuid
  name                   String
  order                  Int
  approverRule           Json     @map("approver_rule")
  condition              Json?    @map("condition")
  autoApproveCondition   Json?    @map("auto_approve_condition")
  // Minutes after activation before this step escalates. Null = never.
  escalationAfterMinutes Int?     @map("escalation_after_minutes")
  // ApproverRule (JSON) — who an overdue step escalates to. Required
  // whenever `escalationAfterMinutes` is set (validated at the app layer,
  // not the DB — same "shape validated outside the JSON column" posture
  // as everything else here).
  escalationRule         Json?    @map("escalation_rule")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template      WorkflowTemplate       @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Cascade)
  instanceSteps WorkflowInstanceStep[]

  @@unique([tenantId, id])
  @@index([tenantId, templateId, order])
  @@map("workflow_steps")
}

enum WorkflowInstanceStatus {
  PENDING
  IN_STEP
  APPROVED
  REJECTED
  CANCELED
  ESCALATED
}

// A running approval for ANY entity — POLYMORPHIC via `entityType` +
// `entityId` (the id of a row in whatever future module owns it — leave
// request, expense claim, ...; this table has no FK to it, deliberately,
// since that row's table doesn't exist yet for most consumers and never
// should be a hard dependency of the generic engine). `dataSnapshot` is
// the JSON the engine's condition/auto-approve/escalation expressions
// evaluate against (e.g. `{ amount, leaveType, days }`) — captured once at
// submission time, not re-read from the owning module later, so an
// approval chain already in flight is unaffected by the source record
// changing underneath it.
model WorkflowInstance {
  id           String                 @id @default(uuid()) @db.Uuid
  tenantId     String                 @map("tenant_id") @db.Uuid
  templateId   String                 @map("template_id") @db.Uuid
  entityType   String                 @map("entity_type")
  entityId     String                 @map("entity_id")
  requesterId  String                 @map("requester_id") @db.Uuid
  dataSnapshot Json                   @map("data_snapshot")
  status       WorkflowInstanceStatus @default(PENDING)
  // The `order` value currently active; null once the instance is terminal.
  currentOrder Int?                   @map("current_order")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  completedAt  DateTime?              @map("completed_at")

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template  WorkflowTemplate       @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Cascade)
  requester User                   @relation("WorkflowRequester", fields: [tenantId, requesterId], references: [tenantId, id], onDelete: Cascade)
  steps     WorkflowInstanceStep[]
  actions   WorkflowAction[]

  @@unique([tenantId, id])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, requesterId, status])
  @@map("workflow_instances")
}

enum WorkflowStepStatus {
  PENDING
  SKIPPED
  ACTIVE
  APPROVED
  REJECTED
  ESCALATED
}

// The per-instance materialization of one template step — which lets the
// same template be reused across many instances while each instance
// tracks its OWN resolved approvers and progress independently.
// `eligibleApproverIds` is a snapshot (JSON string[]) of who could act
// when this step activated, resolved by apps/api's approver-rule
// resolvers — captured at activation time so a later org-chart change
// (a new manager, a reassigned branch head) never rewrites history on an
// approval already in flight. `delegatedToUserId`/`escalatedToUserId` are
// plain UUID columns with no FK relation (an audit/tracking reference,
// the same class of "just a user id" field `auth-events.ts`'s
// `AuthEventPayload.userId` already is elsewhere in this codebase) —
// deliberately, to avoid yet another named back-relation on `User` for
// what is fundamentally a log fact, not a structural relationship.
model WorkflowInstanceStep {
  id                  String             @id @default(uuid()) @db.Uuid
  tenantId            String             @map("tenant_id") @db.Uuid
  instanceId          String             @map("instance_id") @db.Uuid
  templateStepId      String             @map("template_step_id") @db.Uuid
  name                String
  // Copied from the template step at activation time so ordering stays
  // stable even if the template is edited later.
  order               Int
  status              WorkflowStepStatus @default(PENDING)
  eligibleApproverIds Json               @map("eligible_approver_ids")
  delegatedToUserId   String?            @map("delegated_to_user_id") @db.Uuid
  escalatedToUserId   String?            @map("escalated_to_user_id") @db.Uuid
  activatedAt         DateTime?          @map("activated_at")
  // activatedAt + the template step's escalationAfterMinutes; null if
  // that step has no escalation rule.
  dueAt               DateTime?          @map("due_at")
  decidedAt           DateTime?          @map("decided_at")
  decidedByUserId     String?            @map("decided_by_user_id") @db.Uuid

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instance     WorkflowInstance @relation(fields: [tenantId, instanceId], references: [tenantId, id], onDelete: Cascade)
  templateStep WorkflowStep     @relation(fields: [tenantId, templateStepId], references: [tenantId, id], onDelete: Cascade)
  actions      WorkflowAction[]

  @@unique([tenantId, id])
  @@index([tenantId, instanceId, order])
  @@index([tenantId, status, dueAt])
  @@map("workflow_instance_steps")
}

enum WorkflowActionType {
  APPROVE
  REJECT
  DELEGATE
  COMMENT
  ESCALATE
  AUTO_APPROVE
  CANCEL
}

// The audit trail: one row per approve/reject/delegate/comment/escalate/
// auto-approve/cancel, who (if anyone — ESCALATE and AUTO_APPROVE are
// system-initiated, `actorUserId` is null for those) and when. Never
// updated or deleted once written. `actorUserId`/`delegatedToUserId` are
// plain UUID columns with no FK relation, same reasoning as
// `WorkflowInstanceStep`'s equivalents above.
model WorkflowAction {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  instanceId        String             @map("instance_id") @db.Uuid
  instanceStepId    String?            @map("instance_step_id") @db.Uuid
  actionType        WorkflowActionType @map("action_type")
  actorUserId       String?            @map("actor_user_id") @db.Uuid
  delegatedToUserId String?            @map("delegated_to_user_id") @db.Uuid
  comment           String?
  createdAt         DateTime           @default(now()) @map("created_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instance     WorkflowInstance      @relation(fields: [tenantId, instanceId], references: [tenantId, id], onDelete: Cascade)
  instanceStep WorkflowInstanceStep? @relation(fields: [tenantId, instanceStepId], references: [tenantId, id], onDelete: SetNull)

  @@index([tenantId, instanceId])
  @@map("workflow_actions")
}

// ---------------------------------------------------------------------------
// Notifications hub (step 0.8). See /CLAUDE.md § Conventions → Notifications
// for the full write-up: the async BullMQ delivery pipeline, the swappable
// per-channel provider seam, the event -> notification mapping layer, and
// recipient-locale-driven template rendering. This is the delivery layer the
// domain events already emitted by auth (0.4), licensing (0.6), and workflow
// (0.7) have been waiting for — those modules are untouched by this step
// (beyond auth's password-reset event gaining a `token` field), they already
// emit everything this hub needs.
// ---------------------------------------------------------------------------

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  // Added in step 3.3 (Integrations) — the Slack adapter is a real
  // NotificationProvider bound to SLACK_PROVIDER, resolving `to` as the
  // tenant's configured incoming-webhook URL (SlackWorkspaceConfig) rather
  // than a per-recipient address, the same way PUSH resolves `to` from
  // User.pushToken. Opt-in only: absent from DEFAULT_NOTIFICATION_CHANNELS,
  // a tenant enables it per event type via NotificationPreference. See
  // docs/conventions/integrations.md.
  SLACK
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  DEAD_LETTER
}

// One row per notification GENERATED for one recipient from one domain
// event — channel-agnostic. `payload` is the triggering domain event's
// payload (see auth-events.ts/licensing-events.ts/workflow-events.ts),
// kept so a delivery can be re-rendered (retry, or a future "resend")
// without re-deriving it from the source event, which by then may no
// longer be in flight. `eventType` is a free-form string (e.g.
// "workflow.approved"), NOT a Postgres enum — same reasoning as
// `WorkflowInstance.entityType`: a closed catalog here would mean a
// migration every time a new consuming module's event gets mapped to a
// notification.
model Notification {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  recipientUserId String   @map("recipient_user_id") @db.Uuid
  eventType       String   @map("event_type")
  payload         Json
  createdAt       DateTime @default(now()) @map("created_at")

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([tenantId, id])
  @@index([tenantId, recipientUserId, createdAt])
  @@map("notifications")
}

// One row per CHANNEL a Notification is delivered through — the unit of
// work a BullMQ job processes (job data is just `{ tenantId,
// notificationDeliveryId }`; everything else is loaded fresh from this row
// inside the worker, so a retried job always sees current state). `status`
// starts PENDING at enqueue time; the worker moves it to SENT on success,
// or — on failure — FAILED (more retries remain, BullMQ will re-attempt
// per the job's `attempts`/`backoff` options) or DEAD_LETTER (this was the
// final attempt; `lastError` holds why). `readAt` is only ever set for
// `IN_APP` deliveries (mark-read) — left null and unused for every other
// channel, simpler than a separate one-row-per-channel-family schema for
// what's otherwise an identical shape. `renderedSubject`/`renderedBody`
// are the actual rendered-in-the-recipient's-locale strings, captured at
// send time so a user's in-app notification list reads correctly even if
// the underlying NotificationTemplate is edited/re-versioned later.
model NotificationDelivery {
  id              String                     @id @default(uuid()) @db.Uuid
  tenantId        String                     @map("tenant_id") @db.Uuid
  notificationId  String                     @map("notification_id") @db.Uuid
  channel         NotificationChannel
  status          NotificationDeliveryStatus @default(PENDING)
  attempts        Int                        @default(0)
  lastError       String?                    @map("last_error")
  renderedSubject String?                    @map("rendered_subject")
  renderedBody    String?                    @map("rendered_body")
  sentAt          DateTime?                  @map("sent_at")
  readAt          DateTime?                  @map("read_at")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [tenantId, notificationId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, notificationId])
  @@index([tenantId, status])
  @@map("notification_deliveries")
}

// Per-user, per-event-type, per-channel opt-in/opt-out — tenant-scoped,
// ordinary RLS. Absence of a row for a given (userId, eventType, channel)
// means "use the default" (`@hrm/shared`'s `DEFAULT_NOTIFICATION_CHANNELS`
// for that event type) — a row only needs to exist when a user has
// explicitly diverged from the default in either direction (opted into a
// channel that isn't on by default, or opted out of one that is). See
// NotificationPreferenceService.resolveEnabledChannels.
model NotificationPreference {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  eventType String              @map("event_type")
  channel   NotificationChannel
  enabled   Boolean
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, eventType, channel])
  @@index([tenantId, userId])
  @@map("notification_preferences")
}

// A versioned, system-owned notification copy template for one
// `(eventType, channel, locale)` — the SAME "global reference data,
// seeded, versioned, `isActive`" shape as `CountryPack` (0.5), for the
// same reason: this is vendor-authored copy, not per-tenant data, and
// deliberately NOT tenant-scoped (no `tenantId` column) and therefore NOT
// subject to Row-Level Security, the same exemption reasoning as
// `Tenant`/`TenantDomain`/`CountryPack`. `subject` is only meaningful for
// channels that have one (EMAIL); null for IN_APP/SMS/PUSH. `body`
// contains `{{placeholder}}` tokens substituted from the triggering
// event's payload by NotificationTemplateRenderer — this is what
// satisfies "externalize all template strings": no notification copy is
// ever hardcoded into `apps/api` service code, it all lives here (seeded
// from `packages/db/src/seed-notification-templates.ts`, the same
// seeded-but-DB-stored pattern `seed-country-packs.ts` already
// established). Writable only through the owner/admin role today, same as
// `CountryPack` — a real admin-editable UI is later work.
model NotificationTemplate {
  id        String              @id @default(uuid()) @db.Uuid
  eventType String              @map("event_type")
  channel   NotificationChannel
  // BCP-47 language tag, e.g. "en", "ar" — matches CountryPack locale's
  // `defaultLanguage` / `User.preferredLanguage`.
  locale    String
  version   Int                 @default(1)
  isActive  Boolean             @default(true) @map("is_active")
  subject   String?
  body      String
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@unique([eventType, channel, locale, version])
  @@index([eventType, channel, locale, isActive])
  @@map("notification_templates")
}

// ---------------------------------------------------------------------------
// Audit log (step 0.9). Append-only, immutable record of sensitive actions
// across the whole system — fed by two sources: (1) `AuditInterceptor`
// (`apps/api/src/audit`), wrapping specific HTTP mutations, and (2) a
// consolidated domain-event listener replacing the placeholder loggers
// `auth`/`licensing`/`workflow`'s own listeners used to be (see
// /CLAUDE.md § Conventions → Audit log for the full write-up). Tenant-scoped,
// ordinary RLS applies for reads/inserts — but UNLIKE every other
// tenant-scoped table, `hrm_app` is granted NO `UPDATE`/`DELETE` at all (see
// the `enable_rls_and_immutability_for_audit_log` migration): immutability
// is enforced at the database layer, not just by this table having no
// update/delete application code path.
//
// PARTITIONED since Phase 5.2 (`PARTITION BY RANGE (occurred_at)`, monthly —
// see docs/conventions/partitioning-archival.md): primary key is the
// COMPOSITE `(id, occurredAt)`, per the note above the `Tenant` model —
// Postgres requires the partition key to be part of every unique
// constraint/PK on a partitioned table, which is exactly why this shape was
// chosen back in 0.9 so the Phase 5.2 `PARTITION BY RANGE` migration landed
// additively, not as a breaking PK change. `action`/`entityType` are
// free-form strings, not enums — same
// reasoning as `WorkflowInstance.entityType`/`Notification.eventType`: a
// closed catalog here would mean a migration for every new audited action.
model AuditLog {
  id            String   @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  occurredAt    DateTime @default(now()) @map("occurred_at")
  // Null when the action was system/platform-initiated (no authenticated
  // user in the request context) — same "nullable system actor" convention
  // as WorkflowAction.actorUserId for ESCALATE/AUTO_APPROVE.
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  // True when the action came through an unauthenticated @PlatformRoute()
  // (see /CLAUDE.md § Conventions → Platform context) — there is no
  // per-user actor to attach in that case, only "this was a platform
  // operation".
  actorPlatform Boolean  @default(false) @map("actor_platform")
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  // Redacted (see @hrm/shared's `redactAuditPayload`) before ever reaching
  // this column — secrets (passwords, tokens, signed license material)
  // must never appear here even transiently within one transaction.
  before        Json?
  after         Json?
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([id, occurredAt])
  @@index([tenantId, occurredAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorUserId])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Custom fields (step 0.9). Lets a tenant extend a core entity with its own
// typed fields WITHOUT a schema migration — see /CLAUDE.md § Conventions →
// Custom fields. `entityType` is a free-form string (e.g. the future
// "Employee"), the SAME polymorphic-by-string pattern `WorkflowInstance`/
// `Notification` already use, for the same reason: a closed catalog here
// would mean a migration every time a new entity becomes custom-field-aware.
// Both tables are tenant-scoped, ordinary RLS applies.
// ---------------------------------------------------------------------------

enum CustomFieldType {
  STRING
  NUMBER
  DATE
  BOOLEAN
  ENUM
}

// A tenant-defined field on one entity type — e.g. "Employee" /
// "shirt_size" / ENUM / ["S","M","L","XL"]. Validated against
// `@hrm/shared`'s `customFieldDefinitionSchema` on every write, same "JSON
// column has no schema-level guarantee of its own" posture as every other
// JSON-configured feature in this codebase (Country Pack config, workflow
// approver rules, ...).
model CustomFieldDefinition {
  id         String          @id @default(uuid()) @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  entityType String          @map("entity_type")
  fieldKey   String          @map("field_key")
  label      String
  fieldType  CustomFieldType @map("field_type")
  isRequired Boolean         @default(false) @map("is_required")
  // Allowed values, ENUM fields only (validated as a non-empty string[] at
  // the app layer); null/ignored for every other fieldType.
  options    Json?
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, entityType, fieldKey])
  @@index([tenantId, entityType])
  @@map("custom_field_definitions")
}

// One row per (entityType, entityId) holding ALL of that entity's custom
// field values as a single JSONB map (`{ [fieldKey]: value }`) — simpler and
// sufficiently scalable for this step vs. one row per field per entity, and
// mirrors "typed... with a JSONB storage approach" from this step's brief.
// Every write is re-validated against the entity type's current
// `CustomFieldDefinition` rows (type-checked per field, required fields
// present, ENUM values within `options`) — see
// `CustomFieldValueService.setValues`.
model CustomFieldValueSet {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  values     Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entityType, entityId])
  @@index([tenantId, entityType])
  @@map("custom_field_value_sets")
}

// ---------------------------------------------------------------------------
// Employee (step 1.1, Phase 1). The core HR entity every future Phase 1+
// module (leave, attendance, payroll, performance, ESS/MSS) references. See
// /CLAUDE.md's docs index -> docs/conventions/employee.md for the full
// write-up: encryption approach, country-driven required fields, the
// custom-fields/audit/field-level-permission integrations, org chart, and
// how this model feeds 0.7's approver-rule seams.
// ---------------------------------------------------------------------------

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

// The core HR entity. Tenant-scoped, ordinary RLS applies, same pattern as
// every other tenant-owned table. `userId` is a NULLABLE, per-tenant-unique
// one-to-one link to `User` — an employee doesn't strictly need a login
// account (e.g. freshly bulk-imported, not yet provisioned), so this is
// optional rather than required.
//
// `managerId` is a composite self-relation (same pattern as
// Branch.parentBranchId/Department.parentDepartmentId — see
// docs/conventions/tenancy-rls.md) and is now the REAL org-chart data source
// the workflow engine's MANAGER approver rule was seam-built for in 0.7 (see
// User.managerId's own doc comment, and
// apps/api/src/workflow/approver-resolver.service.ts, which now resolves
// MANAGER/BRANCH_HEAD/DEPARTMENT_HEAD through this table first, falling back
// to the legacy User.managerId/UserBranch seams only for a requester with no
// Employee record at all).
//
// `statutoryFields` is a `{ [fieldKey]: string }` JSON map giving concrete
// meaning to Country Pack `requiredEmployeeFields`' opaque keys (0.5's doc
// comment there explicitly deferred this to "the future employee-fields
// module" — this is that module). Validated at the application layer against
// the effective Country Pack resolved for the employee's `branchId` — see
// EmployeeService.
//
// `bankAccountNumberEncrypted`/`bankRoutingCodeEncrypted` and
// `baseSalaryEncrypted` are ENCRYPTED AT REST (application-level AES-256-GCM
// via EncryptionService, apps/api/src/common/encryption) — never stored
// plaintext. `baseSalaryEncrypted` is ADDITIONALLY field-level gated behind
// `salary.view` at the API/DTO layer (see
// docs/conventions/field-level-permissions.md) — encryption-at-rest and
// field-level omission are two independent, stacked controls, consistent
// with this project's "no single layer of security is trusted alone"
// posture (see docs/conventions/tenancy-rls.md).
model Employee {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  employeeCode String  @map("employee_code")
  userId       String? @map("user_id") @db.Uuid

  // Identity + personal.
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  personalEmail String?   @map("personal_email")
  phone         String?
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  gender        Gender?

  // Job.
  branchId       String         @map("branch_id") @db.Uuid
  departmentId   String?        @map("department_id") @db.Uuid
  designationId  String?        @map("designation_id") @db.Uuid
  employmentType EmploymentType @map("employment_type")
  joinDate       DateTime       @map("join_date") @db.Date
  status         EmployeeStatus @default(ACTIVE)
  // Set by EmployeeService.update the moment `status` transitions INTO
  // TERMINATED (cleared back to null on a reactivation) — a small,
  // additive capture column (step 1.5, Analytics dashboard) in the same
  // "nullable seam column" spirit as Branch.geofenceLat/User.pushToken.
  // Without a real termination DATE, leaver/attrition KPIs are
  // undecidable — leave.md already documents this exact absence as an
  // accepted gap; this is its narrow, capture-only fix. See
  // docs/conventions/analytics-dashboard.md.
  terminatedAt   DateTime?      @map("terminated_at")
  managerId      String?        @map("manager_id") @db.Uuid

  // Country-driven required statutory identifiers — see the model doc above.
  statutoryFields Json @default("{}") @map("statutory_fields")

  // Bank details — ENCRYPTED AT REST, no field-level gate (see the model doc
  // above for why salary gets one and bank details don't: only salary was
  // asked to be field-level protected).
  bankAccountNumberEncrypted String? @map("bank_account_number_encrypted")
  bankNameEncrypted          String? @map("bank_name_encrypted")
  bankRoutingCodeEncrypted   String? @map("bank_routing_code_encrypted")

  // Compensation — ENCRYPTED AT REST AND field-level gated (salary.view) at
  // the DTO layer.
  baseSalaryEncrypted String? @map("base_salary_encrypted")
  salaryCurrency      String? @map("salary_currency") @db.VarChar(3)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: SetNull)
  branch      Branch       @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  department  Department?  @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: SetNull)
  designation Designation? @relation(fields: [tenantId, designationId], references: [tenantId, id], onDelete: SetNull)

  // Composite self-relation, same pattern as User.manager (0.7)/
  // Branch.parentBranch/Department.parentDepartment.
  manager       Employee?  @relation("EmployeeManager", fields: [tenantId, managerId], references: [tenantId, id], onDelete: SetNull)
  directReports Employee[] @relation("EmployeeManager")

  dependents                EmployeeDependent[]
  emergencyContacts         EmployeeEmergencyContact[]
  documents                 EmployeeDocument[]
  leaveBalances             LeaveBalance[]
  leaveRequests             LeaveRequest[]
  leaveAccrualRuns          LeaveAccrualRun[]
  rosterAssignments         RosterAssignment[]
  attendanceRecords         AttendanceRecord[]
  attendanceRegularizations AttendanceRegularization[]
  attendanceDailySummaries  AttendanceDailySummary[]
  payrollRunLines           PayrollRunLine[]
  goals                     Goal[]
  appraisals                Appraisal[]
  reviewAssignments         ReviewAssignment[]
  reviewsGiven              Review[]
  onboardingProcess         OnboardingProcess?
  offboardingProcesses      OffboardingProcess[]
  payrollFinalSettlements   PayrollRun[]               @relation("PayrollFinalSettlement")
  expenseClaims             ExpenseClaim[]
  assetAssignments          AssetAssignment[]
  tickets                   Ticket[]
  lmsEnrollments            Enrollment[]
  lmsQuizAttempts           QuizAttempt[]
  lmsCertifications         Certification[]

  // Step 3.5.1 — data migration & onboarding toolkit (see
  // docs/conventions/data-migration.md).
  migratedAttendanceSummaries MigratedAttendanceSummary[]
  migratedPayslipRecords      MigratedPayslipRecord[]

  // Step 3.5.2 — Benefits administration (see docs/conventions/benefits.md).
  benefitEnrollments         BenefitEnrollment[]
  benefitContributionRecords BenefitContributionRecord[]

  // Lets other tenant-scoped tables (future Attendance/Payroll) define
  // a composite FK of (tenantId, employeeId) -> (tenantId, id) against this
  // table, same pattern as every other entity in this schema.
  @@unique([tenantId, id])
  @@unique([tenantId, employeeCode])
  @@unique([tenantId, userId])
  @@index([tenantId, branchId])
  @@index([tenantId, departmentId])
  @@index([tenantId, managerId])
  @@index([tenantId, status])
  @@map("employees")
}

// One dependent per row — full-replace on every Employee create/update (see
// EmployeeService), same "PUT replaces the whole resource" contract used
// throughout this codebase for tenant-editable collections.
model EmployeeDependent {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  name         String
  relationship String
  dateOfBirth  DateTime? @map("date_of_birth") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)

  // Step 3.5.2 — a dependent may be covered under one or more benefit
  // enrollments (e.g. an EMPLOYEE_FAMILY tier). See
  // docs/conventions/benefits.md.
  benefitEnrollmentDependents BenefitEnrollmentDependent[]

  @@unique([tenantId, id])
  @@index([tenantId, employeeId])
  @@map("employee_dependents")
}

// One emergency contact per row — same full-replace contract as
// EmployeeDependent above.
model EmployeeEmergencyContact {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  name         String
  relationship String
  phone        String
  createdAt    DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@map("employee_emergency_contacts")
}

enum EmployeeDocumentType {
  ID_PROOF
  VISA
  CONTRACT
  CERTIFICATE
  OTHER
}

// Document METADATA only — the file bytes live in S3/MinIO
// (apps/api/src/storage), addressed by `storageKey`. Reuses the existing
// S3_* env config (documented since 0.1, unused until this step).
model EmployeeDocument {
  id               String               @id @default(uuid()) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  employeeId       String               @map("employee_id") @db.Uuid
  documentType     EmployeeDocumentType @map("document_type")
  fileName         String               @map("file_name")
  mimeType         String               @map("mime_type")
  sizeBytes        Int                  @map("size_bytes")
  storageKey       String               @map("storage_key")
  uploadedByUserId String?              @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@map("employee_documents")
}

enum EmployeeImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

// Tracks one bulk CSV import request end to end — the async BullMQ pattern
// established in 0.8 (see docs/conventions/notifications-queues.md), reused
// as-is: `POST /employees/import` creates this row PENDING and enqueues one
// job carrying just `{ tenantId, importJobId }`; the worker
// (EmployeeImportProcessor) reloads `csvContent` fresh from this row (not
// from job data — same "job data stays minimal, everything else reloaded
// from the DB so a retried job sees current state" posture 0.8 established),
// processes rows with per-row validation, and writes `errors`/counts back as
// it goes so a client can poll `GET /employees/import/:jobId` for progress
// without ever blocking the request that kicked off the import.
model EmployeeImportJob {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  submittedByUserId String?              @map("submitted_by_user_id") @db.Uuid
  status            EmployeeImportStatus @default(PENDING)
  csvContent        String               @map("csv_content") @db.Text
  totalRows         Int                  @default(0) @map("total_rows")
  processedRows     Int                  @default(0) @map("processed_rows")
  successCount      Int                  @default(0) @map("success_count")
  errorCount        Int                  @default(0) @map("error_count")
  // [{ row: number, message: string }]
  errors            Json                 @default("[]")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("employee_import_jobs")
}

// ---------------------------------------------------------------------------
// Leave management (step 1.2, Phase 1). Consumes four Phase 0/1 systems
// rather than reimplementing any of them — see docs/conventions/leave.md:
// Country Packs (0.5) for entitlements/holidays/weekends, the workflow
// engine (0.7) for approval (a leave request just starts a WorkflowInstance
// with entityType "LeaveRequest" — there is no bespoke approve/reject logic
// here), the Employee/manager relation (1.1) for approver resolution (free,
// via 0.7's already-updated MANAGER resolver), and the 0.8 BullMQ queue
// pattern for scheduled accrual.
// ---------------------------------------------------------------------------

// A CLOSED, code-level catalog — NOT a free-form-string `entityType` like
// `WorkflowInstance`/`CustomFieldDefinition` — because it mirrors the four
// fixed keys `CountryPackConfig.leaveDefaults` already commits to
// (annualDays/sickDays/maternityDays/paternityDays). The ENTITLEMENT amount
// for each type is fully country/tenant-pack-driven (see
// LeaveEntitlementService); only the catalog of TYPES itself is fixed, the
// same "some things ARE a fixed, closed set" exception `CustomFieldType`
// already takes to this codebase's usual free-form-string convention.
enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

// One row per (employee, leaveType, calendar year) — tenant-scoped, ordinary
// RLS. `entitledDays` is a SNAPSHOT of the effective Country Pack (+ tenant
// override) entitlement resolved when this row was first created — see
// LeaveEntitlementService; it is not re-resolved on every read, so a
// mid-year override change does not retroactively rewrite an employee's
// already-running balance for that year (a deliberate, documented choice —
// see docs/conventions/leave.md). `accruedDays` is built up incrementally by
// the scheduled accrual job (LeaveAccrualService); `usedDays` is
// incremented/decremented only by the LeaveRequest workflow-event listener,
// never directly by a client. Available balance = accruedDays +
// carriedOverDays - usedDays, computed at read time, not stored.
model LeaveBalance {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  employeeId      String    @map("employee_id") @db.Uuid
  leaveType       LeaveType @map("leave_type")
  periodYear      Int       @map("period_year")
  entitledDays    Float     @map("entitled_days")
  accruedDays     Float     @default(0) @map("accrued_days")
  carriedOverDays Float     @default(0) @map("carried_over_days")
  usedDays        Float     @default(0) @map("used_days")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, employeeId, leaveType, periodYear])
  @@index([tenantId, employeeId])
  @@map("leave_balances")
}

// One employee's request for one contiguous date range of one leave type.
// `days` is the resolved business-day count (weekends + that branch's public
// holidays excluded — see LeaveDayCalculator), computed once at submission,
// same "frozen snapshot" posture `WorkflowInstance.dataSnapshot` already
// takes elsewhere in this schema. `workflowInstanceId` is a plain UUID
// reference (no FK relation) to the `WorkflowInstance` this request started
// — the SAME "just an id, not a structural relation" pattern
// `WorkflowInstanceStep.delegatedToUserId`/`escalatedToUserId` already use,
// consistent with the workflow engine's own polymorphic, FK-free
// `entityType`/`entityId` design (this table IS what `entityId` points at).
// `balanceApplied` guards the workflow-event listener against double-
// deducting/double-restoring the balance if a `workflow.approved`/
// `workflow.rejected`/`workflow.canceled` event were ever (re)delivered more
// than once.
model LeaveRequest {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  employeeId         String             @map("employee_id") @db.Uuid
  leaveType          LeaveType          @map("leave_type")
  startDate          DateTime           @map("start_date") @db.Date
  endDate            DateTime           @map("end_date") @db.Date
  days               Float
  reason             String?
  status             LeaveRequestStatus @default(PENDING)
  workflowInstanceId String?            @map("workflow_instance_id") @db.Uuid
  submittedByUserId  String?            @map("submitted_by_user_id") @db.Uuid
  balanceApplied     Boolean            @default(false) @map("balance_applied")
  decidedAt          DateTime?          @map("decided_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)

  // Lets a future module (payroll, ...) define a composite FK of
  // (tenantId, id) -> this table, same pattern as every other entity here.
  @@unique([tenantId, id])
  @@index([tenantId, employeeId, status])
  @@index([tenantId, startDate, endDate])
  @@map("leave_requests")
}

// One row per (employee, leaveType, calendar month) the scheduled accrual
// job has successfully processed — this table IS the idempotency record for
// accrual, alongside (defense-in-depth, not instead of) the Redis-backed
// `IdempotencyService` the accrual worker also wraps each employee's run
// with (see docs/conventions/leave.md and docs/conventions/resilience.md).
// The `@@unique` constraint below is what makes a re-run of the same period
// for the same employee a safe no-op at the DATABASE layer even if the
// Redis-layer guard were somehow bypassed.
model LeaveAccrualRun {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  leaveType      LeaveType @map("leave_type")
  periodYear     Int       @map("period_year")
  periodMonth    Int       @map("period_month")
  accruedAmount  Float     @map("accrued_amount")
  proratedFactor Float     @default(1) @map("prorated_factor")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, employeeId, leaveType, periodYear, periodMonth])
  @@index([tenantId, periodYear, periodMonth])
  @@map("leave_accrual_runs")
}

// ---------------------------------------------------------------------------
// Attendance & time-tracking (step 1.3, Phase 1). The first HIGH-VOLUME
// module — every employee generates a row here daily, so `AttendanceRecord`
// was built PARTITION-READY from day one, exactly the shape flagged since 0.2
// (see the comment block above the `Tenant` model), and is actually
// `PARTITION BY RANGE (work_date)` since Phase 5.2 — see
// docs/conventions/tenancy-rls.md and
// docs/conventions/partitioning-archival.md. Consumes, rather than reimplements:
// Country Packs (0.5) for weekend/holiday/overtime rules, the Employee/
// manager relation (1.1) for approver resolution, the workflow engine (0.7)
// for regularization approval, and the 0.8 BullMQ pattern for the
// summary-computation job. See docs/conventions/attendance.md.
// ---------------------------------------------------------------------------

enum AttendanceSource {
  WEB
  MOBILE
  BIOMETRIC
  MANUAL
}

enum AttendanceRecordStatus {
  OPEN
  CLOSED
}

// A tenant-defined shift (e.g. "Night Shift", 22:00-06:00 branch-local).
// `startTime`/`endTime` are "HH:mm" branch-local wall-clock strings, NOT
// timestamps — a shift definition has no date of its own, only a roster
// assignment does. `crossesMidnight` (startTime >= endTime) is DENORMALIZED
// here (computed once at write time by ShiftsService, not re-derived on
// every read) purely for query/documentation convenience; the actual
// day-attribution logic re-derives it from startTime/endTime directly where
// it matters (see docs/conventions/attendance.md).
model ShiftDefinition {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  name            String
  startTime       String   @map("start_time") @db.VarChar(5)
  endTime         String   @map("end_time") @db.VarChar(5)
  breakMinutes    Int      @default(0) @map("break_minutes")
  crossesMidnight Boolean  @default(false) @map("crosses_midnight")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rosterAssignments RosterAssignment[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("shift_definitions")
}

// Assigns one employee to one shift for a date range (`effectiveTo: null` =
// ongoing). Resolution (`ShiftResolutionService`) picks, for a given
// employee + branch-local calendar date, the assignment with the latest
// `effectiveFrom` whose range covers that date — the same "most specific/
// most recent wins" shape used nowhere else in this schema verbatim, but
// analogous to CountryPack's highest-version-active resolution (0.5).
model RosterAssignment {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  employeeId        String    @map("employee_id") @db.Uuid
  shiftDefinitionId String    @map("shift_definition_id") @db.Uuid
  effectiveFrom     DateTime  @map("effective_from") @db.Date
  effectiveTo       DateTime? @map("effective_to") @db.Date
  createdAt         DateTime  @default(now()) @map("created_at")

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee        Employee        @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)
  shiftDefinition ShiftDefinition @relation(fields: [tenantId, shiftDefinitionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, employeeId, effectiveFrom])
  @@map("roster_assignments")
}

// The high-volume clock-in/out record — see docs/conventions/attendance.md
// for the full write-up of the day-attribution algorithm. ONE row per shift
// (clock-in through clock-out), NOT one row per punch: a clock-out never
// creates a new row, it closes the caller's own OPEN row (found by
// `employeeId` + `status: OPEN`, enforced as an application-level
// "at most one open record per employee" invariant — no DB constraint
// expresses "unique among rows where status = OPEN" without a partial
// index, which Prisma's schema DSL cannot express; consistent with this
// codebase's existing acceptance of application-level invariants alongside
// DB constraints wherever the DSL can't reach, e.g. License's
// at-most-one-ACTIVE-per-tenant rule).
//
// `workDate` — the BRANCH-LOCAL working day this shift is attributed to —
// is resolved ONCE at clock-in (see `resolveWorkDate` in
// attendance-timezone.util.ts) and never recomputed at clock-out; this is
// what makes a shift crossing midnight attribute correctly to a single
// working day regardless of what local calendar date the clock-out happens
// on. It is also THE PARTITION KEY: the SAME shape `AuditLog` already
// established in 0.9 (composite PK `(id, workDate)`, since Postgres requires
// the partition key to be part of every unique constraint/PK on a
// partitioned table) — see the comment block above the `Tenant` model and
// docs/conventions/tenancy-rls.md. Actually `PARTITION BY RANGE (work_date)`
// since Phase 5.2 (`partition_high_growth_tables` migration) — landed
// additively, exactly as planned, with zero PK/column change. See
// docs/conventions/partitioning-archival.md.
//
// Deliberately has NO `@@unique([tenantId, id])` (unlike almost every other
// table in this schema) — adding one would violate the same Postgres
// partitioning rule the composite PK exists to satisfy (every unique
// constraint on a partitioned table must include the partition key), so
// nothing may define a composite FK INTO this table. `shiftDefinitionId`
// below is therefore a plain UUID SNAPSHOT column (no relation), the same
// "just an id, not a structural relation" pattern `WorkflowInstanceStep.
// delegatedToUserId`/`LeaveRequest.workflowInstanceId` already use — cheap
// to write (no extra FK check on the highest-volume table in this system)
// and correct as a point-in-time snapshot (a roster reassignment after the
// fact must never rewrite an already-clocked shift's history).
model AttendanceRecord {
  id         String   @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  workDate   DateTime @map("work_date") @db.Date

  // Snapshot of the roster-resolved shift at clock-in time, if any — see the
  // model doc above for why this is a plain column, not a relation.
  shiftDefinitionId String? @map("shift_definition_id") @db.Uuid

  clockInAt       DateTime         @map("clock_in_at")
  clockInSource   AttendanceSource @map("clock_in_source")
  clockInLat      Float?           @map("clock_in_lat")
  clockInLong     Float?           @map("clock_in_long")
  // StorageService/MinIO object key (see docs/conventions/employee.md's
  // identical convention for EmployeeDocument.storageKey) — the selfie
  // bytes never touch this table.
  clockInPhotoKey String?          @map("clock_in_photo_key")

  clockOutAt       DateTime?         @map("clock_out_at")
  clockOutSource   AttendanceSource? @map("clock_out_source")
  clockOutLat      Float?            @map("clock_out_lat")
  clockOutLong     Float?            @map("clock_out_long")
  clockOutPhotoKey String?           @map("clock_out_photo_key")

  status          AttendanceRecordStatus @default(OPEN)
  // Populated at clock-out. `overtimeMinutes`/`lateMinutes` are resolved
  // from the effective Country Pack's `workingTime.overtimeRules` and the
  // snapshotted shift's `startTime` respectively — see
  // docs/conventions/attendance.md; THE RULE (country-packs.md) still
  // holds, nothing here branches on a country code.
  workedMinutes   Int?                   @map("worked_minutes")
  overtimeMinutes Int                    @default(0) @map("overtime_minutes")
  lateMinutes     Int                    @default(0) @map("late_minutes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)
  branch   Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)

  @@id([id, workDate])
  @@index([tenantId, employeeId, workDate])
  @@index([tenantId, branchId, workDate])
  @@index([tenantId, employeeId, status])
  @@map("attendance_records")
}

enum AttendanceRegularizationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

// A missed/incorrect punch correction — REUSES the 0.7 workflow engine
// wholesale (THE RULE, workflow.md): this table owns no approve/reject
// logic of its own, exactly like `LeaveRequest`. `attendanceRecordId` is a
// plain UUID reference (nullable — null means "the employee has no record
// at all for `workDate`", i.e. a fully missed punch, not just a wrong one)
// with NO FK relation, for the SAME reason `AttendanceRecord` itself has no
// `@@unique([tenantId, id])` to be a composite-FK target of: its PK is the
// partition-compatible composite `(id, workDate)`. This table is itself
// ordinary (low-volume, NOT partitioned) — only the record it may point at
// is.
model AttendanceRegularization {
  id                  String                         @id @default(uuid()) @db.Uuid
  tenantId            String                         @map("tenant_id") @db.Uuid
  employeeId          String                         @map("employee_id") @db.Uuid
  attendanceRecordId  String?                        @map("attendance_record_id") @db.Uuid
  workDate            DateTime                       @map("work_date") @db.Date
  requestedClockInAt  DateTime?                      @map("requested_clock_in_at")
  requestedClockOutAt DateTime?                      @map("requested_clock_out_at")
  reason              String
  status              AttendanceRegularizationStatus @default(PENDING)
  workflowInstanceId  String?                        @map("workflow_instance_id") @db.Uuid
  submittedByUserId   String?                        @map("submitted_by_user_id") @db.Uuid
  decidedAt           DateTime?                      @map("decided_at")
  createdAt           DateTime                       @default(now()) @map("created_at")
  updatedAt           DateTime                       @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, employeeId, status])
  @@map("attendance_regularizations")
}

enum AttendanceDayStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
  WEEKEND
  HOLIDAY
}

// ONE row per (employee, workDate) — the precomputed reporting surface this
// module's brief requires ("heavy reads must not hammer the primary"):
// team/period reports read ONLY this table, never aggregate
// `AttendanceRecord` directly. Populated by `AttendanceSummaryProcessor`
// (the 0.8 BullMQ pattern, reused as-is), triggered per-employee/day
// fire-and-forget after every clock-out (cheap, bounded to one row) and by
// the manual `POST /attendance/summary/run` trigger for a broader
// backfill/recompute — the SAME documented, accepted "not wired to a real
// scheduler yet" tradeoff 0.7's escalation sweep and 1.2's accrual job
// already take. A plain `upsert` (no separate idempotency layer needed,
// unlike leave accrual's ADDITIVE accrual): this is a full RECOMPUTE of one
// day's totals, so re-running it for the same period is naturally
// idempotent — same inputs, same output, not a running total that could
// double-count.
model AttendanceDailySummary {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  employeeId      String              @map("employee_id") @db.Uuid
  branchId        String              @map("branch_id") @db.Uuid
  workDate        DateTime            @map("work_date") @db.Date
  status          AttendanceDayStatus
  workedMinutes   Int                 @default(0) @map("worked_minutes")
  overtimeMinutes Int                 @default(0) @map("overtime_minutes")
  lateMinutes     Int                 @default(0) @map("late_minutes")
  computedAt      DateTime            @default(now()) @map("computed_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)
  branch   Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, employeeId, workDate])
  @@index([tenantId, branchId, workDate])
  @@index([tenantId, workDate, status])
  @@map("attendance_daily_summaries")
}

// ---------------------------------------------------------------------------
// Analytics dashboard (step 1.5, Phase 1 finale). The whole point of this
// module — see docs/conventions/analytics-dashboard.md — is that a
// dashboard load is a cheap indexed read of PRE-AGGREGATED rows, never a
// live scan/GROUP BY over `employees`/`attendance_records`/`leave_requests`/
// `leave_balances`. All four tables below are computed by
// `AnalyticsRollupProcessor` (a real, scheduled BullMQ job — see
// apps/api/src/analytics), never written from an HTTP request path.
//
// `departmentId` is NULLABLE (an employee may have no department) — which
// matters a lot here, because Postgres treats every NULL as DISTINCT in a
// unique index. An upsert keyed on a unique constraint that includes this
// column would silently insert a fresh duplicate row on every job re-run
// for any "no department" combination, rather than updating the existing
// one. The fix, applied uniformly by every rollup job in this file: DELETE
// every existing row for the (tenantId, theDate) grain first, then one bulk
// `createMany` of the freshly computed rows, rather than a per-row upsert —
// the same "a full RECOMPUTE from source data is naturally idempotent"
// argument `AttendanceDailySummary`'s own doc comment already makes for
// itself, just applied as delete+bulk-insert (one job run produces MANY
// rows at once here) instead of a per-row upsert. The `@@unique` below
// documents the intended grain / gives defense-in-depth against a genuine
// application bug within one computation pass; it is NOT what the job
// relies on to stay idempotent across re-runs.
// ---------------------------------------------------------------------------

enum WorkforceMovementType {
  JOINER
  LEAVER
}

// One row per (tenant, snapshotDate, branchId, departmentId, employmentType,
// gender) — a point-in-time CROSS-SECTION of active headcount, not an
// additive daily delta. Querying a date RANGE means reading the single
// latest `snapshotDate` within that range (see AnalyticsDashboardService) —
// summing `activeCount` across multiple days would double-count the same
// people.
model HeadcountDailySnapshot {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  snapshotDate   DateTime       @map("snapshot_date") @db.Date
  branchId       String         @map("branch_id") @db.Uuid
  departmentId   String?        @map("department_id") @db.Uuid
  employmentType EmploymentType @map("employment_type")
  gender         Gender?
  activeCount    Int            @map("active_count")
  computedAt     DateTime       @default(now()) @map("computed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, snapshotDate, branchId, departmentId, employmentType, gender])
  @@index([tenantId, snapshotDate, branchId])
  @@map("headcount_daily_snapshots")
}

// One row per (tenant, movementDate, branchId, departmentId, movementType) —
// JOINER counts `Employee.joinDate = movementDate`; LEAVER counts
// `Employee.terminatedAt`'s calendar date `= movementDate`. Both grouped by
// the employee's CURRENT branch/department (this schema has no historical
// branch/department assignment log anywhere else either — a documented
// simplification, same spirit as attendance.md's un-rostered-employee gap).
// A date RANGE query SUMS `count` across days — each day's count is a
// distinct-day event count, unlike headcount above.
model WorkforceMovementDailyCount {
  id           String                @id @default(uuid()) @db.Uuid
  tenantId     String                @map("tenant_id") @db.Uuid
  movementDate DateTime              @map("movement_date") @db.Date
  branchId     String                @map("branch_id") @db.Uuid
  departmentId String?               @map("department_id") @db.Uuid
  movementType WorkforceMovementType @map("movement_type")
  count        Int
  computedAt   DateTime              @default(now()) @map("computed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, movementDate, branchId, departmentId, movementType])
  @@index([tenantId, movementDate, branchId])
  @@map("workforce_movement_daily_counts")
}

// One row per (tenant, workDate, branchId, departmentId) — a ROLLUP OF A
// ROLLUP: computed by grouping 1.3's own `AttendanceDailySummary` (already
// at most one row per employee per day) by (branchId, departmentId,
// status), joined to `Employee` only for `departmentId` (which
// `AttendanceDailySummary` doesn't carry) — this job never touches
// `AttendanceRecord` itself. `employeeCount` is the denominator for rate
// calculations (e.g. attendance rate = presentCount / employeeCount).
model AttendanceDailyBranchSummary {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  workDate             DateTime @map("work_date") @db.Date
  branchId             String   @map("branch_id") @db.Uuid
  departmentId         String?  @map("department_id") @db.Uuid
  presentCount         Int      @default(0) @map("present_count")
  absentCount          Int      @default(0) @map("absent_count")
  lateCount            Int      @default(0) @map("late_count")
  onLeaveCount         Int      @default(0) @map("on_leave_count")
  weekendCount         Int      @default(0) @map("weekend_count")
  holidayCount         Int      @default(0) @map("holiday_count")
  totalWorkedMinutes   Int      @default(0) @map("total_worked_minutes")
  totalOvertimeMinutes Int      @default(0) @map("total_overtime_minutes")
  totalLateMinutes     Int      @default(0) @map("total_late_minutes")
  employeeCount        Int      @default(0) @map("employee_count")
  computedAt           DateTime @default(now()) @map("computed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, workDate, branchId, departmentId])
  @@index([tenantId, workDate, branchId])
  @@map("attendance_daily_branch_summaries")
}

// One row per (tenant, snapshotDate, branchId, departmentId, leaveType) —
// computed by grouping the CURRENT-YEAR `LeaveBalance` rows (already at
// most one row per employee/type/year) joined to `Employee` for branch/
// department. `totalUsedDays` is CUMULATIVE for the year, same as the
// `LeaveBalance` row it's summed from — reading "utilization within
// [from, to]" means diffing the latest snapshot on/before `to` against the
// latest on/before `from` (see AnalyticsDashboardService), not summing
// this table across days.
model LeaveUtilizationDailySnapshot {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  snapshotDate      DateTime  @map("snapshot_date") @db.Date
  branchId          String    @map("branch_id") @db.Uuid
  departmentId      String?   @map("department_id") @db.Uuid
  leaveType         LeaveType @map("leave_type")
  totalEntitledDays Float     @default(0) @map("total_entitled_days")
  totalAccruedDays  Float     @default(0) @map("total_accrued_days")
  totalUsedDays     Float     @default(0) @map("total_used_days")
  employeeCount     Int       @default(0) @map("employee_count")
  computedAt        DateTime  @default(now()) @map("computed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, snapshotDate, branchId, departmentId, leaveType])
  @@index([tenantId, snapshotDate, branchId])
  @@map("leave_utilization_daily_snapshots")
}

// ---------------------------------------------------------------------------
// Payroll (step 2.1, Phase 2's first step). THE HIGHEST-RISK MODULE — see
// docs/conventions/payroll.md for the full write-up. The one hard rule this
// entire schema exists to serve: mandatory tax/statutory deductions are
// NEVER modeled here — they come straight from the resolved CountryPack's
// `tax.layers`/`statutory.components` (0.5), computed by the EXISTING,
// UNMODIFIED `computeMultiLayerTax`/`computeStatutoryComponents`. Every
// table below is either (a) payroll's own additive SALARY-STRUCTURE concept
// (earnings/allowances/discretionary deductions — never a substitute for
// pack-driven tax/statutory), or (b) run/execution bookkeeping. Money is
// ALWAYS `Decimal`, never `Float` — see payroll.md's money-representation
// note.
// ---------------------------------------------------------------------------

enum PayrollComponentType {
  EARNING
  ALLOWANCE
  DEDUCTION
}

enum PayrollComponentCalcKind {
  FIXED_AMOUNT
  PERCENTAGE_OF_BASE
  FORMULA
}

// One tenant's salary-structure line item for one country — EARNING/
// ALLOWANCE/discretionary DEDUCTION only (mandatory tax/statutory
// deductions are NEVER modeled here, see the header comment above).
// `formula` (only meaningful when `calcKind: FORMULA`) is validated against
// 0.5's own `exprSchema` at every write AND read — the SAME closed AST,
// imported not redefined (see
// packages/shared/src/validators/payroll.validator.ts) — and may reference
// ONLY `basicSalary`/`yearsOfService` (not `grossSalary`/`monthlySalary`/
// `annualSalary`, which the engine only knows AFTER every component sums
// up — a documented evaluation-order rule enforced by
// `PayrollEngineService`, not by this schema). `percentageOfBase` is a
// plain string (one of 0.5's `SALARY_BASES`) rather than a second Prisma
// enum that would need to stay byte-for-byte in sync with that TS union —
// validated by `createPayrollComponentSchema`, the same "opaque
// string, meaning enforced by the validator" posture
// `Employee.statutoryFields`' keys already take.
model PayrollComponentDefinition {
  id               String                   @id @default(uuid()) @db.Uuid
  tenantId         String                   @map("tenant_id") @db.Uuid
  countryCode      String                   @map("country_code") @db.VarChar(2)
  key              String
  name             String
  type             PayrollComponentType
  calcKind         PayrollComponentCalcKind @map("calc_kind")
  fixedAmount      Decimal?                 @map("fixed_amount") @db.Decimal(14, 2)
  percentageOfBase String?                  @map("percentage_of_base")
  percentageRate   Float?                   @map("percentage_rate")
  formula          Json?
  order            Int                      @default(0)
  isActive         Boolean                  @default(true) @map("is_active")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, countryCode, key])
  @@index([tenantId, countryCode, isActive])
  @@map("payroll_component_definitions")
}

// Global reference data, deliberately RLS-EXEMPT — the SAME posture
// `CountryPack` already takes (see docs/conventions/tenancy-rls.md):
// exchange rates are objective market data, not tenant-owned. `hrm_app` is
// granted SELECT only; writable today only through the owner role
// (seeding) — a real rate-provider integration is future work, tracked as
// a documented seam in payroll.md, not built this step.
model ExchangeRate {
  id            String   @id @default(uuid()) @db.Uuid
  baseCurrency  String   @map("base_currency") @db.VarChar(3)
  quoteCurrency String   @map("quote_currency") @db.VarChar(3)
  // 1 unit of baseCurrency = `rate` units of quoteCurrency.
  rate          Decimal  @db.Decimal(18, 8)
  asOfDate      DateTime @map("as_of_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([baseCurrency, quoteCurrency, asOfDate])
  @@index([baseCurrency, quoteCurrency, asOfDate])
  @@map("exchange_rates")
}

enum PayrollRunStatus {
  DRAFT
  CALCULATED
  APPROVED
  FINALIZED
  PAID
}

// `REGULAR` (the only kind before step 2.3) vs `FINAL_SETTLEMENT` — the ONE
// additive seam Offboarding (2.3) needed from Payroll's ORCHESTRATION layer
// (see docs/conventions/recruitment-lifecycle.md); `PayrollEngineService`'s
// tax/statutory calculation code is completely untouched by this — see the
// `settlementEmployeeId` note below for exactly what changed and why.
enum PayrollRunType {
  REGULAR
  FINAL_SETTLEMENT
}

// One row per (tenant, branch, period) for a `REGULAR` run — the run-level
// idempotency anchor. `payrollMode` is SNAPSHOTTED from the resolved
// CountryPack at run creation (CALCULATE vs. DELEGATE — see
// docs/conventions/payroll.md) so a later pack edit never changes how an
// in-flight or historical run was actually processed. `workflowInstanceId`
// is a plain id, no FK relation — the SAME polymorphic "just an id"
// pattern `LeaveRequest.workflowInstanceId` already establishes (THE RULE:
// approval is the generic 0.7 workflow engine, this module owns no
// approve/reject logic of its own). `exchangeRateToBase`/`totalGrossBase`/
// `totalNetBase` are snapshotted once at calculation time, never
// re-resolved later — the same "snapshot, don't re-derive" posture
// `LeaveBalance.entitledDays` already takes, so a later exchange-rate
// update never retroactively rewrites a past run's reported totals.
//
// `runType`/`settlementEmployeeId` (step 2.3, additive) let Offboarding
// trigger exactly ONE MORE run for an employee who has already left
// `ACTIVE` status (and so would otherwise never appear in any future
// REGULAR run's employee-selection query again) — see
// `PayrollRunProcessor.process`, the ONLY other file this seam touches.
// `PayrollEngineService.computeForEmployee` itself is called EXACTLY as it
// always was, unmodified: a FINAL_SETTLEMENT run computes that period's
// ordinary incremental result (including, for a country like Qatar, that
// period's incremental `TIERED_BY_YEARS_OF_SERVICE` gratuity delta) — see
// docs/conventions/recruitment-lifecycle.md for the honest, documented
// limitation this implies (no cumulative lump-sum gratuity payout; solving
// that correctly would mean touching the engine itself, explicitly out of
// this step's scope).
//
// The ORIGINAL blanket `@@unique([tenantId, branchId, periodYear,
// periodMonth])` could not simply gain a nullable `settlementEmployeeId`
// column to its key — Postgres treats every `NULL` as DISTINCT in a unique
// index, which would have SILENTLY WEAKENED the existing REGULAR-run
// idempotency guarantee (multiple REGULAR runs, all with
// `settlementEmployeeId IS NULL`, would stop colliding against each
// other). Instead, TWO hand-written PARTIAL unique indexes (Prisma has no
// partial-index DSL, the same "hand-written SQL" posture RLS itself
// already takes — see docs/conventions/tenancy-rls.md) replace it exactly:
// one scoped `WHERE run_type = 'REGULAR'` (byte-identical to the original
// constraint), one scoped `WHERE run_type = 'FINAL_SETTLEMENT'` (one
// settlement run per employee per period) — see the
// `add_payroll_final_settlement_seam` migration.
model PayrollRun {
  id                   String           @id @default(uuid()) @db.Uuid
  tenantId             String           @map("tenant_id") @db.Uuid
  branchId             String           @map("branch_id") @db.Uuid
  periodYear           Int              @map("period_year")
  periodMonth          Int              @map("period_month")
  status               PayrollRunStatus @default(DRAFT)
  runType              PayrollRunType   @default(REGULAR) @map("run_type")
  settlementEmployeeId String?          @map("settlement_employee_id") @db.Uuid
  payrollMode          String           @map("payroll_mode") @db.VarChar(16)
  workflowInstanceId   String?          @map("workflow_instance_id") @db.Uuid
  // Additive seam column, step 3.3 — formalizes the bank-export adapter
  // (docs/conventions/payroll.md's single-CSV-format gap) into a genuinely
  // PLUGGABLE choice: null (the default, every pre-3.3 run) resolves the
  // same GenericCsvBankExportAdapter as before via BankExportAdapterRegistry
  // — zero behavior change for existing runs/tests. A non-null value picks
  // a different registered adapter by its own `format` key. Never read by
  // PayrollEngineService/the tax-and-statutory engine — bank export is
  // orchestration/formatting only. See docs/conventions/integrations.md.
  bankExportFormat     String?          @map("bank_export_format") @db.VarChar(32)
  currencyCode         String           @map("currency_code") @db.VarChar(3)
  exchangeRateToBase   Decimal?         @map("exchange_rate_to_base") @db.Decimal(18, 8)
  totalGross           Decimal          @default(0) @map("total_gross") @db.Decimal(14, 2)
  totalNet             Decimal          @default(0) @map("total_net") @db.Decimal(14, 2)
  totalEmployerCost    Decimal          @default(0) @map("total_employer_cost") @db.Decimal(14, 2)
  totalGrossBase       Decimal?         @map("total_gross_base") @db.Decimal(14, 2)
  totalNetBase         Decimal?         @map("total_net_base") @db.Decimal(14, 2)
  createdByUserId      String?          @map("created_by_user_id") @db.Uuid
  approvedAt           DateTime?        @map("approved_at")
  finalizedAt          DateTime?        @map("finalized_at")
  paidAt               DateTime?        @map("paid_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch              @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  settlementEmployee Employee?           @relation("PayrollFinalSettlement", fields: [tenantId, settlementEmployeeId], references: [tenantId, id], onDelete: Cascade)
  lines              PayrollRunLine[]
  bankExports        PayrollBankExport[]

  // Lets PayrollRunLine/PayrollBankExport define a composite FK of
  // (tenantId, id) -> this table, same pattern as every other entity here.
  // NOTE: the REGULAR-run uniqueness on (tenantId, branchId, periodYear,
  // periodMonth) and the FINAL_SETTLEMENT-run uniqueness on (tenantId,
  // settlementEmployeeId, periodYear, periodMonth) are both hand-written
  // PARTIAL unique indexes in the `add_payroll_final_settlement_seam`
  // migration, not expressible as a Prisma `@@unique` — see the model doc
  // comment above.
  @@unique([tenantId, id])
  @@index([tenantId, branchId, periodYear, periodMonth])
  @@index([tenantId, settlementEmployeeId])
  @@map("payroll_runs")
}

enum PayrollRunLineStatus {
  PENDING
  COMPUTED
  FAILED
}

enum PayrollComputedVia {
  ENGINE
  DELEGATE
}

// One row per (run, employee) — THE resumability + idempotency unit.
// `@@unique([tenantId, payrollRunId, employeeId])` is the DB-level backstop
// requested "on (tenant, branch, period, employee)": since `PayrollRun`
// already carries its own `@@unique([tenantId, branchId, periodYear,
// periodMonth])`, a line's `(tenantId, payrollRunId, employeeId)`
// uniqueness transitively provides exactly that guarantee one level down
// — see docs/conventions/payroll.md for the explicit equivalence note.
// `PayrollRunProcessor` uses THIS table's own `status` to resume a
// partially-failed run: any employee already `COMPUTED` is skipped on a
// re-run, never reprocessed.
model PayrollRunLine {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  payrollRunId       String               @map("payroll_run_id") @db.Uuid
  employeeId         String               @map("employee_id") @db.Uuid
  branchId           String               @map("branch_id") @db.Uuid
  status             PayrollRunLineStatus @default(PENDING)
  computedVia        PayrollComputedVia?  @map("computed_via")
  grossPay           Decimal?             @map("gross_pay") @db.Decimal(14, 2)
  netPay             Decimal?             @map("net_pay") @db.Decimal(14, 2)
  employerCost       Decimal?             @map("employer_cost") @db.Decimal(14, 2)
  // Ordered `{ key, label, type, amount }[]` mirroring the resolved pack's
  // own `payslipTemplate.lineItems` keys, so the payslip renderer maps
  // directly with no per-country branching.
  componentBreakdown Json?                @map("component_breakdown")
  errorMessage       String?              @map("error_message")
  computedAt         DateTime?            @map("computed_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRun PayrollRun       @relation(fields: [tenantId, payrollRunId], references: [tenantId, id], onDelete: Cascade)
  employee   Employee         @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)
  branch     Branch           @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  payslip    PayslipDocument?

  @@unique([tenantId, id])
  @@unique([tenantId, payrollRunId, employeeId])
  @@index([tenantId, payrollRunId, status])
  @@index([tenantId, employeeId])
  @@map("payroll_run_lines")
}

// One generated payslip PDF per run line — metadata in Postgres, bytes in
// S3/MinIO via 1.1's `StorageService`, the SAME "metadata here, bytes
// there" pattern `EmployeeDocument` already established.
model PayslipDocument {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  payrollRunLineId String   @map("payroll_run_line_id") @db.Uuid
  storageKey       String   @map("storage_key")
  language         String   @db.VarChar(8)
  generatedAt      DateTime @default(now()) @map("generated_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRunLine PayrollRunLine @relation(fields: [tenantId, payrollRunLineId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, payrollRunLineId])
  @@map("payslip_documents")
}

// One generated bank-payment export file per run — see
// docs/conventions/payroll.md's bank-export seam note (one reference
// format, `GENERIC_CSV`, bound today via the `BankExportAdapter` DI seam).
model PayrollBankExport {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  payrollRunId      String   @map("payroll_run_id") @db.Uuid
  format            String   @db.VarChar(32)
  storageKey        String   @map("storage_key")
  generatedByUserId String   @map("generated_by_user_id") @db.Uuid
  generatedAt       DateTime @default(now()) @map("generated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrollRun PayrollRun @relation(fields: [tenantId, payrollRunId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, payrollRunId])
  @@map("payroll_bank_exports")
}

// ---------------------------------------------------------------------------
// Statutory / government reporting (step 3.5.4, Phase 3.5's final slice) —
// see docs/conventions/statutory-reporting.md. GENERATES periodic government
// filing forms from FINALIZED PayrollRun data — distinct from CALCULATING the
// figures (PayrollEngineService/CountryPack's job, untouched by this step).
//
// `StatutoryReportDefinition` is global, RLS-EXEMPT reference data — the
// SAME posture `CountryPack` already establishes (see that model's own doc
// comment): no `tenant_id` column, `hrm_app` granted SELECT only, writable
// today only via the owner role (`packages/db/src/seed-statutory-report-definitions.ts`).
// It is a CATALOG, not an engine — "adding a country" means seeding new rows
// here PLUS registering that country's report generator(s) under
// `STATUTORY_REPORT_GENERATORS` (apps/api/src/statutory-reporting), never
// touching the register/queue/PDF/CSV/RBAC framework those generators run
// inside. `outputFormats` (e.g. `["PDF","CSV"]`) and `complianceNote` (this
// report's own "verify the current form layout/submission channel with the
// authority before filing" caveat) are both just descriptive catalog data,
// read by the UI/generation service, never branched on by country code.
enum StatutoryReportPeriodType {
  MONTHLY
  QUARTERLY
  ANNUAL
}

model StatutoryReportDefinition {
  id             String                    @id @default(uuid()) @db.Uuid
  countryCode    String                    @map("country_code") @db.VarChar(2)
  reportCode     String                    @map("report_code") @db.VarChar(64)
  name           String
  description    String
  periodType     StatutoryReportPeriodType @map("period_type")
  outputFormats  String[]                  @map("output_formats")
  complianceNote String                    @map("compliance_note")
  isActive       Boolean                   @default(true) @map("is_active")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  generatedReports GeneratedReport[]

  @@unique([countryCode, reportCode])
  @@index([countryCode, isActive])
  @@map("statutory_report_definitions")
}

enum GeneratedReportStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

// One row per generated report — the tenant-scoped REGISTER
// (`GET /statutory-reports`), ordinary RLS (tenant-owned). `periodKey`
// ("2026-06" monthly / "2026-Q2" quarterly / "2026" annual, computed by
// `StatutoryReportService` before every write) is the SINGLE uniqueness
// anchor — sidesteps the Postgres "NULL is distinct" trap a nullable
// `(periodMonth, periodQuarter)` compound unique would otherwise hit for
// ANNUAL rows (the same class of problem `PayrollRun`'s own
// FINAL_SETTLEMENT seam documents solving with hand-written partial
// indexes — this table solves it more simply, with a derived string,
// since a report register has no need for PayrollRun's own two-run-types-
// in-one-table shape). `periodYear`/`periodMonth`/`periodQuarter` are kept
// alongside it purely for filtering/display — never used for uniqueness.
model GeneratedReport {
  id                 String                    @id @default(uuid()) @db.Uuid
  tenantId           String                    @map("tenant_id") @db.Uuid
  branchId           String                    @map("branch_id") @db.Uuid
  reportDefinitionId String                    @map("report_definition_id") @db.Uuid
  reportCode         String                    @map("report_code") @db.VarChar(64)
  countryCode        String                    @map("country_code") @db.VarChar(2)
  periodType         StatutoryReportPeriodType @map("period_type")
  periodYear         Int                       @map("period_year")
  periodMonth        Int?                      @map("period_month")
  periodQuarter      Int?                      @map("period_quarter")
  periodKey          String                    @map("period_key") @db.VarChar(16)
  status             GeneratedReportStatus     @default(PENDING)
  pdfStorageKey      String?                   @map("pdf_storage_key")
  csvStorageKey      String?                   @map("csv_storage_key")
  // A small, non-sensitive-on-its-own summary (e.g. employeeCount,
  // totalTaxWithheld) shown in the register list without opening the PDF —
  // still passes through the audit sink's redaction like everything else.
  summary            Json?
  errorMessage       String?                   @map("error_message")
  requestedByUserId  String?                   @map("requested_by_user_id") @db.Uuid
  generatedAt        DateTime?                 @map("generated_at")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch                    @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  reportDefinition StatutoryReportDefinition @relation(fields: [reportDefinitionId], references: [id], onDelete: Restrict)

  @@unique([tenantId, branchId, reportDefinitionId, periodKey])
  @@index([tenantId, branchId, status])
  @@map("generated_reports")
}

// ---------------------------------------------------------------------------
// Performance management (step 2.2, Phase 2). A THIN CONSUMER of existing
// systems — see docs/conventions/performance.md: routing/sign-off is a real
// 0.7 `WorkflowInstance` (THE RULE, no bespoke approval logic anywhere in
// this module), reviewers are resolved via 1.1's `Employee.managerId`/
// `directReports` org chart, and reminders/notifications ride the 0.8 hub.
// The genuinely NEW concepts this step introduces are `RatingScale` and an
// `AppraisalCycle`'s review-type/eligibility configuration — both modeled as
// tenant-editable DATA (JSON, validated at the app layer), never a closed
// code-level enum, so a tenant can run a 5-point cycle and a 4-point
// probation scale side by side with zero code change.
// ---------------------------------------------------------------------------

// A tenant-configurable rating scale — DATA, not a hardcoded enum, per this
// step's explicit brief. `levels` is a `RatingLevel[]` (`{ value, label,
// description? }`, `packages/shared/src/validators/performance.validator.ts`)
// re-validated on every write AND read, the same "JSON column has no
// schema-level guarantee of its own" posture as Country Pack config/workflow
// approver rules elsewhere in this schema. `key` lets a cycle reference a
// scale by a stable short name (e.g. "5_POINT", "PROBATION_PASS_FAIL")
// instead of its opaque id.
model RatingScale {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  name      String
  levels    Json
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycles AppraisalCycle[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("rating_scales")
}

enum AppraisalCycleType {
  ANNUAL
  QUARTERLY
  PROBATION
}

enum AppraisalCycleStatus {
  DRAFT
  OPEN
  CLOSED
}

// The tenant-configurable review cycle — DATA drives which review types
// apply ("360" is simply a cycle whose `enabledReviewTypes` includes all
// four `ReviewType`s, not a separate model) and who is eligible
// (`eligibleBranchIds`/`eligibleDepartmentIds`, JSON string-id arrays —
// empty means "every branch/department in the tenant", the same "opaque
// JSON id array, validated at the app layer, no FK" pattern
// `WorkflowInstanceStep.eligibleApproverIds` already establishes; an FK
// array isn't representable in Postgres/Prisma without a join table this
// step's tests don't call for). `AppraisalCycleService.open` is what
// actually reads this configuration to ENROLL eligible employees — see
// `Appraisal` below.
model AppraisalCycle {
  id                    String               @id @default(uuid()) @db.Uuid
  tenantId              String               @map("tenant_id") @db.Uuid
  name                  String
  cycleType             AppraisalCycleType   @map("cycle_type")
  status                AppraisalCycleStatus @default(DRAFT)
  startDate             DateTime             @map("start_date") @db.Date
  endDate               DateTime             @map("end_date") @db.Date
  ratingScaleId         String               @map("rating_scale_id") @db.Uuid
  enabledReviewTypes    Json                 @map("enabled_review_types")
  eligibleBranchIds     Json                 @default("[]") @map("eligible_branch_ids")
  eligibleDepartmentIds Json                 @default("[]") @map("eligible_department_ids")
  openedAt              DateTime?            @map("opened_at")
  closedAt              DateTime?            @map("closed_at")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ratingScale RatingScale @relation(fields: [tenantId, ratingScaleId], references: [tenantId, id], onDelete: Restrict)
  goals       Goal[]
  appraisals  Appraisal[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, ratingScaleId])
  @@map("appraisal_cycles")
}

enum GoalLevel {
  COMPANY
  TEAM
  INDIVIDUAL
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  AT_RISK
  COMPLETED
  CANCELLED
}

// Goals/OKRs, cascading COMPANY -> TEAM -> INDIVIDUAL via the self-relation
// `parentGoalId` (same composite-self-relation pattern as
// `Branch.parentBranchId`/`Department.parentDepartmentId` — see
// docs/conventions/tenancy-rls.md). Exactly one of `employeeId`
// (INDIVIDUAL) / `departmentId` (TEAM) is set; COMPANY goals have neither —
// enforced by `createGoalSchema`'s `.refine()`, the same "shape validated
// outside the DB" posture this codebase always takes for a JSON-adjacent
// business rule a plain FK can't express. `cycleId` is optional — a goal
// can be set independently of any appraisal cycle, or scoped to one when a
// cycle is running ("a cycle runs: goals set, ..." per this step's tests).
// `progressPercent` is a snapshot recomputed by `GoalService` on every
// progress update (from `currentValue`/`targetValue` when both are set,
// otherwise taken directly from the caller) rather than derived at read
// time — cheap either way at this table's scale, but keeps one code path.
model Goal {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  level           GoalLevel
  employeeId      String?    @map("employee_id") @db.Uuid
  departmentId    String?    @map("department_id") @db.Uuid
  parentGoalId    String?    @map("parent_goal_id") @db.Uuid
  cycleId         String?    @map("cycle_id") @db.Uuid
  title           String
  description     String?
  targetValue     Float?     @map("target_value")
  currentValue    Float      @default(0) @map("current_value")
  unit            String?
  progressPercent Float      @default(0) @map("progress_percent")
  status          GoalStatus @default(NOT_STARTED)
  startDate       DateTime   @map("start_date") @db.Date
  endDate         DateTime   @map("end_date") @db.Date
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee   Employee?       @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)
  department Department?     @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Cascade)
  cycle      AppraisalCycle? @relation(fields: [tenantId, cycleId], references: [tenantId, id], onDelete: SetNull)

  // Composite self-relation, same pattern as Employee.manager/Branch.parentBranch.
  parentGoal Goal?  @relation("GoalHierarchy", fields: [tenantId, parentGoalId], references: [tenantId, id], onDelete: SetNull)
  childGoals Goal[] @relation("GoalHierarchy")

  @@unique([tenantId, id])
  @@index([tenantId, employeeId])
  @@index([tenantId, departmentId])
  @@index([tenantId, parentGoalId])
  @@index([tenantId, cycleId])
  @@map("goals")
}

enum AppraisalStatus {
  DRAFT
  IN_PROGRESS
  PENDING_SIGNOFF
  COMPLETED
  REJECTED
}

// One row per (cycle, employee) — created by `AppraisalCycleService.open`'s
// ENROLLMENT step for every employee the cycle's eligibility filter
// matches. `overallRating` is computed ONCE, when every `ReviewAssignment`
// for this appraisal reaches `SUBMITTED` (a simple average across submitted
// `Review.overallRating` rows — a documented simplification, no weighting
// by review type; see docs/conventions/performance.md), at the moment
// `AppraisalService.submitForApproval` is called — never recomputed after,
// the same "snapshot, don't re-derive" posture `PayrollRun.totalGrossBase`/
// `LeaveBalance.entitledDays` already take. `workflowInstanceId` is a plain
// id, no FK — THE RULE (docs/conventions/workflow.md): sign-off is a real
// `WorkflowInstance`, this module owns no approve/reject logic of its own.
model Appraisal {
  id                     String          @id @default(uuid()) @db.Uuid
  tenantId               String          @map("tenant_id") @db.Uuid
  cycleId                String          @map("cycle_id") @db.Uuid
  employeeId             String          @map("employee_id") @db.Uuid
  status                 AppraisalStatus @default(DRAFT)
  overallRating          Float?          @map("overall_rating")
  workflowInstanceId     String?         @map("workflow_instance_id") @db.Uuid
  submittedForApprovalAt DateTime?       @map("submitted_for_approval_at")
  completedAt            DateTime?       @map("completed_at")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cycle       AppraisalCycle     @relation(fields: [tenantId, cycleId], references: [tenantId, id], onDelete: Cascade)
  employee    Employee           @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)
  assignments ReviewAssignment[]
  reviews     Review[]

  // Lets ReviewAssignment/Review define a composite FK of (tenantId, id) ->
  // this table, same pattern as every other entity in this schema.
  @@unique([tenantId, id])
  @@unique([tenantId, cycleId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, employeeId])
  @@map("appraisals")
}

enum ReviewType {
  SELF
  MANAGER
  PEER
  UPWARD
}

enum ReviewAssignmentStatus {
  PENDING
  SUBMITTED
}

// The ROSTER of expected reviews for one `Appraisal` — who owes a review of
// what type. SELF/MANAGER/UPWARD rows are auto-created by
// `AppraisalCycleService.open`'s enrollment (SELF: the employee themselves;
// MANAGER: `Employee.managerId`, when one exists; UPWARD: each of the
// employee's `directReports`, when any exist — all resolved via the REAL
// 1.1 org chart, reusing `Employee.managerId`/the manager self-relation
// exactly as `ApproverResolverService`'s own `MANAGER` rule does, but at
// the Employee level rather than resolving all the way to a User the way a
// workflow approver rule does) — a row is simply never created for a type
// the org chart can't resolve (e.g. an employee with no manager gets no
// MANAGER assignment), a documented gap, not a silent failure. PEER rows
// are NEVER auto-created — they require an explicit
// `POST /performance/appraisals/:id/peer-assignments` call (`performance.manage`),
// per this step's "explicit peer assignment" brief. `@@unique` allows
// multiple PEER (or UPWARD) rows per appraisal, one per distinct reviewer.
model ReviewAssignment {
  id          String                 @id @default(uuid()) @db.Uuid
  tenantId    String                 @map("tenant_id") @db.Uuid
  appraisalId String                 @map("appraisal_id") @db.Uuid
  reviewType  ReviewType             @map("review_type")
  reviewerId  String                 @map("reviewer_id") @db.Uuid
  status      ReviewAssignmentStatus @default(PENDING)
  dueAt       DateTime?              @map("due_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appraisal Appraisal @relation(fields: [tenantId, appraisalId], references: [tenantId, id], onDelete: Cascade)
  reviewer  Employee  @relation(fields: [tenantId, reviewerId], references: [tenantId, id], onDelete: Cascade)
  review    Review?

  @@unique([tenantId, id])
  @@unique([tenantId, appraisalId, reviewType, reviewerId])
  @@index([tenantId, reviewerId, status])
  @@map("review_assignments")
}

// The SUBMITTED content of one fulfilled `ReviewAssignment` — kept as a
// separate table from the assignment/roster above (both explicitly named
// in this step's own schema scope) so "who owes a review" can be queried
// cheaply (`GET /performance/my-review-assignments`, mirroring
// `GET /workflow/my-pending-approvals`) with no join to review content, and
// so a submitted review reads as an immutable record of what was actually
// said. `ratingScaleId` is snapshotted from the cycle at submission time —
// the same "snapshot, don't re-derive" posture this whole module takes —
// so a later rating-scale edit never rewrites a historical review's frame
// of reference.
model Review {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  assignmentId  String     @map("assignment_id") @db.Uuid
  appraisalId   String     @map("appraisal_id") @db.Uuid
  reviewType    ReviewType @map("review_type")
  reviewerId    String     @map("reviewer_id") @db.Uuid
  ratingScaleId String     @map("rating_scale_id") @db.Uuid
  overallRating Float      @map("overall_rating")
  strengths     String?
  improvements  String?
  comments      String?
  submittedAt   DateTime   @default(now()) @map("submitted_at")

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignment ReviewAssignment @relation(fields: [tenantId, assignmentId], references: [tenantId, id], onDelete: Cascade)
  appraisal  Appraisal        @relation(fields: [tenantId, appraisalId], references: [tenantId, id], onDelete: Cascade)
  reviewer   Employee         @relation(fields: [tenantId, reviewerId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, assignmentId])
  @@index([tenantId, appraisalId])
  @@map("reviews")
}

// The calibration/distribution READ side's ONLY data source — see
// docs/conventions/performance.md and docs/conventions/analytics-dashboard.md
// (the SAME pre-aggregation discipline: a calibration view must never
// live-`GROUP BY` a tenant's `appraisals` table on the hot path, no matter
// how many employees are enrolled in a cycle). One row per (tenant, cycle,
// branch, department, ratingValue) — computed by
// `PerformanceCalibrationProcessor` grouping `Appraisal.overallRating`
// (rounded to the nearest `RatingScale` level, a documented simplification)
// joined to `Employee` for branch/department, via the SAME delete-then-
// bulk-`createMany` recompute `AnalyticsRollupProcessor` already uses (see
// analytics-dashboard.md's nullable-`departmentId`-breaks-upsert gotcha —
// applies identically here).
model AppraisalRatingDistributionSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  cycleId       String   @map("cycle_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  departmentId  String?  @map("department_id") @db.Uuid
  ratingValue   Float    @map("rating_value")
  employeeCount Int      @default(0) @map("employee_count")
  computedAt    DateTime @default(now()) @map("computed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, cycleId, branchId, departmentId, ratingValue])
  @@index([tenantId, cycleId, branchId])
  @@map("appraisal_rating_distribution_snapshots")
}

// ---------------------------------------------------------------------------
// Recruitment (ATS) + Onboarding + Offboarding — the employee LIFECYCLE
// (step 2.3, Phase 2's final step). See
// docs/conventions/recruitment-lifecycle.md. Recruitment deals in
// CANDIDATES, not yet Employees — `Candidate`/`Application`/`Interview`/
// `Offer` carry NO `employeeId` anywhere. `OnboardingProcess` is the ONE
// bridge that CREATES a real `Employee` (1.1) from an ACCEPTED `Offer`;
// `OffboardingProcess` is the ONE bridge that hands a leaving `Employee`'s
// final pay to Payroll (2.1, via the additive `PayrollRun.runType` seam
// above) and revokes their access (0.4). Every approval in this step
// (requisition, offer, offboarding) is a real 0.7 `WorkflowInstance` — THE
// RULE, no bespoke approval logic anywhere here.
// ---------------------------------------------------------------------------

enum JobRequisitionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CLOSED
}

// A headcount request, tied to branch/department — approved via the REAL
// 0.7 workflow engine (`entityType: "JobRequisition"`) like every approval
// in this step. `JobPosting` may only be created from an `APPROVED`
// requisition (see `JobPosting` below) — a posting can never exist without
// an approved headcount behind it.
model JobRequisition {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  title              String
  branchId           String               @map("branch_id") @db.Uuid
  departmentId       String?              @map("department_id") @db.Uuid
  designationId      String?              @map("designation_id") @db.Uuid
  employmentType     EmploymentType       @map("employment_type")
  headcount          Int                  @default(1)
  justification      String?
  status             JobRequisitionStatus @default(DRAFT)
  workflowInstanceId String?              @map("workflow_instance_id") @db.Uuid
  createdByUserId    String               @map("created_by_user_id") @db.Uuid
  approvedAt         DateTime?            @map("approved_at")
  closedAt           DateTime?            @map("closed_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch       @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  department  Department?  @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: SetNull)
  designation Designation? @relation(fields: [tenantId, designationId], references: [tenantId, id], onDelete: SetNull)
  postings    JobPosting[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, branchId])
  @@map("job_requisitions")
}

enum JobPostingStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

// The PUBLIC-facing side of a requisition. `publicSlug` is what the
// unauthenticated careers API resolves by (`GET /careers/postings/:slug`,
// scoped to whichever tenant the request's Host header already resolved to
// — see docs/conventions/recruitment-lifecycle.md → The public careers
// API). Only `PUBLISHED` postings are ever visible through that public
// route; `DRAFT`/`CLOSED` are internal-only.
model JobPosting {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  requisitionId String           @map("requisition_id") @db.Uuid
  title         String
  description   String
  publicSlug    String           @map("public_slug")
  status        JobPostingStatus @default(DRAFT)
  publishedAt   DateTime?        @map("published_at")
  closedAt      DateTime?        @map("closed_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requisition  JobRequisition @relation(fields: [tenantId, requisitionId], references: [tenantId, id], onDelete: Cascade)
  applications Application[]

  @@unique([tenantId, id])
  @@unique([tenantId, publicSlug])
  @@index([tenantId, status])
  @@index([tenantId, requisitionId])
  @@map("job_postings")
}

// A candidate's IDENTITY — deduplicated per tenant by email (a re-applicant
// reuses the SAME row; only a new `Application` is created for the new
// posting — see the public `apply` endpoint). Deliberately carries NO
// `employeeId`/`userId`: a Candidate is not yet, and may never become, an
// Employee — see `OnboardingProcess` below for the one bridge that
// converts one into the other.
model Candidate {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  firstName        String   @map("first_name")
  lastName         String   @map("last_name")
  email            String
  phone            String?
  resumeStorageKey String?  @map("resume_storage_key")
  source           String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applications        Application[]
  onboardingProcesses OnboardingProcess[]

  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@map("candidates")
}

enum ApplicationStage {
  APPLIED
  SCREEN
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

// One candidate's pipeline progress against one posting. Stage transitions
// are `@AuditLog`'d at the route (0.9) — no separate history table, the
// generic audit log's `before`/`after` capture already records every
// transition; adding a dedicated history table here would duplicate a
// mechanism this codebase already has.
model Application {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  candidateId  String           @map("candidate_id") @db.Uuid
  jobPostingId String           @map("job_posting_id") @db.Uuid
  stage        ApplicationStage @default(APPLIED)
  appliedAt    DateTime         @default(now()) @map("applied_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidate  Candidate   @relation(fields: [tenantId, candidateId], references: [tenantId, id], onDelete: Cascade)
  jobPosting JobPosting  @relation(fields: [tenantId, jobPostingId], references: [tenantId, id], onDelete: Cascade)
  interviews Interview[]
  offers     Offer[]

  @@unique([tenantId, id])
  @@unique([tenantId, candidateId, jobPostingId])
  @@index([tenantId, jobPostingId, stage])
  @@map("applications")
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// `interviewerUserIds` is a JSON `string[]` (a panel) — the same "just a
// snapshot of user ids, no dedicated join table" posture
// `WorkflowInstanceStep.eligibleApproverIds` already establishes.
model Interview {
  id                 String          @id @default(uuid()) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  applicationId      String          @map("application_id") @db.Uuid
  scheduledAt        DateTime        @map("scheduled_at")
  durationMinutes    Int             @map("duration_minutes")
  interviewerUserIds Json            @map("interviewer_user_ids")
  location           String?
  status             InterviewStatus @default(SCHEDULED)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application Application          @relation(fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Cascade)
  scorecards  InterviewScorecard[]

  @@unique([tenantId, id])
  @@index([tenantId, applicationId])
  @@map("interviews")
}

enum ScorecardRecommendation {
  STRONG_YES
  YES
  NO
  STRONG_NO
}

// One row per (interview, interviewer) — an interviewer submits at most one
// scorecard for an interview they're on the panel for
// (`interviewerUserId` is a plain id, no FK relation to `User` — the same
// "just a log fact" posture `PayrollRun.createdByUserId`/
// `WorkflowInstanceStep.delegatedToUserId` already take, deliberately, to
// avoid cluttering `User` with a named back-relation for every module that
// merely records who did something).
model InterviewScorecard {
  id                String                  @id @default(uuid()) @db.Uuid
  tenantId          String                  @map("tenant_id") @db.Uuid
  interviewId       String                  @map("interview_id") @db.Uuid
  interviewerUserId String                  @map("interviewer_user_id") @db.Uuid
  rating            Int
  recommendation    ScorecardRecommendation
  notes             String?
  submittedAt       DateTime                @default(now()) @map("submitted_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  interview Interview @relation(fields: [tenantId, interviewId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, interviewId, interviewerUserId])
  @@map("interview_scorecards")
}

enum OfferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ACCEPTED
  DECLINED
}

// An offer, approved via the REAL 0.7 workflow (`entityType: "Offer"`) like
// every approval in this step. `ACCEPTED` is the one status this whole
// step's lifecycle hinges on: acceptance is what starts onboarding (see
// `OnboardingProcess` — a `recruitment.offer_accepted` domain event, reacted
// to by an Onboarding-owned listener, never a direct
// Recruitment -> Onboarding service call, the SAME fire-and-forget
// event-listener shape every cross-module reaction in this codebase already
// uses). Money is `Decimal`, never `Float` — this codebase's universal
// monetary convention (see docs/conventions/payroll.md). Deliberately ONE
// offer per application (`@@unique([tenantId, applicationId])`) — a
// documented simplification; a revised offer after a decline needs a new
// `Application` row in this schema's current design.
model Offer {
  id                 String         @id @default(uuid()) @db.Uuid
  tenantId           String         @map("tenant_id") @db.Uuid
  applicationId      String         @map("application_id") @db.Uuid
  branchId           String         @map("branch_id") @db.Uuid
  departmentId       String?        @map("department_id") @db.Uuid
  designationId      String?        @map("designation_id") @db.Uuid
  employmentType     EmploymentType @map("employment_type")
  proposedSalary     Decimal        @map("proposed_salary") @db.Decimal(14, 2)
  salaryCurrency     String         @map("salary_currency") @db.VarChar(3)
  proposedJoinDate   DateTime       @map("proposed_join_date") @db.Date
  status             OfferStatus    @default(DRAFT)
  workflowInstanceId String?        @map("workflow_instance_id") @db.Uuid
  acceptedAt         DateTime?      @map("accepted_at")
  declinedAt         DateTime?      @map("declined_at")
  createdByUserId    String         @map("created_by_user_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application       Application        @relation(fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Cascade)
  branch            Branch             @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  department        Department?        @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: SetNull)
  designation       Designation?       @relation(fields: [tenantId, designationId], references: [tenantId, id], onDelete: SetNull)
  onboardingProcess OnboardingProcess?

  @@unique([tenantId, id])
  @@unique([tenantId, applicationId])
  @@index([tenantId, status])
  @@map("offers")
}

enum OnboardingProcessStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// The BRIDGE from CANDIDATE to EMPLOYEE — see
// docs/conventions/recruitment-lifecycle.md. Started automatically the
// moment an `Offer` reaches `ACCEPTED` (via an event listener reacting to
// `recruitment.offer_accepted` — never a direct service call between the
// two modules). `employeeId` is null until `OnboardingService.createEmployee`
// calls the REAL, UNMODIFIED 1.1 `EmployeeService.create` — which is what
// enforces the new hire's branch country pack's required fields (US
// SSN/W4, QA QATAR_ID/VISA_SPONSORSHIP, ...) with ZERO new validation logic
// in this module. Checklist tasks (IT setup, HR docs, manager intro, asset
// assignment) are tracked via the shared `ChecklistTaskInstance` table
// below — they do NOT gate employee creation; a real onboarding flow needs
// the new hire to already have system access before every checklist item
// (e.g. asset assignment) is necessarily done.
model OnboardingProcess {
  id          String                  @id @default(uuid()) @db.Uuid
  tenantId    String                  @map("tenant_id") @db.Uuid
  offerId     String                  @map("offer_id") @db.Uuid
  candidateId String                  @map("candidate_id") @db.Uuid
  employeeId  String?                 @map("employee_id") @db.Uuid
  status      OnboardingProcessStatus @default(IN_PROGRESS)
  startedAt   DateTime                @default(now()) @map("started_at")
  completedAt DateTime?               @map("completed_at")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offer     Offer     @relation(fields: [tenantId, offerId], references: [tenantId, id], onDelete: Cascade)
  candidate Candidate @relation(fields: [tenantId, candidateId], references: [tenantId, id], onDelete: Cascade)
  employee  Employee? @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: SetNull)

  @@unique([tenantId, id])
  @@unique([tenantId, offerId])
  @@unique([tenantId, employeeId])
  @@index([tenantId, status])
  @@map("onboarding_processes")
}

enum OffboardingReason {
  RESIGNATION
  TERMINATION
}

enum OffboardingProcessStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
}

// The clean EXIT bridge — see docs/conventions/recruitment-lifecycle.md.
// Routed via the REAL 0.7 workflow (`entityType: "OffboardingProcess"`)
// like every approval in this step; on `workflow.approved`,
// `OffboardingWorkflowEventsListener` flips this to `APPROVED` and
// instantiates the tenant's `OFFBOARDING` `ChecklistTemplate` (clearance
// tasks — asset return, access-revocation, exit interview, ...).
// `OffboardingService.complete` (gated on every checklist task for this
// process being `COMPLETED`) is the one action that: (1) flips the real
// `Employee.status` to `TERMINATED` via the UNMODIFIED 1.1
// `EmployeeService.update` (which itself already captures `terminatedAt`,
// since 1.5 — zero new capture logic here); (2) creates + calculates a
// `FINAL_SETTLEMENT` `PayrollRun` for the employee via the REAL, UNMODIFIED
// 2.1 payroll lifecycle — see `settlementPayrollRunId`; (3) revokes the
// linked `User`'s access (`TokenService.revokeAllForUser` + `User.status =
// DISABLED`). `settlementPayrollRunId` is a plain id, no FK relation — the
// SAME polymorphic "just an id" pattern `PayrollRun.workflowInstanceId`
// itself already establishes, here for the same reason in reverse
// (Payroll's schema stays fully unaware this module exists).
model OffboardingProcess {
  id                     String                   @id @default(uuid()) @db.Uuid
  tenantId               String                   @map("tenant_id") @db.Uuid
  employeeId             String                   @map("employee_id") @db.Uuid
  reason                 OffboardingReason
  lastWorkingDate        DateTime                 @map("last_working_date") @db.Date
  status                 OffboardingProcessStatus @default(PENDING_APPROVAL)
  workflowInstanceId     String?                  @map("workflow_instance_id") @db.Uuid
  settlementPayrollRunId String?                  @map("settlement_payroll_run_id") @db.Uuid
  initiatedByUserId      String                   @map("initiated_by_user_id") @db.Uuid
  completedAt            DateTime?                @map("completed_at")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@map("offboarding_processes")
}

enum ChecklistProcessType {
  ONBOARDING
  OFFBOARDING
}

enum ChecklistTaskStatus {
  PENDING
  COMPLETED
}

// ONE generic, tenant-configurable checklist mini-engine shared by BOTH
// Onboarding and Offboarding — see docs/conventions/recruitment-lifecycle.md.
// `tasks` is an ordered `ChecklistTaskDefinition[]` (`@hrm/shared`'s
// `checklistTaskDefinitionSchema` — key/title/category/`assigneeRule`
// (`SPECIFIC_USER`/`ROLE`/`MANAGER` — a SMALL, PURPOSE-BUILT shape, NOT
// 0.7's `ApproverRule`: a checklist task needs "who does this land on",
// never routing/multi-step approval)/`requiresDocument`), re-validated on
// every write AND read like every other JSON-configured feature in this
// codebase. `@@unique([tenantId, processType, name])` lets a tenant define
// one onboarding checklist and one offboarding checklist (or several,
// versioned by name) side by side.
model ChecklistTemplate {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @map("tenant_id") @db.Uuid
  processType ChecklistProcessType @map("process_type")
  name        String
  isActive    Boolean              @default(true) @map("is_active")
  tasks       Json
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, processType, name])
  @@map("checklist_templates")
}

// One instantiated task — POLYMORPHIC via `processType` + `processId` (the
// owning `OnboardingProcess`/`OffboardingProcess` row), the SAME "no FK,
// the owning module doesn't need to be a hard dependency of this generic
// mechanism" pattern `WorkflowInstance.entityType`/`entityId` already
// establishes for the identical reason. `assigneeUserId` is resolved ONCE,
// at instantiation (`ChecklistService.instantiate`), from the template
// task's `assigneeRule` — a later org-chart change never rewrites an
// already-assigned task, the same "snapshot, don't re-derive" posture this
// whole codebase takes for anything resolved once and acted on later.
model ChecklistTaskInstance {
  id                 String               @id @default(uuid()) @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  processType        ChecklistProcessType @map("process_type")
  processId          String               @map("process_id") @db.Uuid
  key                String
  title              String
  category           String
  assigneeUserId     String?              @map("assignee_user_id") @db.Uuid
  requiresDocument   Boolean              @default(false) @map("requires_document")
  documentStorageKey String?              @map("document_storage_key")
  status             ChecklistTaskStatus  @default(PENDING)
  completedAt        DateTime?            @map("completed_at")
  completedByUserId  String?              @map("completed_by_user_id") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, processType, processId, key])
  @@index([tenantId, assigneeUserId, status])
  @@index([tenantId, processType, processId])
  @@map("checklist_task_instances")
}

// =============================================================================
// Operations modules (step 3.1, Phase 3's first slice) — see
// docs/conventions/operations-modules.md. Four thin consumers of the
// workflow engine (0.7), storage (1.1), notifications (0.8), and audit
// (0.9): Expenses & Reimbursements, Asset Management, HR Helpdesk, and
// Announcements & Policies. *UserId "actor" columns below are plain
// @db.Uuid columns with NO Prisma relation — the SAME convention
// OffboardingProcess.initiatedByUserId/ChecklistTaskInstance.assigneeUserId
// already establish, since nothing here needs to JOIN through User at the
// Prisma level.
// =============================================================================

// --- Expenses & Reimbursements ----------------------------------------------

enum ExpenseClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REIMBURSED
}

// Tenant-configurable policy limits as DATA, per this step's brief — a
// category's `policyLimitAmount` (in the CLAIM's own currency, `null` =
// unlimited) is enforced by `ExpenseClaimService.submit`, never hardcoded.
model ExpenseCategory {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  code              String
  name              String
  policyLimitAmount Decimal? @map("policy_limit_amount") @db.Decimal(14, 2)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines  ExpenseLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("expense_categories")
}

// The claim HEADER. `currencyCode`/`totalAmount` are in the employee's
// branch currency (the SAME `basicSalary`/payroll-run currency 2.1 already
// resolves per branch); `totalAmountBaseCurrency`/`exchangeRateToBase` are
// a ONE-TIME snapshot (reusing Payroll's own `ExchangeRateService`, see
// docs/conventions/operations-modules.md) taken at submission, for
// tenant-wide reporting only — never re-derived later, the same
// "snapshot, don't re-derive" posture `PayrollRun.exchangeRateToBase`
// already takes. Approved via the REAL 0.7 workflow (`entityType:
// "EXPENSE_CLAIM"`, `dataSnapshot.amount` — literally the SAME entityType/
// shape workflow.e2e-spec.ts's own reference conditional-amount fixture
// already uses). `reimbursementPayrollRunLineId` is a plain id, no FK —
// the SAME polymorphic "just an id" pattern `OffboardingProcess.
// settlementPayrollRunId` already establishes — set once
// `PayrollRunProcessor` consumes this claim into a real payroll run line
// (see docs/conventions/operations-modules.md's reimbursement hand-off).
model ExpenseClaim {
  id                            String             @id @default(uuid()) @db.Uuid
  tenantId                      String             @map("tenant_id") @db.Uuid
  employeeId                    String             @map("employee_id") @db.Uuid
  branchId                      String             @map("branch_id") @db.Uuid
  currencyCode                  String             @map("currency_code") @db.VarChar(3)
  totalAmount                   Decimal            @default(0) @map("total_amount") @db.Decimal(14, 2)
  totalAmountBaseCurrency       Decimal?           @map("total_amount_base_currency") @db.Decimal(14, 2)
  exchangeRateToBase            Decimal?           @map("exchange_rate_to_base") @db.Decimal(18, 8)
  status                        ExpenseClaimStatus @default(DRAFT)
  workflowInstanceId            String?            @map("workflow_instance_id") @db.Uuid
  submittedAt                   DateTime?          @map("submitted_at")
  decidedAt                     DateTime?          @map("decided_at")
  reimbursementPayrollRunLineId String?            @map("reimbursement_payroll_run_line_id") @db.Uuid
  reimbursedAt                  DateTime?          @map("reimbursed_at")
  createdAt                     DateTime           @default(now()) @map("created_at")
  updatedAt                     DateTime           @updatedAt @map("updated_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)
  branch   Branch        @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  lines    ExpenseLine[]

  @@unique([tenantId, id])
  @@index([tenantId, employeeId, status])
  @@index([tenantId, status])
  @@map("expense_claims")
}

model ExpenseLine {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  expenseClaimId    String   @map("expense_claim_id") @db.Uuid
  categoryId        String   @map("category_id") @db.Uuid
  description       String
  amount            Decimal  @db.Decimal(14, 2)
  expenseDate       DateTime @map("expense_date") @db.Date
  receiptStorageKey String?  @map("receipt_storage_key")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  claim    ExpenseClaim    @relation(fields: [tenantId, expenseClaimId], references: [tenantId, id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, expenseClaimId])
  @@map("expense_lines")
}

// --- Asset Management --------------------------------------------------------

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  IN_MAINTENANCE
  RETIRED
}

enum AssetAssignmentStatus {
  ASSIGNED
  RETURNED
}

enum AssetMaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

model AssetCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assets Asset[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("asset_categories")
}

// The company asset register. `status` is a plain denormalized cache of
// "is there a currently-ASSIGNED AssetAssignment row" — maintained by
// `AssetService`/`AssetAssignmentService` on every assign/return/
// maintenance transition, never derived by a live join at read time.
model Asset {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  categoryId   String      @map("category_id") @db.Uuid
  branchId     String?     @map("branch_id") @db.Uuid
  assetTag     String      @map("asset_tag")
  name         String
  serialNumber String?     @map("serial_number")
  status       AssetStatus @default(AVAILABLE)
  purchaseDate DateTime?   @map("purchase_date") @db.Date
  purchaseCost Decimal?    @map("purchase_cost") @db.Decimal(14, 2)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category           AssetCategory            @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  branch             Branch?                  @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: SetNull)
  assignments        AssetAssignment[]
  maintenanceRecords AssetMaintenanceRecord[]

  @@unique([tenantId, id])
  @@unique([tenantId, assetTag])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@map("assets")
}

// One row per assign/return CYCLE (not one row per asset) — an asset
// re-assigned three times over its life has three rows, giving a real
// assignment HISTORY for free, the same "append, don't overwrite" posture
// `WorkflowAction` already takes for its own history.
model AssetAssignment {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @map("tenant_id") @db.Uuid
  assetId          String                @map("asset_id") @db.Uuid
  employeeId       String                @map("employee_id") @db.Uuid
  status           AssetAssignmentStatus @default(ASSIGNED)
  assignedAt       DateTime              @default(now()) @map("assigned_at")
  assignedByUserId String                @map("assigned_by_user_id") @db.Uuid
  condition        String?
  notes            String?
  returnedAt       DateTime?             @map("returned_at")
  returnedByUserId String?               @map("returned_by_user_id") @db.Uuid
  returnCondition  String?               @map("return_condition")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset    Asset    @relation(fields: [tenantId, assetId], references: [tenantId, id], onDelete: Cascade)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, assetId, status])
  @@index([tenantId, employeeId, status])
  @@map("asset_assignments")
}

model AssetMaintenanceRecord {
  id          String                 @id @default(uuid()) @db.Uuid
  tenantId    String                 @map("tenant_id") @db.Uuid
  assetId     String                 @map("asset_id") @db.Uuid
  description String
  status      AssetMaintenanceStatus @default(SCHEDULED)
  startedAt   DateTime?              @map("started_at")
  completedAt DateTime?              @map("completed_at")
  cost        Decimal?               @db.Decimal(14, 2)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset  Asset  @relation(fields: [tenantId, assetId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, assetId])
  @@map("asset_maintenance_records")
}

// --- HR Helpdesk / Ticketing -------------------------------------------------

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// `defaultSlaMinutes` is tenant-configurable DATA (per this step's brief),
// resolved once at ticket-creation time into `Ticket.slaDueAt` — a later
// edit to a category's SLA never rewrites an already-open ticket's due
// time, the same "snapshot, don't re-derive" posture this codebase takes
// throughout (e.g. `LeaveBalance.entitledDays`, `PayrollRun.
// exchangeRateToBase`).
model TicketCategory {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  code              String
  name              String
  defaultSlaMinutes Int?     @map("default_sla_minutes")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("ticket_categories")
}

model Ticket {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  categoryId       String         @map("category_id") @db.Uuid
  raisedByUserId   String         @map("raised_by_user_id") @db.Uuid
  employeeId       String?        @map("employee_id") @db.Uuid
  branchId         String?        @map("branch_id") @db.Uuid
  subject          String
  description      String
  priority         TicketPriority @default(MEDIUM)
  status           TicketStatus   @default(OPEN)
  assignedToUserId String?        @map("assigned_to_user_id") @db.Uuid
  slaDueAt         DateTime?      @map("sla_due_at")
  slaBreached      Boolean        @default(false) @map("sla_breached")
  resolvedAt       DateTime?      @map("resolved_at")
  closedAt         DateTime?      @map("closed_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    TicketCategory     @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  employee    Employee?          @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: SetNull)
  branch      Branch?            @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: SetNull)
  comments    TicketComment[]
  attachments TicketAttachment[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, raisedByUserId])
  @@index([tenantId, assignedToUserId])
  @@index([tenantId, slaDueAt])
  @@map("tickets")
}

model TicketComment {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  ticketId     String   @map("ticket_id") @db.Uuid
  authorUserId String   @map("author_user_id") @db.Uuid
  body         String
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, ticketId])
  @@map("ticket_comments")
}

model TicketAttachment {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  ticketId         String   @map("ticket_id") @db.Uuid
  storageKey       String   @map("storage_key")
  fileName         String   @map("file_name")
  uploadedByUserId String   @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, ticketId])
  @@map("ticket_attachments")
}

// --- Announcements & Policies -------------------------------------------------

// `targetBranchIds`/`targetDepartmentIds` — an EMPTY array means "every
// branch/department" (no targeting restriction), never "targets nothing" —
// the same "absence means unrestricted" posture branch scoping's own
// `allowedBranchIds: null` already takes elsewhere in this codebase, just
// expressed as an empty array here since Postgres has no native "null
// list" distinct from "empty list" worth modeling separately.
model Announcement {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  title               String
  body                String
  publishedByUserId   String    @map("published_by_user_id") @db.Uuid
  isActive            Boolean   @default(true) @map("is_active")
  publishedAt         DateTime? @map("published_at")
  targetBranchIds     String[]  @map("target_branch_ids") @db.Uuid
  targetDepartmentIds String[]  @map("target_department_ids") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, isActive, publishedAt])
  @@map("announcements")
}

// `version`/`isActive` mirror `CountryPack`'s own versioned-reference-data
// shape (see docs/conventions/country-packs.md) at tenant scope instead of
// global scope — republishing a policy is a NEW row (new `version`), never
// an in-place edit, so `PolicyAcknowledgment` rows always mean "acknowledged
// THIS exact version."
model Policy {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  title                  String
  body                   String
  version                Int       @default(1)
  isActive               Boolean   @default(true) @map("is_active")
  requiresAcknowledgment Boolean   @default(true) @map("requires_acknowledgment")
  // Step 3.5.3 (e-signatures) — see docs/conventions/e-signatures.md. When
  // true, a plain click via `POST /policies/:id/acknowledge` is refused
  // (PolicyService.acknowledge's own `bypassSignatureRequirement` guard) —
  // acknowledgment must instead go through a real SignatureRequest, whose
  // completion calls this SAME `acknowledge` method (with the bypass flag
  // set) so the ordinary PolicyAcknowledgment row still exists, PLUS the
  // full evidentiary signing trail.
  requiresSignature      Boolean   @default(false) @map("requires_signature")
  attachmentStorageKey   String?   @map("attachment_storage_key")
  publishedByUserId      String    @map("published_by_user_id") @db.Uuid
  publishedAt            DateTime? @map("published_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  acknowledgments PolicyAcknowledgment[]

  @@unique([tenantId, id])
  @@index([tenantId, isActive])
  @@map("policies")
}

model PolicyAcknowledgment {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  policyId       String   @map("policy_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policy Policy @relation(fields: [tenantId, policyId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, policyId, userId])
  @@map("policy_acknowledgments")
}

// --- Learning & Development (LMS) -------------------------------------------
//
// Step 3.2 — see docs/conventions/lms.md. A THIN module, same posture as
// 3.1's four operations modules: content lives in 1.1's StorageService/
// MinIO, expiry reminders reuse 0.8's notification hub + 0.10's scheduled-
// job infra (the SAME BullMQ `repeat` mechanism 1.5's AnalyticsRollupService
// established), completion/compliance analytics follow the SAME
// precomputed-rollup discipline 1.5 established (never a live aggregate
// over Enrollment/Certification at 20M-employee scale). Quizzes and
// required-training rules are tenant-authored DATA, never hardcoded scoring
// or eligibility logic — the same "config as data" posture Country Packs/
// workflow approver rules/custom fields already take throughout this
// schema.

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentItemType {
  VIDEO
  DOCUMENT
  LINK
}

enum ContentProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum EnrollmentSource {
  SELF
  ASSIGNED
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
}

enum CertificationStatus {
  ACTIVE
  EXPIRED
  RENEWED
}

model CourseCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courses Course[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("lms_course_categories")
}

// A course's `validityMonths` (null = never expires) drives
// `Certification.expiresAt`, computed once at award time — tenant-
// configurable DATA, never hardcoded (see the model doc below).
model Course {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  categoryId      String?      @map("category_id") @db.Uuid
  title           String
  description     String?
  status          CourseStatus @default(DRAFT)
  isMandatory     Boolean      @default(false) @map("is_mandatory")
  // Months a certification awarded for this course stays ACTIVE before
  // expiring; null = never expires (most non-compliance courses).
  validityMonths  Int?         @map("validity_months")
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  publishedAt     DateTime?    @map("published_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category CourseCategory? @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: SetNull)

  contentItems        CourseContentItem[]
  enrollments         Enrollment[]
  quiz                Quiz?
  certifications      Certification[]
  requiredTrainings   RequiredTraining[]
  completionSnapshots CourseCompletionDailySnapshot[]
  complianceSnapshots TrainingComplianceDailySnapshot[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@map("lms_courses")
}

// `moduleName` groups content items into a lightweight, informal "module"
// (a plain string, not its own table — this step's brief only asks for
// "ordering/modules", and a full module entity would be over-engineering
// for what's otherwise a flat ordered list); `orderIndex` sequences items
// within a module (and across the whole course when `moduleName` is null).
// Exactly one of `storageKey` (uploaded VIDEO/DOCUMENT via 1.1's
// StorageService/MinIO) / `externalUrl` (a LINK item) is ever populated,
// enforced at the service layer.
model CourseContentItem {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  courseId        String          @map("course_id") @db.Uuid
  moduleName      String?         @map("module_name")
  orderIndex      Int             @map("order_index")
  type            ContentItemType
  title           String
  storageKey      String?         @map("storage_key")
  externalUrl     String?         @map("external_url")
  durationMinutes Int?            @map("duration_minutes")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course   Course            @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Cascade)
  progress ContentProgress[]

  @@unique([tenantId, id])
  @@index([tenantId, courseId, orderIndex])
  @@map("lms_course_content_items")
}

model Enrollment {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  courseId         String           @map("course_id") @db.Uuid
  employeeId       String           @map("employee_id") @db.Uuid
  branchId         String           @map("branch_id") @db.Uuid
  source           EnrollmentSource @default(SELF)
  status           EnrollmentStatus @default(ENROLLED)
  enrolledByUserId String?          @map("enrolled_by_user_id") @db.Uuid
  dueDate          DateTime?        @map("due_date") @db.Date
  startedAt        DateTime?        @map("started_at")
  completedAt      DateTime?        @map("completed_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course         Course            @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Cascade)
  employee       Employee          @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)
  branch         Branch            @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  progress       ContentProgress[]
  quizAttempts   QuizAttempt[]
  certifications Certification[]

  // Deliberately NO unique([tenantId, courseId, employeeId]) — a course
  // certification is RENEWED by retaking the course (see Certification's
  // own doc comment), which means a SECOND Enrollment row for the same
  // (course, employee) is a legitimate, expected case, not a duplicate.
  // "Already actively enrolled" is instead an APPLICATION-level check
  // (EnrollmentService.enroll rejects a second ENROLLED/IN_PROGRESS row
  // for the same course+employee; a COMPLETED prior enrollment never
  // blocks a fresh one) — the same "DB allows it, the service layer
  // decides what's meaningful" posture this codebase already takes for
  // e.g. `AssetAssignment`'s append-only history.
  @@unique([tenantId, id])
  @@index([tenantId, employeeId, status])
  @@index([tenantId, courseId, employeeId])
  @@index([tenantId, dueDate])
  @@map("lms_enrollments")
}

model ContentProgress {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @map("tenant_id") @db.Uuid
  enrollmentId  String                @map("enrollment_id") @db.Uuid
  contentItemId String                @map("content_item_id") @db.Uuid
  status        ContentProgressStatus @default(NOT_STARTED)
  completedAt   DateTime?             @map("completed_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollment  Enrollment        @relation(fields: [tenantId, enrollmentId], references: [tenantId, id], onDelete: Cascade)
  contentItem CourseContentItem @relation(fields: [tenantId, contentItemId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, enrollmentId, contentItemId])
  @@map("lms_content_progress")
}

// One quiz per course (`@@unique([tenantId, courseId])`) — questions/pass
// mark are tenant-authored DATA, never hardcoded scoring logic.
// `isRequired` gates course completion: a course with a required quiz only
// completes once BOTH every content item is COMPLETED and the employee has
// a passing `QuizAttempt` — see EnrollmentProgressService.
model Quiz {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  courseId        String   @map("course_id") @db.Uuid
  title           String
  passMarkPercent Int      @default(70) @map("pass_mark_percent")
  isRequired      Boolean  @default(true) @map("is_required")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course    Course         @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@unique([tenantId, id])
  @@unique([tenantId, courseId])
  @@map("lms_quizzes")
}

// `options` is a plain `[{ key, text }]` JSON array (the same "JSON column
// has no schema-level guarantee of its own, validated at the service
// layer" posture Country Pack config/custom fields already take);
// `correctOptionKey` must match one of `options[].key`, checked at write
// time. Single-correct-answer multiple choice only — the thin scope this
// step's brief actually asks for ("configurable as data — questions, pass
// mark"), not a general-purpose exam engine.
model QuizQuestion {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  quizId           String   @map("quiz_id") @db.Uuid
  orderIndex       Int      @map("order_index")
  questionText     String   @map("question_text")
  options          Json
  correctOptionKey String   @map("correct_option_key")
  points           Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quiz   Quiz   @relation(fields: [tenantId, quizId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, quizId, orderIndex])
  @@map("lms_quiz_questions")
}

// One row per submitted attempt (APPEND-ONLY — an employee may retake a
// quiz, the same "history, not overwrite" posture `AssetAssignment`
// already takes) — `answers` is the submitted `{ [questionId]: optionKey }`
// map, kept for a real record of what was actually answered.
model QuizAttempt {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  quizId       String   @map("quiz_id") @db.Uuid
  enrollmentId String   @map("enrollment_id") @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  scorePercent Int      @map("score_percent")
  passed       Boolean
  answers      Json
  attemptedAt  DateTime @default(now()) @map("attempted_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quiz       Quiz       @relation(fields: [tenantId, quizId], references: [tenantId, id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [tenantId, enrollmentId], references: [tenantId, id], onDelete: Cascade)
  employee   Employee   @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, enrollmentId])
  @@index([tenantId, quizId, employeeId])
  @@map("lms_quiz_attempts")
}

// Awarded once an enrollment reaches COMPLETED. `expiresAt` =
// `issuedAt + Course.validityMonths` (null stays null — never expires).
// RENEWAL means "retake the course": a second completion of the SAME
// course while an ACTIVE certification already exists supersedes it — the
// old row flips to RENEWED and `renewedFromCertificationId` links the new
// row back to it (a composite-FK self-relation, the same shape
// `Employee.manager`/`Branch.parentBranch` already use) — never a second,
// separate "renew without retaking" code path. `lastReminderBucket`/
// `lastReminderSentAt` are the scheduled expiry-reminder job's OWN
// idempotency bookkeeping (see docs/conventions/lms.md) — a re-run of that
// job never double-notifies for the same bucket.
model Certification {
  id                         String              @id @default(uuid()) @db.Uuid
  tenantId                   String              @map("tenant_id") @db.Uuid
  courseId                   String              @map("course_id") @db.Uuid
  employeeId                 String              @map("employee_id") @db.Uuid
  enrollmentId               String              @map("enrollment_id") @db.Uuid
  status                     CertificationStatus @default(ACTIVE)
  issuedAt                   DateTime            @default(now()) @map("issued_at")
  expiresAt                  DateTime?           @map("expires_at")
  renewedFromCertificationId String?             @map("renewed_from_certification_id") @db.Uuid
  lastReminderBucket         String?             @map("last_reminder_bucket")
  lastReminderSentAt         DateTime?           @map("last_reminder_sent_at")
  createdAt                  DateTime            @default(now()) @map("created_at")
  updatedAt                  DateTime            @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course     Course     @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Cascade)
  employee   Employee   @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [tenantId, enrollmentId], references: [tenantId, id], onDelete: Cascade)

  renewedFrom Certification?  @relation("CertificationRenewal", fields: [tenantId, renewedFromCertificationId], references: [tenantId, id], onDelete: SetNull)
  renewals    Certification[] @relation("CertificationRenewal")

  @@unique([tenantId, id])
  @@index([tenantId, employeeId, status])
  @@index([tenantId, courseId, status])
  @@index([tenantId, status, expiresAt])
  @@map("lms_certifications")
}

// Which courses a role and/or branch must hold — CONFIG AS DATA, per this
// step's brief. `roleId`/`branchId` are BOTH nullable and INDEPENDENTLY
// "unrestricted when null" (the same "absence means unrestricted" posture
// `Announcement.targetBranchIds`/branch-scoping's own `allowedBranchIds:
// null` already take elsewhere) — a row with both null applies to every
// employee tenant-wide. Deliberately NO unique constraint spanning the
// nullable columns (see analytics-dashboard.md's own documented NULL-in-
// unique-index gotcha) — a duplicate row is harmless, since matching is an
// OR across every applicable row, not a keyed lookup.
model RequiredTraining {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  roleId    String?  @map("role_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course Course  @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Cascade)
  role   Role?   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: SetNull)
  branch Branch? @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: SetNull)

  @@unique([tenantId, id])
  @@index([tenantId, courseId])
  @@index([tenantId, roleId])
  @@index([tenantId, branchId])
  @@map("lms_required_trainings")
}

// One row per (tenant, snapshotDate, branchId, departmentId, courseId) —
// the SAME point-in-time cross-section, small-dimension rollup discipline
// analytics-dashboard.md already establishes; a dashboard read never live-
// aggregates `Enrollment` at 20M-employee scale. Computed by the scheduled
// `LmsRollupService` job, delete+recreate per (tenantId, date) — same
// nullable-`departmentId` gotcha, same fix.
model CourseCompletionDailySnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  snapshotDate    DateTime @map("snapshot_date") @db.Date
  branchId        String   @map("branch_id") @db.Uuid
  departmentId    String?  @map("department_id") @db.Uuid
  courseId        String   @map("course_id") @db.Uuid
  enrolledCount   Int      @default(0) @map("enrolled_count")
  inProgressCount Int      @default(0) @map("in_progress_count")
  completedCount  Int      @default(0) @map("completed_count")
  computedAt      DateTime @default(now()) @map("computed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  course Course @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, snapshotDate, branchId, departmentId, courseId])
  @@index([tenantId, snapshotDate, branchId])
  @@map("lms_course_completion_daily_snapshots")
}

// One row per (tenant, snapshotDate, branchId, departmentId, courseId) —
// the compliance-status rollup: how many employees are REQUIRED to hold
// this course (via `RequiredTraining`), and of those, how many are
// compliant/expiring-soon(<=30d)/expired/missing entirely. Dashboard KPIs
// read ONLY this table; a bounded, filtered drill-down list of the actual
// missing/expiring EMPLOYEES is a normal indexed operational read (see
// `LmsComplianceService.listGaps`), not a rollup — the same two-tier
// "rollup for the dashboard number, a bounded live read for the
// operational drill-down list" split every other admin list screen in this
// codebase already takes (e.g. `GET /payroll/runs`).
model TrainingComplianceDailySnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  snapshotDate   DateTime @map("snapshot_date") @db.Date
  branchId       String   @map("branch_id") @db.Uuid
  departmentId   String?  @map("department_id") @db.Uuid
  courseId       String   @map("course_id") @db.Uuid
  requiredCount  Int      @default(0) @map("required_count")
  compliantCount Int      @default(0) @map("compliant_count")
  expiringCount  Int      @default(0) @map("expiring_count")
  expiredCount   Int      @default(0) @map("expired_count")
  missingCount   Int      @default(0) @map("missing_count")
  computedAt     DateTime @default(now()) @map("computed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  course Course @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, snapshotDate, branchId, departmentId, courseId])
  @@index([tenantId, snapshotDate, branchId])
  @@map("lms_training_compliance_daily_snapshots")
}

// ---------------------------------------------------------------------------
// Step 3.3 — Integrations: "extend without forking" without touching a
// single existing module's logic. Four thin, additive slices — see
// docs/conventions/integrations.md for the full write-up:
//
//   1. Outbound webhooks — tenants subscribe an endpoint to a subset of the
//      domain events already emitted across every module (auth/licensing/
//      workflow/payroll/performance/recruitment/checklist/helpdesk/lms — see
//      packages/shared/src/webhooks/event-types.ts). Delivered via the 0.8
//      BullMQ pattern, signed HMAC-SHA256, breaker-wrapped, dead-lettered.
//   2. A versioned (/v1) public API, authenticated by a scoped, hashed
//      ApiKey — a second, parallel authentication path alongside the
//      existing JWT one, still tenant-resolved + RLS-enforced.
//   3. Adapter seams (accounting export, Slack, biometric devices, bank
//      export) — the SAME Symbol-token + interface + `{provide, useClass}`
//      shape as AUTH_PROVIDER/EMAIL_PROVIDER/BIOMETRIC_DEVICE_ADAPTER/
//      BANK_EXPORT_ADAPTER.
//   4. SsoConfig — per-tenant IdP configuration for the SSO seam (0.4),
//      gated behind FEATURE_FLAGS.SSO (ENTERPRISE-only, already seeded).
//
// Every table here is ordinary tenant-scoped RLS, same `tenant_isolation`
// policy pattern as every other table in this schema. Secrets
// (WebhookSubscription.signingSecretEncrypted, SsoConfig's client secret
// inside `config`, SlackWorkspaceConfig.webhookUrlEncrypted) are AES-256-GCM
// via the existing EncryptionService (reversible — needed to actually sign/
// call out later); ApiKey/BiometricDeviceRegistration secrets are one-way
// argon2id hashes via the new HashingService (PasswordService's exact
// algorithm, generalized out of apps/api/src/auth so this module doesn't
// reach into AuthModule internals) — never decryptable, only comparable.
// ---------------------------------------------------------------------------

enum WebhookSubscriptionStatus {
  ACTIVE
  PAUSED
}

model WebhookSubscription {
  id                     String                    @id @default(uuid()) @db.Uuid
  tenantId               String                    @map("tenant_id") @db.Uuid
  url                    String
  description            String?
  // Free-form strings validated against packages/shared's WEBHOOK_EVENT_TYPES
  // at the DTO layer, not a Postgres array-of-enum — same "closed catalog
  // lives in a data table/shared constant, not the schema" posture
  // CustomFieldDefinition.entityType/WorkflowInstance.entityType already take,
  // so adding a new webhook-eligible event never needs a migration here.
  eventTypes             String[]                  @map("event_types")
  status                 WebhookSubscriptionStatus @default(ACTIVE)
  signingSecretEncrypted String                    @map("signing_secret_encrypted")
  createdByUserId        String                    @map("created_by_user_id") @db.Uuid
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("webhook_subscriptions")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

// One row per delivery ATTEMPT SET for one (subscription, event) pair — the
// delivery log the brief asks for (attempts/status/response), same
// "PENDING/.../DEAD_LETTER + attempts/lastError" shape NotificationDelivery
// (0.8) already established, reused deliberately rather than re-invented.
model WebhookDelivery {
  id                    String                @id @default(uuid()) @db.Uuid
  tenantId              String                @map("tenant_id") @db.Uuid
  webhookSubscriptionId String                @map("webhook_subscription_id") @db.Uuid
  eventType             String                @map("event_type")
  // The rendered outbound envelope ({id, eventType, occurredAt, tenantId,
  // data}) — kept so a dead-lettered delivery is inspectable/re-payable
  // without re-deriving it from the (possibly long-gone) source event.
  payload               Json
  status                WebhookDeliveryStatus @default(PENDING)
  attempts              Int                   @default(0)
  lastResponseStatus    Int?                  @map("last_response_status")
  lastResponseBody      String?               @map("last_response_body")
  lastError             String?               @map("last_error")
  deliveredAt           DateTime?             @map("delivered_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription WebhookSubscription @relation(fields: [tenantId, webhookSubscriptionId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, webhookSubscriptionId, createdAt])
  @@index([tenantId, status])
  @@map("webhook_deliveries")
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

// A tenant-scoped programmatic credential for the versioned /v1 public API —
// a SECOND, parallel authentication path alongside the JWT one (see
// TenantScopeInterceptor's new `authenticateApiKey` branch). Only
// `hashedKey` (argon2id, via HashingService) is ever stored — the raw key is
// shown exactly once, at creation, and is unrecoverable after. `keyPrefix`
// (the key's own first several characters, stored in the clear) lets the UI
///logs identify a key without ever re-exposing the secret, the same
// "identify without revealing" role a masked credit-card number plays.
model ApiKey {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @map("tenant_id") @db.Uuid
  name               String
  keyPrefix          String       @map("key_prefix") @db.VarChar(16)
  hashedKey          String       @map("hashed_key")
  // Scoped to a subset of the SAME PermissionKey catalog RBAC already uses
  // (packages/shared PERMISSIONS) — reusing the RBAC permission model
  // exactly as instructed, not a second, parallel scope vocabulary. Checked
  // the identical way a JWT-authenticated request's permissions are: via
  // PermissionsGuard reading TenantContextService.getPermissions().
  scopes             String[]
  status             ApiKeyStatus @default(ACTIVE)
  // Per-key override of the DEFAULT_API_KEY_RATE_LIMIT default (packages/shared)
  // — null means "use the default for this tenant's edition".
  rateLimitPerMinute Int?         @map("rate_limit_per_minute")
  createdByUserId    String       @map("created_by_user_id") @db.Uuid
  lastUsedAt         DateTime?    @map("last_used_at")
  expiresAt          DateTime?    @map("expires_at")
  revokedAt          DateTime?    @map("revoked_at")
  createdAt          DateTime     @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, keyPrefix])
  @@index([tenantId, status])
  @@map("api_keys")
}

enum SsoProtocol {
  OIDC
  SAML
}

// Per-tenant IdP configuration for the SSO seam finished in this step —
// ONE row per tenant (@@unique([tenantId])), `protocol` picks which
// SsoAuthProvider implementation (apps/api/src/auth/sso/) interprets
// `config`. `config` is a JSON blob validated by a protocol-discriminated
// zod schema at the DTO layer (packages/shared's ssoConfigSchema) — the
// SAME "JSON column has no schema-level guarantee of its own, re-validated
// on read/write" posture every other JSON-configured feature in this
// codebase already takes (CountryPackConfig, WorkflowStep.approverRule,
// ...). The OIDC client secret INSIDE `config` is stored pre-encrypted by
// the service layer (EncryptionService) before this row is ever written —
// never a plaintext secret at rest, never logged.
model SsoConfig {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @unique @map("tenant_id") @db.Uuid
  protocol  SsoProtocol
  enabled   Boolean     @default(false)
  config    Json
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("sso_configs")
}

enum BiometricDeviceStatus {
  ACTIVE
  DISABLED
}

// Formalizes the 1.3 biometric seam (BiometricDeviceAdapter,
// ManualBiometricDeviceAdapter) with a real per-tenant device registry +
// ingestion credential, so a physical device can push punches over
// `POST /integrations/biometric/devices/:deviceId/punches` (authenticated
// by `hashedSecret`, not a user JWT — a device is not a logged-in user, the
// same class of non-JWT caller a webhook receiver or an API-key client is)
// without any change to BiometricDeviceAdapter/ManualBiometricDeviceAdapter
// themselves.
model BiometricDeviceRegistration {
  id           String                @id @default(uuid()) @db.Uuid
  tenantId     String                @map("tenant_id") @db.Uuid
  deviceId     String                @map("device_id")
  name         String
  hashedSecret String                @map("hashed_secret")
  status       BiometricDeviceStatus @default(ACTIVE)
  lastSeenAt   DateTime?             @map("last_seen_at")
  createdAt    DateTime              @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, deviceId])
  @@map("biometric_device_registrations")
}

// The Slack adapter's per-tenant config — one incoming-webhook URL per
// tenant, encrypted at rest (a webhook URL is a bearer credential: anyone
// holding it can post into the tenant's Slack channel). Consumed by
// SlackNotificationProvider (SLACK_PROVIDER), resolved the same way
// User.pushToken is resolved for the PUSH channel — see NotificationChannel
// above.
model SlackWorkspaceConfig {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @unique @map("tenant_id") @db.Uuid
  webhookUrlEncrypted String   @map("webhook_url_encrypted")
  enabled             Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("slack_workspace_configs")
}

// --- Data migration & onboarding toolkit ------------------------------------
//
// Step 3.5.1 — see docs/conventions/data-migration.md. Imports a new
// client's EXISTING data (Excel/CSV) into the platform through the REAL
// module services (EmployeeService, LeaveBalanceService, ...) — this
// toolkit owns zero employee/leave/country-pack validation logic itself,
// exactly the "thin consumer" posture 3.1's operations modules already
// established. Every import is a two-phase `ImportBatch`
// (VALIDATE/dry-run, then COMMIT, never both at once) — see the model doc
// comment below for the state machine.

enum ImportEntityType {
  BRANCH
  DEPARTMENT
  DESIGNATION
  COST_CENTER
  EMPLOYEE
  LEAVE_BALANCE
  ATTENDANCE_HISTORY
  PAYSLIP_HISTORY
}

// PARTIAL (default) — valid rows commit, invalid rows are reported, never
// silently dropped. ALL_OR_NOTHING — a single row error fails the entire
// commit (nothing written), for a tenant that wants an all-clean-or-nothing
// guarantee instead. Selected per batch at creation, never a global default
// baked into the importer itself.
enum ImportMode {
  PARTIAL
  ALL_OR_NOTHING
}

// UPLOADED (file stored, not yet parsed) -> VALIDATING (dry-run job running)
// -> DRY_RUN_COMPLETE (safe to review; nothing written yet) -> COMMITTING
// (commit job running) -> COMMITTED / COMMITTED_WITH_ERRORS (PARTIAL mode
// with some row errors) / FAILED (either phase's job crashed, or
// ALL_OR_NOTHING found any row error and wrote nothing). A batch may be
// re-validated (re-run dry-run after fixing the column mapping) any number
// of times before its first commit; `POST .../commit` is refused unless
// `status = DRY_RUN_COMPLETE` — the STATE MACHINE ITSELF is the first of
// two idempotency layers guarding commit (see data-migration.md): a second
// commit attempt against an already-COMMITTING/COMMITTED batch is a `409`,
// never a re-run. The second layer is data-level: every importer resolves
// its target row by NATURAL KEY (employeeCode, branch/department/
// designation name, cost-center code) and UPSERTS — so even importing the
// exact same file twice as a brand-new batch updates the existing rows
// instead of duplicating them.
enum ImportBatchStatus {
  UPLOADED
  VALIDATING
  DRY_RUN_COMPLETE
  COMMITTING
  COMMITTED
  COMMITTED_WITH_ERRORS
  FAILED
}

// A tenant's saved column-mapping (client spreadsheet header -> this
// platform's field name) for one entity type, reusable across repeat
// imports (e.g. a monthly leave-balance top-up from the same HRIS export).
// Tenant-scoped, ordinary RLS.
model ColumnMappingTemplate {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  name            String
  entityType      ImportEntityType @map("entity_type")
  // `{ [ourFieldKey]: "client's column header" }`.
  mapping         Json
  createdByUserId String?          @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entityType, name])
  @@map("column_mapping_templates")
}

// One row per upload. `fileStorageKey` addresses the uploaded source file
// in S3/MinIO (1.1's `StorageService`, reused as-is) — PURGED (set to
// null, object deleted) once the batch reaches a terminal state and the
// retention window elapses (`IMPORT_FILE_RETENTION_HOURS`, a scheduled
// sweep — see data-migration.md): raw uploaded PII must not live in
// object storage indefinitely once its job is done. `initiatedByUserId`
// (a tenant self-service import) and `initiatedByPlatformAdminId` (a
// vendor/platform admin running onboarding import on a tenant's behalf,
// see docs/conventions/vendor-console.md) are mutually exclusive plain
// ids — the latter is NOT an FK (`PlatformAdmin` is a structurally
// separate, non-tenant-scoped identity space, the same "just an id, no
// relation" pattern `AuditLog`'s own `impersonatedByPlatformAdminId`-style
// metadata already uses across a tenant boundary).
model ImportBatch {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  entityType ImportEntityType  @map("entity_type")
  mode       ImportMode        @default(PARTIAL)
  status     ImportBatchStatus @default(UPLOADED)

  fileName       String    @map("file_name")
  fileFormat     String    @map("file_format") @db.VarChar(8) // CSV | XLSX
  fileStorageKey String?   @map("file_storage_key")
  filePurgedAt   DateTime? @map("file_purged_at")

  // `{ [ourFieldKey]: "client's column header" }` — snapshotted onto the
  // batch at creation (even when sourced from a ColumnMappingTemplate) so
  // a later edit/deletion of that template never changes an in-flight or
  // historical batch's own behavior.
  columnMapping           Json
  columnMappingTemplateId String? @map("column_mapping_template_id") @db.Uuid

  totalRows     Int @default(0) @map("total_rows")
  processedRows Int @default(0) @map("processed_rows")
  createCount   Int @default(0) @map("create_count")
  updateCount   Int @default(0) @map("update_count")
  skipCount     Int @default(0) @map("skip_count")
  errorCount    Int @default(0) @map("error_count")

  dryRunCompletedAt DateTime? @map("dry_run_completed_at")
  committedAt       DateTime? @map("committed_at")
  // Top-level job failure (the whole dry-run/commit job crashed — a
  // corrupt file, an unreachable dependency), as opposed to a per-row
  // `ImportRowError` (a specific row was invalid) — kept separate so the
  // UI can tell "your file has 3 bad rows" apart from "something broke on
  // our end, try again."
  failureReason     String?   @map("failure_reason")

  initiatedByUserId          String? @map("initiated_by_user_id") @db.Uuid
  initiatedByPlatformAdminId String? @map("initiated_by_platform_admin_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rowErrors ImportRowError[]

  // Lets ImportRowError define a composite FK of (tenantId, id) -> this
  // table, same pattern as every other entity in this schema.
  @@unique([tenantId, id])
  @@index([tenantId, entityType, status])
  @@index([tenantId, status, filePurgedAt])
  @@map("import_batches")
}

// One row per failed row from either phase — the "actionable, plain-
// language, downloadable error report" the brief calls for. `phase`
// distinguishes a DRY_RUN finding (nothing was written) from a COMMIT
// finding (this exact row was skipped while its batch-mates committed, in
// PARTIAL mode). Re-running dry-run (after the client fixes their mapping)
// DELETES this batch's prior DRY_RUN rows first — see
// `MigrationValidationService` — so this table never accumulates stale
// findings from a superseded dry-run pass.
model ImportRowError {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  importBatchId String   @map("import_batch_id") @db.Uuid
  phase         String   @db.VarChar(16) // DRY_RUN | COMMIT
  rowNumber     Int      @map("row_number")
  message       String
  // The mapped (not raw) row data that failed, so the downloadable report
  // shows the client their OWN column values next to the reason.
  rowData       Json     @map("row_data")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  importBatch ImportBatch @relation(fields: [tenantId, importBatchId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, importBatchId, phase, rowNumber])
  @@map("import_row_errors")
}

// Historical attendance data migrated from a client's prior system —
// READ-ONLY, deliberately NOT written into `AttendanceDailySummary` (1.3's
// live, RECOMPUTED rollup table): mixing migrated history into a table a
// scheduled job freely overwrites/recomputes would silently erase it the
// first time that job runs for the same employee/day. Kept in its own
// table instead, clearly marked as migrated — see data-migration.md's
// "why not the real rollup table" note.
model MigratedAttendanceSummary {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  importBatchId   String   @map("import_batch_id") @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  workDate        DateTime @map("work_date") @db.Date
  status          String   @db.VarChar(16)
  workedMinutes   Int?     @map("worked_minutes")
  overtimeMinutes Int?     @map("overtime_minutes")
  note            String?
  createdAt       DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, employeeId, workDate])
  @@map("migrated_attendance_summaries")
}

// Historical payslip/payroll data migrated from a client's prior system —
// READ-ONLY, deliberately NOT a real `PayrollRun`/`PayrollRunLine` (2.1):
// this toolkit never recomputes historical payroll (no tax/statutory
// engine involvement, per the brief's own explicit scope call) — it just
// carries the client's own already-final historical figures forward for
// reference. `grossPay`/`netPay` are field-level gated behind
// `salary.view` at the API layer (see docs/conventions/field-level-permissions.md),
// the same posture `Employee.compensation` already takes, though — an
// honest, documented gap — unlike `Employee.baseSalaryEncrypted` these are
// NOT encrypted at rest (see data-migration.md's known-gaps note).
model MigratedPayslipRecord {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  importBatchId String   @map("import_batch_id") @db.Uuid
  employeeId    String   @map("employee_id") @db.Uuid
  periodYear    Int      @map("period_year")
  periodMonth   Int      @map("period_month")
  currencyCode  String   @map("currency_code") @db.VarChar(3)
  grossPay      Decimal  @map("gross_pay") @db.Decimal(14, 2)
  netPay        Decimal  @map("net_pay") @db.Decimal(14, 2)
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, employeeId, periodYear, periodMonth])
  @@map("migrated_payslip_records")
}

// --- Benefits Administration -------------------------------------------------
//
// Step 3.5.2 — see docs/conventions/benefits.md. THE BOUNDARY (same shape as
// Payroll's own, 2.1): this module never computes pay. Active enrollments
// (tenant-configured plans) and country-pack-declared statutory schemes
// produce PAYROLL INPUTS — employee-side deductions, employer-side
// contributions — merged onto a payroll run the SAME way Expenses'
// reimbursement hand-off is (see docs/conventions/operations-modules.md):
// an ADDITIVE step inside `PayrollRunProcessor`, the payroll ENGINE itself
// completely untouched. Statutory schemes are never re-implemented here —
// `PayrollEngineService` already applies every resolved CountryPack
// `statutory.components` entry automatically (0.5's rules engine, unchanged);
// this module's own statutory surface calls the SAME unmodified
// `computeStatutoryComponents` purely for READ-ONLY preview/reporting, never
// a second computation path a payroll run actually depends on.

enum BenefitType {
  HEALTH_INSURANCE
  PROVIDENT_FUND
  PENSION
  LIFE_INSURANCE
  BONUS_INCENTIVE
  ALLOWANCE
  OTHER
}

// Deliberately the SAME three-value shape as `PayrollComponentCalcKind`
// (2.1) — a benefit plan's cost is computed exactly like a salary-structure
// component: a flat amount, a percentage of the employee's basic salary, or
// a `FORMULA` reusing 0.5's closed `Expr` AST as-is (imported, not
// redefined — see packages/shared/src/validators/benefits.validator.ts).
enum BenefitCostBasis {
  FIXED_AMOUNT
  PERCENTAGE_OF_BASE
  FORMULA
}

// A benefit plan tenant-configurable definition. `costBasis`/`fixedAmount`/
// `percentageOfBase`/`percentageRate`/`formula` compute the plan's TOTAL
// period cost (mirroring `PayrollComponentDefinition` field-for-field);
// `employeeSharePercent`/`employerSharePercent` (fractions summing to 1.0,
// enforced by `createBenefitPlanSchema`) then split that total between the
// employee deduction and the employer contribution — one cost structure,
// one split, rather than two independently-configured amounts that could
// silently drift apart. `hasTiers` plans instead price EACH
// `BenefitPlanTier` with its own explicit employee/employer amounts,
// bypassing the share split entirely (a tier already states both sides).
// `affectsPayroll = false` models a purely informational perk (e.g. "office
// gym pass") that must never reach a payroll run.
model BenefitPlan {
  id                   String           @id @default(uuid()) @db.Uuid
  tenantId             String           @map("tenant_id") @db.Uuid
  code                 String
  name                 String
  benefitType          BenefitType      @map("benefit_type")
  description          String?
  currencyCode         String           @map("currency_code") @db.VarChar(3)
  costBasis            BenefitCostBasis @map("cost_basis")
  fixedAmount          Decimal?         @map("fixed_amount") @db.Decimal(14, 2)
  percentageOfBase     String?          @map("percentage_of_base")
  percentageRate       Float?           @map("percentage_rate")
  formula              Json?
  employeeSharePercent Float            @default(0) @map("employee_share_percent")
  employerSharePercent Float            @default(1) @map("employer_share_percent")
  hasTiers             Boolean          @default(false) @map("has_tiers")
  allowSelfElection    Boolean          @default(false) @map("allow_self_election")
  requiresApproval     Boolean          @default(false) @map("requires_approval")
  affectsPayroll       Boolean          @default(true) @map("affects_payroll")
  isActive             Boolean          @default(true) @map("is_active")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tiers       BenefitPlanTier[]
  enrollments BenefitEnrollment[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("benefit_plans")
}

// One coverage tier per row (e.g. EMPLOYEE_ONLY / EMPLOYEE_SPOUSE /
// EMPLOYEE_FAMILY) — tenant-authored labels, not a closed enum, the same
// "opaque key, meaning is tenant data" posture `Employee.statutoryFields`
// already takes. Only meaningful when the owning plan's `hasTiers` is true;
// `employeeAmount`/`employerAmount` are each tier's OWN explicit flat cost
// (no percentage/formula tier pricing in this phase — see benefits.md's
// documented, deliberate scope line).
model BenefitPlanTier {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  planId         String   @map("plan_id") @db.Uuid
  key            String
  label          String
  employeeAmount Decimal  @default(0) @map("employee_amount") @db.Decimal(14, 2)
  employerAmount Decimal  @default(0) @map("employer_amount") @db.Decimal(14, 2)
  order          Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan        BenefitPlan         @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Cascade)
  enrollments BenefitEnrollment[]

  @@unique([tenantId, id])
  @@unique([tenantId, planId, key])
  @@index([tenantId, planId])
  @@map("benefit_plan_tiers")
}

enum BenefitEnrollmentStatus {
  PENDING_APPROVAL
  ACTIVE
  CANCELLED
  EXPIRED
}

// One row per employee's enrollment in one plan. `effectiveFrom`/
// `effectiveTo` (null = open-ended) gate which period(s) this enrollment
// contributes to payroll — see `resolveActiveBenefitEnrollments` in
// `apps/api/src/benefits/benefits-payroll-input.util.ts`. `requiresApproval`
// plans start `PENDING_APPROVAL` and only flip to `ACTIVE` once the REAL 0.7
// workflow approves them (`entityType: "BENEFIT_ENROLLMENT"`, THE RULE — no
// bespoke approval logic here either); every other plan is `ACTIVE`
// immediately.
model BenefitEnrollment {
  id                 String                  @id @default(uuid()) @db.Uuid
  tenantId           String                  @map("tenant_id") @db.Uuid
  employeeId         String                  @map("employee_id") @db.Uuid
  planId             String                  @map("plan_id") @db.Uuid
  coverageTierId     String?                 @map("coverage_tier_id") @db.Uuid
  status             BenefitEnrollmentStatus @default(ACTIVE)
  effectiveFrom      DateTime                @map("effective_from") @db.Date
  effectiveTo        DateTime?               @map("effective_to") @db.Date
  enrolledByUserId   String                  @map("enrolled_by_user_id") @db.Uuid
  workflowInstanceId String?                 @map("workflow_instance_id") @db.Uuid
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  tenant              Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee            Employee                     @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)
  plan                BenefitPlan                  @relation(fields: [tenantId, planId], references: [tenantId, id], onDelete: Cascade)
  coverageTier        BenefitPlanTier?             @relation(fields: [tenantId, coverageTierId], references: [tenantId, id], onDelete: SetNull, map: "benefit_enrollments_tier_fkey")
  dependents          BenefitEnrollmentDependent[]
  contributionRecords BenefitContributionRecord[]

  @@unique([tenantId, id])
  @@index([tenantId, employeeId, status])
  @@index([tenantId, planId, status])
  @@map("benefit_enrollments")
}

// A covered dependent on one enrollment — reuses 1.1's `EmployeeDependent`
// directly rather than duplicating name/relationship/DOB fields here.
model BenefitEnrollmentDependent {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  enrollmentId        String   @map("enrollment_id") @db.Uuid
  employeeDependentId String   @map("employee_dependent_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollment        BenefitEnrollment @relation(fields: [tenantId, enrollmentId], references: [tenantId, id], onDelete: Cascade)
  employeeDependent EmployeeDependent @relation(fields: [tenantId, employeeDependentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, enrollmentId, employeeDependentId])
  @@map("benefit_enrollment_dependents")
}

// The payroll-input PROOF row — one per (enrollment, period) actually
// merged into a real payroll run line, written by `PayrollRunProcessor`'s
// additive `mergeBenefitContributions` step (see
// docs/conventions/benefits.md). `@@unique([tenantId, enrollmentId,
// periodYear, periodMonth])` is this module's OWN idempotency backstop —
// the same role `ExpenseClaim.reimbursementPayrollRunLineId` plays for a
// one-time claim, expressed per-PERIOD here since an enrollment recurs
// every period rather than being consumed once.
model BenefitContributionRecord {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  employeeId       String   @map("employee_id") @db.Uuid
  planId           String   @map("plan_id") @db.Uuid
  enrollmentId     String   @map("enrollment_id") @db.Uuid
  payrollRunId     String   @map("payroll_run_id") @db.Uuid
  payrollRunLineId String?  @map("payroll_run_line_id") @db.Uuid
  periodYear       Int      @map("period_year")
  periodMonth      Int      @map("period_month")
  currencyCode     String   @map("currency_code") @db.VarChar(3)
  employeeAmount   Decimal  @map("employee_amount") @db.Decimal(14, 2)
  employerAmount   Decimal  @map("employer_amount") @db.Decimal(14, 2)
  createdAt        DateTime @default(now()) @map("created_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee   Employee          @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)
  enrollment BenefitEnrollment @relation(fields: [tenantId, enrollmentId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, enrollmentId, periodYear, periodMonth])
  @@index([tenantId, payrollRunId])
  @@index([tenantId, employeeId, periodYear, periodMonth])
  @@map("benefit_contribution_records")
}

// --- E-Signatures ------------------------------------------------------
//
// Step 3.5.3 — see docs/conventions/e-signatures.md. A generic, POLYMORPHIC
// signature-request model (same `entityType`/`entityId`-with-no-FK shape as
// `WorkflowInstance`/`CustomFieldValueSet` — a signature request usually
// concerns a module row that may not exist at all for a bare uploaded
// contract) that ANY document (generated PDF or uploaded via 1.1
// `StorageService`) can be sent through, to one or more signers, sequential
// or parallel via the signer's own `order` column — the SAME "shares an
// `order` = parallel group, different `order` = sequential" shape
// `WorkflowStep.order` established, deliberately NOT the workflow engine
// itself: signing is an action (sign/decline), never a multi-step
// approve/reject/delegate/escalate decision, so reusing the whole engine
// here would be reuse in name only — the identical justification
// checklists.md already gives for its own small mini-engine relative to
// `ApproverRule`. A genuine multi-party APPROVAL need (e.g. "legal must
// approve this contract before it's sent out") is a SEPARATE, optional real
// 0.7 `WorkflowInstance` a consuming module may start on its own before
// ever creating a `SignatureRequest` — this module has no opinion on that.

enum SignatureRequestStatus {
  DRAFT
  SENT
  PARTIALLY_SIGNED
  COMPLETED
  DECLINED
  CANCELED
  EXPIRED
}

enum SignatureDocumentSource {
  UPLOADED
  GENERATED
}

enum SignerType {
  INTERNAL
  EXTERNAL
}

enum SignerStatus {
  PENDING
  SENT
  VIEWED
  SIGNED
  DECLINED
}

enum SigningMethod {
  TYPED_NAME
  DRAWN_SIGNATURE
  CLICK_TO_SIGN
}

enum SignatureEventType {
  CREATED
  SENT
  VIEWED
  SIGNED
  DECLINED
  EXPIRED
  CERTIFICATE_GENERATED
}

model SignatureRequest {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  title    String
  // Polymorphic link to the module row this signature concerns (e.g.
  // `"Offer"`/`"Policy"`) — nullable, since a bare uploaded HR contract has
  // no owning module row at all. No FK, same reasoning as
  // `WorkflowInstance.entityType`/`.entityId`.
  entityType String? @map("entity_type")
  entityId   String? @map("entity_id") @db.Uuid
  // Nullable — see docs/conventions/e-signatures.md → Branch scoping. Set
  // from the linked entity's own branch when one exists (e.g. an Offer's
  // `branchId`); left null for a tenant-wide document, the same "no scope
  // to widen into, but never out of scope either" posture Announcements'
  // untargeted rows already take.
  branchId String? @map("branch_id") @db.Uuid

  documentSource     SignatureDocumentSource @map("document_source")
  documentStorageKey String                  @map("document_storage_key")
  documentMimeType   String                  @default("application/pdf") @map("document_mime_type")
  // SHA-256 hex of the EXACT bytes at `documentStorageKey`, computed once at
  // creation and NEVER recomputed — this is what a later tamper-evidence
  // check (`GET /e-signatures/requests/:id/verify`) compares the object's
  // CURRENT bytes against.
  documentHash String @map("document_hash")

  status          SignatureRequestStatus @default(DRAFT)
  createdByUserId String                 @map("created_by_user_id") @db.Uuid
  sentAt          DateTime?              @map("sent_at")
  completedAt     DateTime?              @map("completed_at")
  // Every signer's own access (external token expiry / internal deadline)
  // is bounded by this — set at `send()` time, not editable afterward.
  expiresAt       DateTime?              @map("expires_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  signers     SignatureSigner[]
  events      SignatureEvent[]
  certificate SignatureCertificate?

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, entityType, entityId])
  @@map("signature_requests")
}

model SignatureSigner {
  id                 String @id @default(uuid()) @db.Uuid
  tenantId           String @map("tenant_id") @db.Uuid
  signatureRequestId String @map("signature_request_id") @db.Uuid
  // Shares an `order` value with another signer = a PARALLEL group (both
  // must sign before the next group activates); a different value =
  // SEQUENTIAL. See `SigningProgressService`.
  order              Int    @default(0)

  signerType SignerType @map("signer_type")
  // INTERNAL — a real User (ESS self-service, `GET /e-signatures/my-pending`).
  userId     String?    @map("user_id") @db.Uuid
  // EXTERNAL — no account at all (e.g. a candidate signing an offer letter
  // before joining); identified only by name/email, reached via a scoped
  // single-purpose signing link, never RBAC/JWT.
  externalName  String? @map("external_name")
  externalEmail String? @map("external_email")

  status SignerStatus @default(PENDING)

  // EXTERNAL signers only — the SAME keyPrefix(indexed)+argon2id-hash
  // pattern `ApiKeyService`/`ApiKeyAuthService` already establish for a
  // presented-secret lookup (see docs/conventions/e-signatures.md). The raw
  // token is returned to the CALLER exactly once (at send-time, to build
  // the emailed link) and never stored — only this hash can verify a later
  // presentation.
  accessTokenPrefix    String?   @map("access_token_prefix") @db.VarChar(16)
  accessTokenHash      String?   @map("access_token_hash")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")

  sentAt      DateTime? @map("sent_at")
  viewedAt    DateTime? @map("viewed_at")
  signedAt    DateTime? @map("signed_at")
  declinedAt  DateTime? @map("declined_at")

  signingMethod            SigningMethod? @map("signing_method")
  // Exactly one of these two is set once `status = SIGNED`, per
  // `signingMethod`.
  typedSignatureText       String?        @map("typed_signature_text")
  signatureImageStorageKey String?        @map("signature_image_storage_key")

  createdAt DateTime @default(now()) @map("created_at")

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  signatureRequest SignatureRequest @relation(fields: [tenantId, signatureRequestId], references: [tenantId, id], onDelete: Cascade)
  events           SignatureEvent[]

  @@unique([tenantId, id])
  @@unique([tenantId, accessTokenPrefix])
  @@index([tenantId, signatureRequestId])
  @@index([tenantId, userId])
  @@map("signature_signers")
}

// THE EVIDENTIARY TRAIL — append-only, and immutable at the DATABASE
// layer (see the `enable_rls_for_esignature_module` migration's REVOKE
// UPDATE/DELETE, the identical mechanism `audit_log` already uses — see
// docs/conventions/audit-custom-fields.md). One row per meaningful
// lifecycle moment (created/sent/viewed/signed/declined/expired/
// certificate-generated); a SIGNED row is this module's core legal record
// — signer identity, UTC timestamp, IP/user-agent, signing method, and the
// document-hash actually presented/signed at that instant, so tampering
// with the stored document afterward is detectable by recomputing its hash
// and comparing against what was recorded here.
//
// Assessed for Phase 5.2 native partitioning (see
// docs/conventions/partitioning-archival.md) and deliberately NOT
// partitioned: unlike `AuditLog`/`AttendanceRecord`/`PlatformAuditLog`, this
// table was never built with a composite (partition-key-inclusive) primary
// key — it's a plain `@id` on `id` alone — so converting it would be a real
// PK-shape change, not the additive migration this phase is scoped to. Its
// growth is also structurally bounded very differently: one row per
// lifecycle moment of a SIGNATURE REQUEST (a handful of events per document
// signed), not one row per employee per day (`AttendanceRecord`) or per
// mutating action system-wide (`AuditLog`/`PlatformAuditLog`) — orders of
// magnitude lower volume. DB-level immutability (REVOKE UPDATE/DELETE) and
// RLS are unaffected either way; this is a scale decision, not a safety one.
model SignatureEvent {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  signatureRequestId String             @map("signature_request_id") @db.Uuid
  signerId           String?            @map("signer_id") @db.Uuid
  eventType          SignatureEventType @map("event_type")
  occurredAt         DateTime           @default(now()) @map("occurred_at")

  actorUserId        String? @map("actor_user_id") @db.Uuid
  actorExternalName  String? @map("actor_external_name")
  actorExternalEmail String? @map("actor_external_email")
  ipAddress          String? @map("ip_address")
  userAgent          String? @map("user_agent")

  signingMethod SigningMethod? @map("signing_method")
  documentHash  String?        @map("document_hash")
  metadata      Json?

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  signatureRequest SignatureRequest @relation(fields: [tenantId, signatureRequestId], references: [tenantId, id], onDelete: Cascade)
  signer           SignatureSigner? @relation(fields: [tenantId, signerId], references: [tenantId, id], onDelete: SetNull)

  @@index([tenantId, signatureRequestId])
  @@index([tenantId, signerId])
  @@map("signature_events")
}

// One per COMPLETED SignatureRequest — the signature CERTIFICATE / audit
// page (who signed what, when, hashes), rendered as its own PDF via the
// SAME pdfkit approach `PayslipPdfService` established, stored via 1.1's
// `StorageService`/MinIO. Deliberately a SEPARATE artifact from the signed
// document itself (never merged/re-embedded into it) — both are
// independently downloadable; see docs/conventions/e-signatures.md for why.
model SignatureCertificate {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  signatureRequestId String   @map("signature_request_id") @db.Uuid
  documentHash       String   @map("document_hash")
  storageKey         String   @map("storage_key")
  generatedAt        DateTime @default(now()) @map("generated_at")

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  signatureRequest SignatureRequest @relation(fields: [tenantId, signatureRequestId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, signatureRequestId])
  @@map("signature_certificates")
}

// ---------------------------------------------------------------------------
// Table partitioning + archival (step 5.2, Phase 5). See
// docs/conventions/partitioning-archival.md for the full write-up — this
// section only covers the CONFIG/METADATA models; the actual
// `PARTITION BY RANGE` conversion of attendance_records/audit_log/
// platform_audit_log lives entirely in the `partition_high_growth_tables`
// hand-written SQL migration (Prisma has no partitioning DSL, same reason
// RLS is hand-written SQL — see docs/conventions/tenancy-rls.md), not here.
// ---------------------------------------------------------------------------

enum PartitionedTableName {
  ATTENDANCE_RECORDS
  AUDIT_LOG
  PLATFORM_AUDIT_LOG
}

// Platform-wide default partition/retention config, one row per managed
// table — NOT tenant-scoped, NOT subject to RLS, the SAME "platform
// catalog, no tenant_id to filter on" exemption `CountryPack` already
// establishes. Writable only through the owner `prisma` client via
// `@PlatformRoute()` (`PARTITIONING_MANAGE`), seeded with sane defaults by
// the migration that creates this table.
model PartitionedTableConfig {
  tableName PartitionedTableName @id @map("table_name")
  // How many months of hot partitions the scheduled partition-creation job
  // keeps created AHEAD of "now" — see PartitionMaintenanceService. Chosen
  // generously (default 3) so a slow/failed job run still leaves a comfortable
  // buffer before any write could ever hit a missing partition.
  lookaheadMonths Int @default(3) @map("lookahead_months")
  // A partition whose range END is older than (now - retentionMonths) is
  // eligible for archival (detach + export + drop) — see
  // PartitionArchivalService. This is the PLATFORM DEFAULT only.
  // `TenantRetentionOverride` below is a documented Phase 6.1 GDPR seam: a
  // partition holds many tenants' rows for the same date range, so a
  // tenant-specific override does not (yet) drive per-tenant purging within
  // a shared partition — see docs/conventions/partitioning-archival.md.
  retentionMonths Int     @default(24) @map("retention_months")
  archiveEnabled  Boolean @default(true) @map("archive_enabled")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("partitioned_table_configs")
}

// A tenant's own retention preference for one partitioned table — the
// documented Phase 6.1 GDPR/data-residency SEAM this step is asked to
// provide, not a fully realized per-tenant purge mechanism (see the honest
// scope note on `PartitionedTableConfig.retentionMonths` and
// docs/conventions/partitioning-archival.md). Ordinary tenant-scoped table,
// RLS applies exactly like every other tenant-owned table in this schema —
// written today only via `@PlatformRoute()` (`PARTITIONING_MANAGE`, on a
// tenant's behalf, the same "platform acts for a tenant" shape
// `TENANT_MIGRATION_MANAGE` already establishes), through the owner
// `prisma` client (a platform route opens no tenant transaction — see
// docs/conventions/tenant-resolution.md § Platform context) — RLS/grants
// are still declared here for the same defense-in-depth reason every
// tenant-scoped table in this schema gets them regardless of which caller
// exercises the write path today, and to leave the door open for a future
// tenant-portal self-service surface.
model TenantRetentionOverride {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  tableName       PartitionedTableName @map("table_name")
  retentionMonths Int                  @map("retention_months")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, tableName])
  @@index([tenantId])
  @@map("tenant_retention_overrides")
}

// One row per archived (detached + exported + dropped) partition — platform-
// wide infra metadata, NOT tenant-scoped (an archived partition's export
// holds every tenant's rows for that date range), the SAME "no RLS,
// cross-tenant infra" exemption `PlatformAuditLog` already establishes.
// `storageKey` + `checksumSha256` are the documented retrieval path: the
// gzip-compressed JSONL export lives in the SAME S3/MinIO bucket
// `StorageService` already manages, downloadable via
// `GET /platform/partitioning/archives/:id/download`
// (`PARTITIONING_READ`), with the checksum letting an operator verify a
// downloaded export's integrity independently of Postgres.
model ArchivedPartition {
  id             String               @id @default(uuid()) @db.Uuid
  tableName      PartitionedTableName @map("table_name")
  partitionName  String               @map("partition_name")
  rangeStart     DateTime             @map("range_start")
  rangeEnd       DateTime             @map("range_end")
  rowCount       Int                  @map("row_count")
  storageKey     String               @map("storage_key")
  checksumSha256 String               @map("checksum_sha256")
  archivedAt     DateTime             @default(now()) @map("archived_at")

  @@unique([tableName, partitionName])
  @@index([tableName, rangeStart])
  @@map("archived_partitions")
}

// ---------------------------------------------------------------------------
// Data privacy & residency (Phase 6.1) — see
// docs/conventions/privacy-residency.md. Builds directly on this schema's
// existing tenancy/RLS (isolation), audit_log (immutability — never
// row-deleted, only anonymized-within), and the 5.2 partitioning/archival
// seam (`TenantRetentionOverride` above stays scoped to the three
// PHYSICALLY partitioned tables; `TenantDataRetentionOverride` below is a
// parallel, LOGICAL-data-category seam — Employee/Candidate rows are never
// partitioned, so they need their own retention override table).
// ---------------------------------------------------------------------------

enum DataSubjectType {
  EMPLOYEE
  CANDIDATE
  USER
}

enum PrivacyRequestType {
  EXPORT
  ERASURE
}

enum PrivacyRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

// The closed set of data categories this module's erasure/retention policy
// matrix is authored against — see docs/conventions/privacy-residency.md for
// the full per-category erasure-policy table. A closed, code-level enum is
// correct here (unlike WorkflowInstance.entityType's free-form-string
// pattern): these categories are a fixed taxonomy this module's OWN engine
// branches on, not a tenant-extensible catalog.
enum DataCategory {
  EMPLOYEE_PROFILE
  EMPLOYEE_POST_EXIT
  CANDIDATE_RECORDS
  PAYROLL_TAX_RECORDS
  AUDIT_TRAIL
  DOCUMENTS
}

enum RetentionAction {
  HARD_DELETE
  ANONYMIZE
  RETAIN_LEGAL
}

// One data-subject request (export or erasure) — tenant-scoped, ordinary
// RLS. `subjectId` is a plain uuid with NO FK relation, deliberately — an
// ERASURE request's whole point is that the subject row itself may be
// scrubbed/gone by the time this row is read back, the same "id survives
// even if what it once pointed to changes shape" reasoning
// `AuditLog.entityId` already establishes for itself.
model DataSubjectRequest {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @map("tenant_id") @db.Uuid
  requestType PrivacyRequestType   @map("request_type")
  subjectType DataSubjectType      @map("subject_type")
  subjectId   String               @map("subject_id") @db.Uuid
  status      PrivacyRequestStatus @default(PENDING)
  reason      String?
  // Null when system-initiated (see `systemInitiated` below) or when a
  // platform admin acted on the tenant's behalf (`initiatedByPlatformAdminId`
  // below) — the same "nullable system/cross-boundary actor" convention
  // `AuditLog.actorUserId`/`ImportBatch.initiatedByPlatformAdminId` already
  // establish, deliberately with no FK relation object either (see those
  // models' own comments).
  requestedByUserId String? @map("requested_by_user_id") @db.Uuid
  // Step 6.1, the SAME "platform acts for a tenant" shape
  // `ImportBatch.initiatedByPlatformAdminId` already establishes — set when
  // the VENDOR CONSOLE creates this request on a tenant's behalf.
  initiatedByPlatformAdminId String?  @map("initiated_by_platform_admin_id") @db.Uuid
  // True when the SCHEDULED RETENTION ENFORCEMENT JOB created this row
  // (past-window auto-purge/anonymize) rather than a real person —
  // `requestedByUserId`/`initiatedByPlatformAdminId` are both null in that
  // case; this flag is what lets a caller tell "nobody asked, the policy
  // fired" apart from "a real actor's identity was simply not captured".
  systemInitiated Boolean @default(false) @map("system_initiated")
  // EXPORT only — where the completed export bundle (export.json + any
  // copied document bytes) lives in the SAME S3/MinIO bucket
  // `StorageService` already manages, at
  // `privacy-exports/<tenantId>/<requestId>/`.
  resultStorageKey String? @map("result_storage_key")
  // ERASURE only — per-`DataCategory` outcome (`HARD_DELETE`/`ANONYMIZE`/
  // `RETAIN_LEGAL`, plus a short human-readable note), the erasure policy
  // matrix's OWN record of exactly what it did for THIS subject, not just a
  // generic "done".
  erasureSummary Json?     @map("erasure_summary")
  failureReason  String?   @map("failure_reason")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  completedAt    DateTime? @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, subjectType, subjectId])
  @@map("data_subject_requests")
}

// One consent grant/revocation record — tenant-scoped, ordinary RLS.
// `purpose` is a free-form string (e.g. "BIOMETRIC_ATTENDANCE",
// "MARKETING_COMMS") deliberately, the SAME "no closed catalog for a
// tenant/country-varying concept" reasoning `CustomFieldDefinition.entityType`
// already establishes — which lawful-basis purposes a given tenant/country
// actually needs to track is not this codebase's call to fix in an enum.
model ConsentRecord {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  subjectType       DataSubjectType @map("subject_type")
  subjectId         String          @map("subject_id") @db.Uuid
  purpose           String
  granted           Boolean
  // Where the consent was captured (e.g. "ESS_PORTAL", "PAPER_FORM",
  // "DATA_MIGRATION_IMPORT") — a plain string, not a closed enum, for the
  // same reason `purpose` is.
  source            String
  recordedByUserId  String?   @map("recorded_by_user_id") @db.Uuid
  grantedAt         DateTime? @map("granted_at")
  revokedAt         DateTime? @map("revoked_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, subjectType, subjectId])
  @@map("consent_records")
}

// The Record of Processing Activities (ROPA) a GDPR-style regime expects a
// controller to maintain — ONE catalog row per `DataCategory`, platform-wide
// (no `tenantId`), the SAME "global reference data, no per-tenant column to
// filter on" exemption `CountryPack`/`PartitionedTableConfig` already
// establish. Authored by the VENDOR (platform), read live by every tenant
// (`hrm_app` gets SELECT only — see the enable-RLS migration) exactly the
// same "one shared catalog, read-only from the tenant side" shape
// `CountryPack` already establishes for itself.
model DataProcessingRegisterEntry {
  category            DataCategory      @id
  description         String
  purposeOfProcessing String            @map("purpose_of_processing")
  legalBasis          String            @map("legal_basis")
  dataSubjectTypes    DataSubjectType[] @map("data_subject_types")
  sourceModules       String[]          @map("source_modules")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@map("data_processing_register")
}

// The vendor's disclosure of its OWN sub-processors (object storage, email
// delivery, payment processing, error tracking, ...) — platform-wide, no
// `tenantId`, the SAME exemption/read posture as
// `DataProcessingRegisterEntry` immediately above.
model SubProcessorRecord {
  id                String         @id @default(uuid()) @db.Uuid
  name              String         @unique
  purpose           String
  dataCategories    DataCategory[] @map("data_categories")
  region            String
  contractReference String?        @map("contract_reference")
  addedAt           DateTime       @default(now()) @map("added_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@map("sub_processor_records")
}

// The PLATFORM DEFAULT retention/erasure-action per `DataCategory` — ONE
// row per category, platform-wide, the exact same shape
// `PartitionedTableConfig` already establishes for the three physically
// partitioned tables, extended here to logical data categories that are
// never partitioned at all (Employee, Candidate, ...). Writable only via
// `@PlatformRoute()` (`PRIVACY_MANAGE`), through the owner `prisma` client.
model DataRetentionPolicy {
  category        DataCategory    @id
  retentionMonths Int             @map("retention_months")
  action          RetentionAction
  legalBasisNote  String?         @map("legal_basis_note")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@map("data_retention_policies")
}

// A tenant's own retention preference for one `DataCategory` — the SAME
// "tenant override on top of a platform default" shape
// `TenantRetentionOverride` already establishes for partitioned tables, but
// UNLIKE that one, this override IS operationally applied (not merely
// informational) by `RetentionEnforcementService` — see
// docs/conventions/privacy-residency.md for why the two seams differ:
// `TenantRetentionOverride` can't be applied per-tenant because a single
// PARTITION physically holds every tenant's rows for that date range, but a
// `DataCategory` like `EMPLOYEE_POST_EXIT` is enforced with an ordinary
// `WHERE tenant_id = ?` row-level query — there is no shared-partition
// obstacle here.
model TenantDataRetentionOverride {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  category        DataCategory
  retentionMonths Int          @map("retention_months")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, category])
  @@index([tenantId])
  @@map("tenant_data_retention_overrides")
}
