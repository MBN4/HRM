# Primary connection used by `prisma migrate` and admin/bootstrap scripts
# (seeding). This role owns the schema and — in local dev — is a superuser,
# which means it ALWAYS bypasses Row-Level Security. Never point application
# request-time queries at this URL.
DATABASE_URL=postgresql://hrm:hrm_dev_password@localhost:5433/hrm_dev?schema=public

# Used by `prisma migrate dev` to create a disposable shadow database
# for detecting drift. Only needed for local migrations.
SHADOW_DATABASE_URL=postgresql://hrm:hrm_dev_password@localhost:5433/hrm_dev_shadow?schema=public

# Restricted, non-superuser role (created by the
# `enable_row_level_security` migration) used for ALL tenant-scoped runtime
# queries. Row-Level Security policies only apply to this role — see
# /CLAUDE.md § Conventions → Tenancy model for why DATABASE_URL must not be
# reused here.
APP_DATABASE_URL=postgresql://hrm_app:hrm_app_dev_password@localhost:5433/hrm_dev?schema=public

# Bounded connection-pool sizing (step 0.10, src/pool-config.ts) — see
# /CLAUDE.md § Conventions → Connection-pool protection. DB_POOL_SIZE bounds
# `appPrisma`; DB_ADMIN_POOL_SIZE bounds `prisma` (the owner role). Both
# share DB_POOL_TIMEOUT_SECONDS, how long a request queues for a free
# connection before Prisma throws P2024 rather than waiting indefinitely.
DB_POOL_SIZE=10
DB_ADMIN_POOL_SIZE=5
DB_POOL_TIMEOUT_SECONDS=5
