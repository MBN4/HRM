{
  "title": "HRM — API Overview",
  "uid": "hrm-api-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["hrm", "api"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate (req/s, by route)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(hrm_http_requests_total[5m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error rate (5xx / total, %)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "100 * sum(rate(hrm_http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(hrm_http_requests_total[5m]))",
          "legendFormat": "5xx %"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "p50 / p95 / p99 request latency (by route)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(hrm_http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p50 {{route}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(hrm_http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p95 {{route}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(hrm_http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p99 {{route}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 4,
      "title": "Rate-limit rejections (429/min, by source)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(rate(hrm_rate_limit_rejections_total[1m])) by (source) * 60", "legendFormat": "{{source}}" }
      ]
    },
    {
      "id": 5,
      "title": "Load-shed rejections (503/min, by priority)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "sum(rate(hrm_load_shed_rejections_total[1m])) by (priority) * 60", "legendFormat": "{{priority}}" }
      ]
    },
    {
      "id": 6,
      "title": "DB pool-exhaustion rejections (503/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "rate(hrm_db_pool_exhaustion_rejections_total[1m]) * 60", "legendFormat": "pool exhaustion" }]
    },
    {
      "id": 7,
      "title": "Circuit breaker state (0=CLOSED, 1=HALF_OPEN, 2=OPEN)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [{ "expr": "hrm_circuit_breaker_state", "legendFormat": "{{name}}" }]
    },
    {
      "id": 8,
      "title": "Process CPU / event-loop lag",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        { "expr": "rate(hrm_process_process_cpu_seconds_total[1m])", "legendFormat": "cpu {{service}}" },
        { "expr": "hrm_process_nodejs_eventloop_lag_seconds", "legendFormat": "event loop lag {{service}}" }
      ]
    }
  ]
}
