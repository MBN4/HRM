    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
