{
  "name": "@hrm/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "dev": "nest start --watch",
    "start:worker": "node dist/worker.js",
