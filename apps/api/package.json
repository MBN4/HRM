    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@node-rs/argon2": "^2.1.0",
    "bullmq": "^5.28.2",
    "class-transformer": "^0.5.1",
    "csv-parse": "^7.0.2",
