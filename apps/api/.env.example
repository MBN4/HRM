# --- App ---
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# --- Database (Postgres 16, via @hrm/db / Prisma) ---
# Owner/migration role — superuser locally, bypasses Row-Level Security.
# The running API must NOT use this for request-time queries; only
# migrations and admin/bootstrap tooling should. See /CLAUDE.md.
DATABASE_URL=postgresql://hrm:hrm_dev_password@localhost:5433/hrm_dev?schema=public

# Restricted, non-superuser role that Row-Level Security is enforced
# against. All tenant-scoped request-time queries (via @hrm/db's
# `withTenantContext`) go through this connection instead.
APP_DATABASE_URL=postgresql://hrm_app:hrm_app_dev_password@localhost:5433/hrm_dev?schema=public

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- Auth / JWT ---
JWT_SECRET=change_me_dev_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_dev_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# --- Object storage (MinIO locally, S3-compatible in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=hrm_minio
S3_SECRET_ACCESS_KEY=hrm_minio_password
S3_BUCKET=hrm-dev
S3_FORCE_PATH_STYLE=true

# --- Multi-tenancy: resolution (see /CLAUDE.md § Conventions → Tenant resolution) ---
# Comma-separated, tried in this order until one resolves. Supported:
# subdomain, custom_domain, header.
TENANT_RESOLUTION_STRATEGIES=subdomain,custom_domain,header
# Base domain for subdomain resolution (acme.<this> -> tenant slug "acme").
# Leave empty to disable the subdomain strategy entirely.
TENANT_BASE_DOMAIN=yourhrms.local
# Header carrying an explicit tenant id (UUID) or slug, for mobile/API
# clients that don't go through a per-tenant subdomain/domain.
TENANT_HEADER_NAME=x-tenant-id

# --- Platform (vendor super-admin, no-tenant) context — stub only ---
# Off by default. A route marked @PlatformRoute() is rejected unless this is
# also true — and even then, no tenant-scoped DB access is granted through
# it yet (real RBAC/audit-gated bypass lands in a later step).
PLATFORM_MODE_ENABLED=false

# --- Licensing (dual delivery: rented SaaS vs. lifetime on-prem) ---
LICENSE_MODE=saas
LICENSE_KEY=
