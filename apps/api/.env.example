# --- App ---
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# --- Database (Postgres 16, via @hrm/db / Prisma) ---
# Owner/migration role — superuser locally, bypasses Row-Level Security.
# The running API must NOT use this for request-time queries; only
# migrations and admin/bootstrap tooling should. See CLAUDE.md.
DATABASE_URL=postgresql://hrm:hrm_dev_password@localhost:5433/hrm_dev?schema=public

# Restricted, non-superuser role that Row-Level Security is enforced
# against. All tenant-scoped request-time queries (via @hrm/db's
# `withTenantContext`) go through this connection instead.
APP_DATABASE_URL=postgresql://hrm_app:hrm_app_dev_password@localhost:5433/hrm_dev?schema=public

# Bounded connection-pool sizing (step 0.10) — see
# docs/conventions/resilience.md → Connection-pool protection. DB_POOL_SIZE bounds `appPrisma`
# (every tenant-scoped request); DB_ADMIN_POOL_SIZE bounds `prisma` (the
# owner role — migrations/seeding/platform-admin/tests). Both share
# DB_POOL_TIMEOUT_SECONDS — how long a request queues for a free
# connection before Prisma throws P2024, which `DbPoolExhaustionFilter`
# turns into a clean 503 with Retry-After instead of a hang.
DB_POOL_SIZE=10
DB_ADMIN_POOL_SIZE=5
DB_POOL_TIMEOUT_SECONDS=5

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- Auth / JWT ---
JWT_SECRET=change_me_dev_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_dev_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# --- Object storage (MinIO locally, S3-compatible in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=hrm_minio
S3_SECRET_ACCESS_KEY=hrm_minio_password
S3_BUCKET=hrm-dev
S3_FORCE_PATH_STYLE=true

# --- Multi-tenancy: resolution (see docs/conventions/tenant-resolution.md) ---
# Comma-separated, tried in this order until one resolves. Supported:
# subdomain, custom_domain, header.
TENANT_RESOLUTION_STRATEGIES=subdomain,custom_domain,header
# Base domain for subdomain resolution (acme.<this> -> tenant slug "acme").
# Leave empty to disable the subdomain strategy entirely.
TENANT_BASE_DOMAIN=yourhrms.local
# Header carrying an explicit tenant id (UUID) or slug, for mobile/API
# clients that don't go through a per-tenant subdomain/domain.
TENANT_HEADER_NAME=x-tenant-id

# --- Platform (vendor super-admin, no-tenant) context ---
# Off by default. A route marked @PlatformRoute() is rejected unless this is
# also true. As of 0.6, the licensing admin endpoints
# (POST /platform/licensing/issue|revoke, PATCH /platform/licensing/flags/:id)
# are the first real cross-tenant access through this seam — see
# docs/conventions/tenant-resolution.md → Platform context and
# docs/conventions/licensing-feature-flags.md. Every other platform route
# still gets no tenant-scoped transaction.
PLATFORM_MODE_ENABLED=false

# --- Licensing (dual delivery: rented SaaS vs. lifetime on-prem) ---
# saas: entitlement derives from the tenant's Subscription row (edition +
#   status) — see docs/conventions/licensing-feature-flags.md.
# lifetime: entitlement derives from a verified, activated License file —
#   apply one via POST /licensing/activation/complete, not this env var.
LICENSE_MODE=saas
# Superseded by the DB-backed License + activation-endpoint flow (0.6) —
# kept only for backward-compatible documentation, not read by the app.
LICENSE_KEY=

# RS256 keypair for license file signing/verification (0.6). The PUBLIC key
# must be present in every deployment, SaaS or on-prem — it is all
# LicenseVerificationService needs. The PRIVATE key must be present ONLY on
# vendor-controlled issuing infrastructure and must NEVER ship in an
# on-prem build — see apps/api/keys/README.md. Dev keys are generated at
# apps/api/keys/ (the private one is gitignored).
LICENSE_PUBLIC_KEY_PATH=./keys/license-public-dev.pem
LICENSE_PRIVATE_KEY_PATH=./keys/license-private-dev.pem

# --- Resilience chassis (step 0.10) — see docs/conventions/resilience.md ---
# Hard ceiling on total request time (TenantScopeInterceptor), including
# tenant resolution, the per-tenant rate-limit check, and the held-open DB
# transaction — a slow handler gets a clean 408 instead of hanging forever.
REQUEST_TIMEOUT_MS=30000
# Load shedding (LoadSheddingService): in-flight-request-count thresholds
# above which a LOW/NORMAL priority request is shed (503) rather than
# processed. CRITICAL-priority routes (login, health, core reads) are
# NEVER shed, at any load.
LOAD_SHED_LOW_THRESHOLD=20
LOAD_SHED_NORMAL_THRESHOLD=100
# Graceful shutdown (main.ts): on SIGTERM/SIGINT, readiness (`GET
# /health/ready`) fails IMMEDIATELY (so a load balancer stops routing new
# traffic here) while the process keeps draining in-flight work for this
# many ms before actually closing.
SHUTDOWN_GRACE_PERIOD_MS=5000

# --- Employee module (step 1.1) — see docs/conventions/employee.md ---
# Base64-encoded 32-byte AES-256 key. EncryptionService uses this to encrypt
# bank details/salary at rest (AES-256-GCM) — a Postgres column-level guard
# independent of and in addition to the RBAC/field-level-permission checks
# around the same data. Generate a real value per environment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# and manage it as a secret outside source control in any non-local
# environment, same rule this repo already applies to JWT/DB secrets.
FIELD_ENCRYPTION_KEY=
