# --- App ---
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# --- Database (Postgres 16, via @hrm/db / Prisma) ---
# Owner/migration role — superuser locally, bypasses Row-Level Security.
# The running API must NOT use this for request-time queries; only
# migrations and admin/bootstrap tooling should. See CLAUDE.md.
DATABASE_URL=postgresql://hrm:hrm_dev_password@localhost:5433/hrm_dev?schema=public

# Restricted, non-superuser role that Row-Level Security is enforced
# against. All tenant-scoped request-time queries (via @hrm/db's
# `withTenantContext`) go through this connection instead.
APP_DATABASE_URL=postgresql://hrm_app:hrm_app_dev_password@localhost:5433/hrm_dev?schema=public

# Bounded connection-pool sizing (step 0.10) — see
# docs/conventions/resilience.md → Connection-pool protection. DB_POOL_SIZE bounds `appPrisma`
# (every tenant-scoped request); DB_ADMIN_POOL_SIZE bounds `prisma` (the
# owner role — migrations/seeding/platform-admin/tests). Both share
# DB_POOL_TIMEOUT_SECONDS — how long a request queues for a free
# connection before Prisma throws P2024, which `DbPoolExhaustionFilter`
# turns into a clean 503 with Retry-After instead of a hang.
DB_POOL_SIZE=10
DB_ADMIN_POOL_SIZE=5
DB_POOL_TIMEOUT_SECONDS=5

# --- Read replica (step 5.1) — see docs/conventions/scaling-data-layer.md.
# OPTIONAL and ADDITIVE: left unset here on purpose. When unset,
# `appReadReplicaPrisma` (packages/db) is simply aliased to `appPrisma`, so
# every replica-routed read (e.g. the analytics dashboard) transparently
# reads from the primary instead — zero behavior change. Point this at a
# real Postgres read replica (docker-compose's own `postgres-replica`
# service locally, on host port 5434) to actually route those reads there.
APP_REPLICA_DATABASE_URL=
DB_REPLICA_POOL_SIZE=10

# --- PgBouncer (step 5.1) — see docs/conventions/scaling-data-layer.md.
# NOT wired in as the default APP_DATABASE_URL here on purpose (see that
# doc's own write-up of why) — docker-compose's `pgbouncer` service (host
# port 6432, transaction pooling mode) is proven safe by two dedicated
# real-infra test files. To actually route production traffic through it,
# point APP_DATABASE_URL at it instead of Postgres directly, e.g.:
#   APP_DATABASE_URL=postgresql://hrm_app:<password>@<pgbouncer-host>:6432/<db>?schema=public&pgbouncer=true
# `?pgbouncer=true` is REQUIRED — it disables Prisma's own prepared-
# statement caching, which a transaction-mode pooler cannot support.

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- Auth / JWT ---
JWT_SECRET=change_me_dev_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_dev_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# --- Object storage (MinIO locally, S3-compatible in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=hrm_minio
S3_SECRET_ACCESS_KEY=hrm_minio_password
S3_BUCKET=hrm-dev
S3_FORCE_PATH_STYLE=true

# --- Multi-tenancy: resolution (see docs/conventions/tenant-resolution.md) ---
# Comma-separated, tried in this order until one resolves. Supported:
# subdomain, custom_domain, header.
TENANT_RESOLUTION_STRATEGIES=subdomain,custom_domain,header
# Base domain for subdomain resolution (acme.<this> -> tenant slug "acme").
# Leave empty to disable the subdomain strategy entirely.
TENANT_BASE_DOMAIN=yourhrms.local
# Header carrying an explicit tenant id (UUID) or slug, for mobile/API
# clients that don't go through a per-tenant subdomain/domain.
TENANT_HEADER_NAME=x-tenant-id

# --- Data residency enforcement (step 6.1, see
# docs/conventions/privacy-residency.md, building on the 5.3 regional
# deployment seam — docs/conventions/deployment-scaling.md § Regional
# deployment) ---
# Which region THIS running stack serves, e.g. "us-east-1"/"me-south-1"/
# "pk-south-1" — set once per regional deployment overlay
# (deploy/k8s/overlays/<region>/). Leave EMPTY for local/CI/single-region
# deployments (the default): TenantScopeInterceptor's residency check is a
# complete no-op when unset. When set, a request for a tenant whose own
# Tenant.hostingRegion doesn't match this value is rejected (403) before
# rate limiting or the DB transaction even opens.
DEPLOYMENT_REGION=

# --- E-signatures (see docs/conventions/e-signatures.md) ---
# Base URL of the tenant portal (apps/portal) — used ONLY to build the link
# an EXTERNAL signer (no account) is emailed, e.g.
# "<this>/esign/<token>?tenant=<slug>". Never used for anything
# authenticated; the token itself is the only thing that grants access.
PORTAL_BASE_URL=http://localhost:3000

# --- Platform (vendor super-admin, no-tenant) context ---
# Off by default. A route marked @PlatformRoute() is rejected unless this is
# also true. As of 0.6, the licensing admin endpoints
# (POST /platform/licensing/issue|revoke, PATCH /platform/licensing/flags/:id)
# are the first real cross-tenant access through this seam — see
# docs/conventions/tenant-resolution.md → Platform context and
# docs/conventions/licensing-feature-flags.md. Every other platform route
# still gets no tenant-scoped transaction.
PLATFORM_MODE_ENABLED=false

# --- Licensing (dual delivery: rented SaaS vs. lifetime on-prem) ---
# saas: entitlement derives from the tenant's Subscription row (edition +
#   status) — see docs/conventions/licensing-feature-flags.md.
# lifetime: entitlement derives from a verified, activated License file —
#   apply one via POST /licensing/activation/complete, not this env var.
LICENSE_MODE=saas
# Superseded by the DB-backed License + activation-endpoint flow (0.6) —
# kept only for backward-compatible documentation, not read by the app.
LICENSE_KEY=

# RS256 keypair for license file signing/verification (0.6). The PUBLIC key
# must be present in every deployment, SaaS or on-prem — it is all
# LicenseVerificationService needs. The PRIVATE key must be present ONLY on
# vendor-controlled issuing infrastructure and must NEVER ship in an
# on-prem build — see apps/api/keys/README.md. Dev keys are generated at
# apps/api/keys/ (the private one is gitignored).
LICENSE_PUBLIC_KEY_PATH=./keys/license-public-dev.pem
LICENSE_PRIVATE_KEY_PATH=./keys/license-private-dev.pem

# --- Resilience chassis (step 0.10) — see docs/conventions/resilience.md ---
# Hard ceiling on total request time (TenantScopeInterceptor), including
# tenant resolution, the per-tenant rate-limit check, and the held-open DB
# transaction — a slow handler gets a clean 408 instead of hanging forever.
REQUEST_TIMEOUT_MS=30000
# Load shedding (LoadSheddingService): in-flight-request-count thresholds
# above which a LOW/NORMAL priority request is shed (503) rather than
# processed. CRITICAL-priority routes (login, health, core reads) are
# NEVER shed, at any load.
LOAD_SHED_LOW_THRESHOLD=20
LOAD_SHED_NORMAL_THRESHOLD=100
# Graceful shutdown (main.ts): on SIGTERM/SIGINT, readiness (`GET
# /health/ready`) fails IMMEDIATELY (so a load balancer stops routing new
# traffic here) while the process keeps draining in-flight work for this
# many ms before actually closing.
SHUTDOWN_GRACE_PERIOD_MS=5000

# --- Employee module (step 1.1) — see docs/conventions/employee.md ---
# Base64-encoded 32-byte AES-256 key. EncryptionService uses this to encrypt
# bank details/salary at rest (AES-256-GCM) — a Postgres column-level guard
# independent of and in addition to the RBAC/field-level-permission checks
# around the same data. Generate a real value per environment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# and manage it as a secret outside source control in any non-local
# environment, same rule this repo already applies to JWT/DB secrets.
FIELD_ENCRYPTION_KEY=

# --- Vendor super-admin console / platform auth (step 4.1) — see
# docs/conventions/vendor-console.md ---
# Enables the @PlatformRoute() seam (0.3) — off by default. Turn this on
# for any deployment that runs the vendor console (apps/admin).
PLATFORM_MODE_ENABLED=false
# A SEPARATE secret from JWT_SECRET, by design — a tenant user's access
# token must never be structurally able to verify as a platform token (or
# vice versa), even if crafted, because the two token families don't share
# a signing key. MANDATORY: PlatformTokenService throws at startup if unset.
PLATFORM_JWT_SECRET=change_me_dev_platform_secret
PLATFORM_JWT_EXPIRES_IN=30m
PLATFORM_JWT_REFRESH_EXPIRES_IN=12h

# --- Billing (step 4.2) — SaaS-mode ONLY, see docs/conventions/billing.md.
# Lifetime/on-prem tenants pay via the signed License-file path above
# (0.6) and are completely unaffected by anything in this section, except
# the platform's own optional AMC (annual maintenance) one-off invoicing,
# which reuses the same Stripe customer/invoice primitives. ---
# Server-side ONLY — never sent to any client, never logged (redacted by
# @hrm/shared's redactSensitiveFields via its generic "secret" match).
# LEFT EMPTY for local dev on purpose: StripeModule binds MockStripeClient
# (an in-memory fake covering customers/subscriptions/invoices/payment
# methods/webhook-signature verification) whenever this is unset, which is
# what lets the full test suite run with no live Stripe account. Set a
# real key (sk_test_... for Stripe TEST mode, sk_live_... for production —
# same SDK, same code, just a different key) to switch to RealStripeClient.
STRIPE_SECRET_KEY=
# The signing secret Stripe gives you when you register this deployment's
# webhook endpoint (Stripe Dashboard -> Developers -> Webhooks, or `stripe
# listen` for local testing with the Stripe CLI against a REAL account).
# StripeWebhookController verifies EVERY inbound delivery against this
# before touching the database — see StripeWebhookService. Required even
# under MockStripeClient: its own constructEvent verifies against this
# same secret with the identical `t=<ts>,v1=<hmac>` HMAC scheme real
# Stripe webhooks use, so the mock path is a genuine signature-verification
# test, not a bypass.
STRIPE_WEBHOOK_SECRET=
# One real Stripe Price id per edition (Stripe Dashboard -> Product
# catalog — a recurring monthly per-seat price). Leave any/all unset to
# fall back to MockStripeClient's own deterministic `price_mock_<edition>`
# ids, priced from @hrm/shared's BILLING_PLANS reference table — see
# billing-pricing.util.ts.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=

# --- White-label / branding (step 4.3) — see docs/conventions/white-label.md.
# TLS provisioning for a tenant's branded custom domain. LEFT UNSET (false)
# for local dev/CI on purpose: BrandingModule binds MockCertProvider (which
# "issues" a certificate immediately, no network call) whenever this isn't
# exactly "true" — no real ACME account or reachable domain exists in this
# environment, the same reason billing's STRIPE_SECRET_KEY is left empty
# here. Setting ACME_ENABLED=true switches the CERT_PROVIDER binding to
# AcmeCertProvider, which is a documented SEAM ONLY (throws — see that
# file's own doc comment) until a real ACME client integration lands. ---
ACME_ENABLED=false
ACME_DIRECTORY_URL=
ACME_ACCOUNT_EMAIL=

# --- Security hardening (step 6.2) — see docs/conventions/security-hardening.md ---
# Extra ORIGINS (full scheme+host[:port], comma-separated) the CORS
# allow-list should accept beyond TENANT_BASE_DOMAIN's own subdomains and
# tenants' VERIFIED custom domains (see CorsOriginService) — e.g. local dev
# ports for apps/portal|admin|mobile, or a deployment's own first-party web
# origins that don't live under TENANT_BASE_DOMAIN.
CORS_ADDITIONAL_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003

# Secrets provider seam (EncryptionKeyProvider) — "env" (default) reads the
# FIELD_ENCRYPTION_KEY* vars below directly; "aws-secrets-manager"/"vault"
# switch EncryptionModule's ENCRYPTION_KEY_PROVIDER binding to
# CloudSecretsProvider, a documented NotImplementedException seam (same
# shape as branding's ACME_ENABLED/AcmeCertProvider) — no real cloud
# secrets manager is actually integrated in this environment.
SECRETS_PROVIDER=env

# Field-encryption KEY ROTATION (see EncryptionService's own doc comment).
# FIELD_ENCRYPTION_KEY_VERSION labels the key ABOVE (FIELD_ENCRYPTION_KEY,
# defined in the Employee module section below) — new ciphertext is always
# written under this version. FIELD_ENCRYPTION_PREVIOUS_KEYS keeps old
# key(s) available for DECRYPTING data written before a rotation, as
# `version:base64key` pairs separated by commas (e.g. rotating away from
# version "1" means moving its key here as `1:<old-base64-key>` and bumping
# FIELD_ENCRYPTION_KEY_VERSION to "2" with a freshly generated
# FIELD_ENCRYPTION_KEY). Leave both unset for a single, never-rotated key —
# the default, fully backward-compatible with every pre-6.2 encrypted value.
FIELD_ENCRYPTION_KEY_VERSION=1
FIELD_ENCRYPTION_PREVIOUS_KEYS=

# Optional TOTP issuer label shown in an authenticator app for TENANT users
# enrolling optional MFA (see TenantMfaService) — distinct from platform
# admins' fixed "HRM Platform" issuer (mandatory MFA, step 4.1) so a user
# holding both a tenant and a platform account can tell the two apart in
# their authenticator. Defaults to "HRM" when unset.
TENANT_MFA_ISSUER=HRM

# --- Data migration & onboarding toolkit (step 3.5.1) — see
# docs/conventions/data-migration.md. How long a COMMITTED/
# COMMITTED_WITH_ERRORS/FAILED import batch's uploaded source file (CSV/
# XLSX, may contain PII) stays in object storage before
# MigrationPurgeService deletes it. Not wired to a real scheduler yet —
# POST /migration/purge/run is a manual trigger, safe to call repeatedly.
IMPORT_FILE_RETENTION_HOURS=72

# --- Backups & disaster recovery (step 6.2) — see ops/backup/DR-RUNBOOK.md.
# Passphrase ops/backup/backup-postgres.sh and ops/backup/backup-minio.sh
# use to GPG-symmetric-encrypt (AES-256) every backup artifact at rest,
# same "env var, documented, never hardcoded, rotate outside source
# control in any non-local environment" posture as FIELD_ENCRYPTION_KEY/
# JWT_SECRET above. Generate a real value per environment the same way,
# e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Restoring an existing backup requires the SAME key it was created with —
# losing this key makes every prior backup encrypted under it unrecoverable,
# so a real deployment must manage it in a durable secret store (a cloud
# KMS/secrets manager — see DR-RUNBOOK.md's verified-at-deploy list), never
# only on the machine that ran the backup.
BACKUP_ENCRYPTION_KEY=
