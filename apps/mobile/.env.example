# Base URL of the NestJS API. Expo inlines any EXPO_PUBLIC_* env var into
# the JS bundle at build time (see https://docs.expo.dev/guides/environment-variables/)
# — there is no server-side rendering step here to keep a secret out of,
# unlike apps/portal's NEXT_PUBLIC_* equivalents.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Mobile has no per-tenant hostname concept at all (see
# docs/conventions/tenant-resolution.md, strategy #3 "header") — there is
# deliberately no EXPO_PUBLIC_TENANT_BASE_DOMAIN/subdomain equivalent here.
# The tenant is always resolved via the `x-tenant-id` header, using the
# workspace slug entered on the Login screen and persisted afterward (see
# src/lib/tenant.ts).
