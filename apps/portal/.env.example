# Base URL of the NestJS API
NEXT_PUBLIC_API_URL=http://localhost:3001

NEXT_PUBLIC_APP_ENV=development

# How the portal resolves the active tenant from the incoming request
# (subdomain vs. path-based) — finalized in step 0.3, see /CLAUDE.md.
NEXT_PUBLIC_TENANT_HOST_MODE=subdomain

# Session secret for tenant end-user auth
NEXTAUTH_SECRET=change_me_dev_secret
NEXTAUTH_URL=http://localhost:3003
