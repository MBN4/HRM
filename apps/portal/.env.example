# Base URL of the NestJS API
NEXT_PUBLIC_API_URL=http://localhost:3001

NEXT_PUBLIC_APP_ENV=development

# How the portal resolves the active tenant from the incoming request
# (subdomain vs. path-based) — finalized in step 0.3, see /CLAUDE.md.
NEXT_PUBLIC_TENANT_HOST_MODE=subdomain

# --- Tenant resolution for API calls made FROM THE BROWSER (step 1.4) ---
# Must match the API's own TENANT_BASE_DOMAIN (apps/api/.env.example) —
# when the portal is served from "<slug>.<this>", the API client mirrors
# that same subdomain onto its own request host so the API's subdomain
# strategy (docs/conventions/tenant-resolution.md) resolves the identical
# tenant. Leave unset for plain "localhost" dev — the client then falls
# back to the header strategy (x-tenant-id) using a slug captured at login,
# the same strategy 0.3 documents for clients with no per-tenant hostname.
NEXT_PUBLIC_TENANT_BASE_DOMAIN=yourhrms.local
# Port the API listens on when reached via the mirrored subdomain above.
NEXT_PUBLIC_API_PORT=3001

# Session secret for tenant end-user auth
NEXTAUTH_SECRET=change_me_dev_secret
NEXTAUTH_URL=http://localhost:3003
